{
  "name": "kettlebird-website",
  "version": "0.1.0",
  "description": "Kettlebird Creations portfolio built with Astro and React islands.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:studio": "npm ci --prefix sanity-studio --no-audit --no-fund && npm run build --prefix sanity-studio -- ../dist/studio --yes && node scripts/studio-page.mjs dist/studio/index.html",
    "build:site": "npm run build && npm run build:studio",
    "preview": "astro preview",
    "check": "astro check",
    "test": "playwright test && vitest run",
    "build:fixtures": "KETTLEBIRD_FIXTURES=1 astro build",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "astro",
    "react",
    "portfolio",
    "sanity",
    "kettlebird"
  ],
  "author": "Star Goldberg",
  "license": "MIT",
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@sanity/client": "^7.16.0",
    "@sanity/image-url": "^2.0.3",
    "astro": "^5.16.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.0",
    "jsdom": "26.1.0",
    "typescript": "^5.7.0",
    "vitest": "3.2.7"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.63.0"
    }
  }
}
