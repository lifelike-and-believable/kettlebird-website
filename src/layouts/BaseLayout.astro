---
import '../styles/global.css';

const {
  title = 'Kettlebird Creations',
  description = 'Writer & Illustrator • Star Goldberg'
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Nunito:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="page">
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="site-title-link" aria-label="Kettlebird Creations — Home">
          <span class="site-title">Kettlebird</span>
        </a>
        <div class="subtitle-nav-row">
          <p class="site-subtitle">Comics + Illustration</p>
          <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle menu">
            <span class="menu-toggle-icon"></span>
          </button>
          <nav id="main-nav" class="main-nav">
            <ul class="nav-list">
              <li><a href="/portfolio" class="nav-btn">PORTFOLIO</a></li>
              <li><a href="/comics" class="nav-btn">COMICS</a></li>
              <li><a href="/writing" class="nav-btn">WRITING</a></li>
              <li><a href="/shop" class="nav-btn">SHOP</a></li>
              <li><a href="/commissions" class="nav-btn">COMMISSIONS</a></li>
              <li><a href="/about" class="nav-btn">ABOUT</a></li>
              <li><a href="/news" class="nav-btn">NEWS</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <main id="main" class="page__content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-section">
          <h3 class="footer-heading">Connect</h3>
          <div class="footer-social">
            <a href="https://bsky.app/profile/kettlebird.bsky.social" target="_blank" rel="noopener noreferrer" class="highlighter-btn highlighter-btn--green">Bluesky</a>
            <a href="https://kettle-bird.tumblr.com" target="_blank" rel="noopener noreferrer" class="highlighter-btn">Tumblr</a>
            <a href="https://www.instagram.com/kettlebirdart" target="_blank" rel="noopener noreferrer" class="highlighter-btn highlighter-btn--orange">Instagram</a>
            <a href="https://ko-fi.com/kettlebirdart" target="_blank" rel="noopener noreferrer" class="highlighter-btn highlighter-btn--pink">Ko-fi ☕</a>
          </div>
        </div>
        <div class="footer-section">
          <h3 class="footer-heading">Contact</h3>
          <p class="footer-contact">
            <a href="mailto:kettlebirdillustration@gmail.com">kettlebirdillustration@gmail.com</a>
          </p>
        </div>
        <div class="footer-section footer-copyright">
          <p>&copy; {currentYear} Kettlebird Creations • Star Goldberg</p>
          <p class="footer-meta">All artwork and writing are the property of the artist.</p>
        </div>
      </div>
    </footer>

    <script>
      const menuToggle = document.querySelector('.menu-toggle');
      const mainNav = document.querySelector('.main-nav');

      if (menuToggle && mainNav) {
        menuToggle.addEventListener('click', () => {
          const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
          menuToggle.setAttribute('aria-expanded', String(!isExpanded));
          mainNav.classList.toggle('is-open');
        });
      }
    </script>
  </body>
</html>

<style>
  /* ── Torn-paper header — matches homepage ── */
  .site-header {
    background-color: transparent;
    background-image: url('/assets/images/Paper_1_Torn.png');
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: cover;
    min-height: 300px;
    position: relative;
    z-index: 100;
    overflow: visible;
    /* Suppress the border + shadow that global.css adds to .site-header */
    border-bottom: none;
    box-shadow: none;
  }

  .header-inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 2rem 1rem 0.25rem;
  }

  .site-title-link {
    text-decoration: none;
    color: var(--color-ink);
    display: block;
  }

  .site-title {
    font-family: 'Nunito', sans-serif;
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.1;
    margin: 0 0 0.25rem;
    display: block;
  }

  .subtitle-nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-subtitle {
    font-family: 'Nunito', sans-serif;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 600;
    margin: 0;
    color: var(--color-ink);
  }

  /* ── Nav buttons ── */
  .main-nav {
    display: block;
  }

  .nav-list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .nav-btn {
    font-family: 'Nunito', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.5rem 1.25rem;
    border: none;
    background-image: url('/assets/images/Highlighter_Y.png');
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position: center;
    color: var(--color-ink);
    text-decoration: none;
    display: inline-block;
    transition: transform 0.2s ease-out, filter 0.2s ease-out;
  }

  .nav-btn:hover,
  .nav-btn:focus {
    transform: scale(1.05);
    filter: brightness(1.1);
    color: var(--color-ink);
  }

  /* ── Mobile menu toggle ── */
  .menu-toggle {
    display: none;
    background: none;
    border: 2px solid var(--color-ink);
    padding: 0.5rem;
    cursor: pointer;
    width: 44px;
    height: 44px;
    position: relative;
    flex-shrink: 0;
  }

  .menu-toggle:focus {
    outline: 2px solid var(--color-dark-purple);
    outline-offset: 2px;
  }

  .menu-toggle-icon {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-ink);
    position: relative;
  }

  .menu-toggle-icon::before,
  .menu-toggle-icon::after {
    content: '';
    position: absolute;
    width: 24px;
    height: 2px;
    background: var(--color-ink);
    left: 0;
    transition: transform 0.2s ease-out;
  }

  .menu-toggle-icon::before { top: -8px; }
  .menu-toggle-icon::after  { bottom: -8px; }

  .menu-toggle[aria-expanded="true"] .menu-toggle-icon { background: transparent; }
  .menu-toggle[aria-expanded="true"] .menu-toggle-icon::before { transform: translateY(8px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] .menu-toggle-icon::after  { transform: translateY(-8px) rotate(-45deg); }

  @media (max-width: 768px) {
    .menu-toggle {
      display: block;
    }

    .subtitle-nav-row {
      flex-wrap: nowrap;
      align-items: center;
    }

    .main-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-beige);
      border-top: 2px solid var(--color-ink);
      border-bottom: 2px solid var(--color-ink);
      padding: 0.75rem 1rem;
      z-index: 200;
    }

    .main-nav.is-open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      gap: 0.4rem;
    }

    .nav-btn {
      display: block;
      text-align: center;
    }
  }

  /* ── Footer ── */
  .site-footer {
    background: var(--color-paper-dark);
    border-top: 2px solid var(--color-ink);
    margin-top: 4rem;
    padding: 2rem var(--gutter-mobile) 1.5rem;
    position: relative;
  }

  /* Deckled edge */
  .site-footer::before {
    content: '';
    position: absolute;
    top: -10px;
    left: 0;
    right: 0;
    height: 10px;
    background:
      linear-gradient(135deg, transparent 33.33%, var(--color-paper-dark) 33.33%, var(--color-paper-dark) 66.66%, transparent 66.66%),
      linear-gradient(45deg, transparent 33.33%, var(--color-beige) 33.33%, var(--color-beige) 66.66%, transparent 66.66%);
    background-size: 8px 20px;
    background-position: 0 0, 4px 0;
  }

  .footer-container {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }

  .footer-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-social {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-social .highlighter-btn {
    font-size: 0.95rem;
    padding: 0.4rem 1rem;
    text-align: center;
  }

  .footer-contact {
    margin: 0;
  }

  .footer-contact a {
    color: var(--color-ink);
    overflow-wrap: break-word;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
  }

  .footer-copyright {
    grid-column: 1 / -1;
    text-align: center;
    padding-top: 1rem;
    border-top: 1px solid var(--color-ink-light);
    margin-top: 1rem;
  }

  .footer-copyright p {
    margin: 0.25rem 0;
    font-size: 0.9rem;
    font-family: 'DM Sans', sans-serif;
  }

  .footer-meta {
    color: var(--color-ink-light);
    font-size: 0.85rem !important;
  }

  @media (min-width: 768px) {
    .site-footer {
      padding: 3rem var(--gutter-tablet) 2rem;
    }

    .footer-social {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 1024px) {
    .site-footer {
      padding: 3rem var(--gutter-desktop) 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-btn:hover,
    .nav-btn:focus,
    .site-logo:hover .logo-text,
    .site-logo:focus .logo-text {
      transform: none;
    }
  }
</style>
