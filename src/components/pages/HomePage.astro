---
// The home page: the grid, the social links and the artist text from Site settings. Rendered by
// src/pages/index.astro and by the preview route (docs/specs/content-editing-preview.md).
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { PreviewInfo } from '../../lib/preview/load';
import HomeArtist from '../settings/HomeArtist.astro';
import SocialLinks from '../settings/SocialLinks.astro';
import type { Settings } from '../../lib/site-settings';
import { canonicalUrl, homeData, siteHref } from '../../lib/seo';

const { settings } = Astro.props as { settings: Settings };
/** In the preview route: what the preview shows and outlines (docs/specs/content-editing-preview.md). */
const previewInfo = (Astro.props as { previewInfo?: PreviewInfo }).previewInfo;
const structuredData = homeData(siteHref(Astro.site), settings.contact.links);
// site-search AC-4 to AC-8: the canonical address and link preview.
const pageTitle = 'Kettlebird Creations • Writer & Illustrator';
const pageDescription = 'Portfolio of Star Goldberg (they/them) - UPA-inspired illustrations, comics, and written works featuring fantasy characters and fanart.';
const canonical = canonicalUrl(siteHref(Astro.site), '/');
---


<BaseLayout
  previewInfo={previewInfo}
  settings={settings}
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  preview={{ title: pageTitle, description: pageDescription, url: canonical }}
  structuredData={structuredData}
>
  <div class="homepage">
    <!-- Main Grid -->
    <div class="grid-container">
      <a href="/portfolio" class="grid-tile grid-tile-portfolio">
        <div class="tile-content"><span class="tile-title">PORTFOLIO</span></div>
      </a>
      <div class="grid-tile grid-tile-logo">
        <img src="/assets/images/kettlebird-mark.png" alt="Kettlebird Logo" class="tile-image" width="1182" height="1182" />
      </div>
      <a href="/shop" class="grid-tile grid-tile-merch">
        <div class="tile-content"><span class="tile-title">SHOP</span></div>
      </a>
      <a href="/comics" class="grid-tile grid-tile-comics">
        <div class="tile-content"><span class="tile-title">COMICS</span></div>
      </a>
      <a href="/commissions" class="grid-tile grid-tile-commissions">
        <div class="tile-content"><span class="tile-title">COMMISSIONS</span></div>
      </a>
      <a href="/writing" class="grid-tile grid-tile-writing">
        <div class="tile-content"><span class="tile-title">WRITING</span></div>
      </a>
      <a href="/about#contact" class="grid-tile grid-tile-contact">
        <div class="tile-content"><span class="tile-title">CONTACT ME!</span></div>
      </a>
      <a href="/about" class="grid-tile grid-tile-about">
        <div class="tile-content"><span class="tile-title">ABOUT</span></div>
      </a>
      <a href="/news" class="grid-tile grid-tile-news">
        <div class="tile-content"><span class="tile-title">NEWS</span></div>
      </a>
    </div>

    <!-- Social links and the artist text, from Site settings (content-editing-site-settings AC-9, AC-10) -->
    <div id="social-links" data-part="social-links"><SocialLinks links={settings.contact.links} variant="home" /></div>
    <div id="artist-text" data-part="artist-text"><HomeArtist settings={settings} /></div>
  </div>
</BaseLayout>

<style>
  .homepage {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 1rem 2rem;
  }

  /* ── Grid ── */
  .grid-container {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(7, minmax(75px, auto));
    gap: 1rem;
    margin-top: -24px; /* overlap torn paper edge */
    margin-bottom: 2rem;
  }

  .grid-tile {
    border: 3px solid var(--color-ink);
    overflow: hidden;
    position: relative;
    min-height: 75px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.2s;
  }

  .grid-tile:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.15);
  }

  @media (prefers-reduced-motion: reduce) {
    .grid-tile:hover { transform: none; }
  }

  .grid-tile-portfolio {
    grid-column: span 2;
    grid-row: span 2;
    background: #8b7355 url('/assets/images/bkgd-artwork.jpg') center / cover;
  }

  /* The logo's own orange, the mark inside the border, square as the old picture made it, so the grid's rows
     keep their heights (design-home-tiles-and-icon). */
  .grid-tile-logo {
    grid-column: span 2;
    grid-row: span 4;
    background: #ffbb58;
    aspect-ratio: 1;
  }

  .grid-tile-merch {
    grid-column: span 2;
    grid-row: span 2;
    background: var(--color-orange);
  }

  .grid-tile-comics {
    grid-column: span 2;
    grid-row: span 3;
    background: #c8c8c8 url('/assets/images/bkgd-Comics.jpg') center / cover;
  }

  .grid-tile-commissions {
    grid-column: span 2;
    grid-row: span 2;
    background: #a8a8a8 url('/assets/images/bkgd-commissions.jpeg') center / cover;
  }

  .grid-tile-writing {
    grid-column: 1 / span 2;
    grid-row: 6 / span 2;
    background: #d94f3d url('/assets/images/bkgd-writing.jpg') center / cover;
  }

  .grid-tile-contact {
    grid-column: 3 / span 2;
    grid-row: 5 / span 3;
    background: linear-gradient(135deg, #cc5544 0%, #d94f3d 100%);
  }

  .grid-tile-about {
    grid-column: 5 / span 1;
    grid-row: 5 / span 3;
    background: var(--color-green);
  }

  .grid-tile-about .tile-content { justify-content: flex-start; }

  .grid-tile-news {
    grid-column: 6 / span 1;
    grid-row: 5 / span 3;
    background: var(--color-yellow);
  }

  .grid-tile-news .tile-content { justify-content: flex-end; }

  .tile-content {
    text-align: center;
    padding: 1rem;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .tile-title {
    font-family: 'Nunito', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    color: white;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  }

  .tile-image {
    position: absolute;
    inset: 12%;
    width: 76%;
    height: 76%;
    object-fit: contain;
  }

  /* ── About section ── */
  .about-section {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    margin-bottom: 2rem;
    align-items: start;
  }




  /* ── Responsive ── */
  @media (max-width: 768px) {
    .grid-container {
      grid-template-columns: repeat(2, 1fr);
    }

    .grid-tile-portfolio,
    .grid-tile-logo,
    .grid-tile-merch,
    .grid-tile-comics,
    .grid-tile-commissions,
    .grid-tile-writing,
    .grid-tile-contact {
      grid-column: span 2;
      grid-row: auto;
    }

    .grid-tile-about,
    .grid-tile-news {
      grid-column: span 1;
      grid-row: auto;
    }

    .grid-tile-logo       { order: -1; }
    .grid-tile-portfolio  { order: 0; }
    .grid-tile-comics     { order: 1; }
    .grid-tile-writing    { order: 2; }
    .grid-tile-commissions{ order: 3; }
    .grid-tile-merch      { order: 4; }
    .grid-tile-about      { order: 5; }
    .grid-tile-news       { order: 6; }
    .grid-tile-contact    { order: 7; }


  }
</style>
