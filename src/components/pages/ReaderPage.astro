  @media (prefers-reduced-motion: reduce) {
    .reader__edge { transition: none; }
  }

  /* How pages fit on a computer (docs/design/comic-page-width.md; comic-reader-page-size AC-8 to AC-21). The head
     script marks the page kb-fit-width or kb-fit-height (Fit the screen is the reader above, unmarked). Each page
     carries its largest width (--kb-cap); the reader, its chapter's column (--kb-col) and the widest page's shape
     (--kb-ratio), so the bar and buttons keep one width through a chapter, never under 600 px. A computer has a
     mouse or trackpad, at any window width; phones and tablets fit the screen. */
  @media (hover: hover) and (pointer: fine) {
    :global(html.kb-fit-width) .reader:not(.is-panels) { max-width: min(max(calc(var(--kb-col) + 1rem), calc(600px + 1rem)), 100%); }
    :global(html.kb-fit-height) .reader:not(.is-panels) {
      max-width: min(max(calc(min(var(--kb-col), calc(100vh * var(--kb-ratio))) + 1rem), calc(600px + 1rem)), 100%);
    }
    :global(html.kb-fit-width) .reader:not(.is-panels) .reader__page:not(.is-spread) {
      max-height: none;
      max-width: 100%;
      width: min(var(--kb-cap), 100%);
    }
    :global(html.kb-fit-height) .reader:not(.is-panels) .reader__page:not(.is-spread) {
      max-height: none;
      max-width: 100%;
      width: min(var(--kb-cap), 100%, calc(100vh * var(--page-ratio)));
    }
    /* A spread alone breaks out of the column, centred, within the window. */
    :global(html.kb-fit-width) .reader:not(.is-panels) .reader__page.is-spread { --kb-w: min(var(--kb-cap), calc(100vw - 2rem)); }
    :global(html.kb-fit-height) .reader:not(.is-panels) .reader__page.is-spread {
      --kb-w: min(var(--kb-cap), calc(100vw - 2rem), calc(100vh * var(--page-ratio)));
    }
    :global(html:is(.kb-fit-width, .kb-fit-height)) .reader:not(.is-panels) .reader__page.is-spread {
      max-height: none;
      max-width: none;
      width: var(--kb-w);
      margin-inline: calc((100% - var(--kb-w)) / 2);
    }
    /* The edge arrows run the page's height; their arrow stays in the window's middle. */
    :global(html:is(.kb-fit-width, .kb-fit-height)) .reader:not(.is-panels) .reader__edge { align-items: flex-start; }
    :global(html:is(.kb-fit-width, .kb-fit-height)) .reader:not(.is-panels) .reader__edge :global(.arrow-btn) {
      position: sticky;
      top: calc(50vh - 22px);
      margin-top: calc(50vh - 22px);
    }
    /* "Loading page…" at the top of the page, where it's seen. */
    :global(html:is(.kb-fit-width, .kb-fit-height)) .reader:not(.is-panels) .reader__loading { align-items: flex-start; padding-top: 3rem; }
    /* "Turn your phone sideways" is for phones. */
    :global(html:is(.kb-fit-width, .kb-fit-height)) .reader__turn-hint { display: none; }    /* The bar's buttons together at its right, so they stay put when the page number's line changes length. */
    :global(html:is(.kb-fit-width, .kb-fit-height)) .reader .reader__location { margin-right: auto; }
  }
  /* Two pages side by side take the size too, where pairs show: the column twice the widest page. */
  @media (hover: hover) and (pointer: fine) and (min-width: 62.5em) and (orientation: landscape) {
    :global(html.kb-fit-width:not(.kb-one-page)) .reader--pairs { max-width: min(calc(var(--kb-col) * 2 + 1rem), 100%); }
    :global(html.kb-fit-height:not(.kb-one-page)) .reader--pairs {
      max-width: min(calc(min(var(--kb-col), calc(100vh * var(--kb-ratio))) * 2 + 1rem), 100%);
    }
    :global(html:is(.kb-fit-width, .kb-fit-height):not(.kb-one-page)) .reader--pairs .reader__book { height: auto; }
    :global(html:is(.kb-fit-width, .kb-fit-height):not(.kb-one-page)) .reader--pairs .reader__book .reader__page { height: auto; }
    :global(html:is(.kb-fit-width, .kb-fit-height):not(.kb-one-page)) .reader--pairs .reader__page.is-spread { margin-inline: auto; }
    :global(html.kb-fit-width:not(.kb-one-page)) .reader--pairs .reader__page.is-spread { width: min(var(--kb-cap), 100%); }
  }

  /* A fan's Page size (comic-reader-page-size AC-15 to AC-20): a picture button, its name under it on hover and
     keyboard focus, and its menu; on computers only. A dot marks the fan's own choice. */
  .reader__size { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .reader__size:not([hidden]) { display: inline-flex; position: relative; }
  }
  @media (min-width: 700px) {
    .reader__size { order: 2; }
  }
  .reader__size-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 2px solid var(--color-ink);
    background: var(--color-beige);
    color: var(--color-ink);
    cursor: pointer;
  }
  .reader__size-button[data-own]::after {
    content: '';
    position: absolute;
    top: 3px;
    right: 3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-ink);
    box-shadow: 0 0 0 2px var(--color-yellow);
  }
  .reader__size-tip {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: -2px;
    z-index: 3;
    padding: 0.25rem 0.5rem;
    background: var(--color-ink);
    color: var(--color-beige);
    font: 600 0.8rem 'Nunito', sans-serif;
    white-space: nowrap;
    pointer-events: none;
  }
  .reader__size-button:hover .reader__size-tip,
  .reader__size-button:focus-visible .reader__size-tip { display: block; }
  .reader__size-button[aria-expanded='true'] .reader__size-tip { display: none; }
  .reader__size-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 5;
    width: 22rem;
    max-width: calc(100vw - 2rem);
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    padding: 0.5rem 0;
    border: 2px solid var(--color-ink);
    background: var(--color-beige);
    box-shadow: 0 6px 18px rgba(43, 43, 43, 0.25);
    font: 600 1rem 'Nunito', sans-serif;
    color: var(--color-ink);
  }
  .reader__size-menu[hidden] { display: none; }
  .reader__size-menu [role='menuitemradio'] {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.45rem 0.9rem;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .reader__size-menu [role='menuitemradio']:hover { background: rgba(43, 43, 43, 0.06); }
  .reader__size-menu [role='menuitemradio']:focus-visible { outline: 2px solid var(--color-ink); outline-offset: -4px; }
  .reader__size-tick { width: 18px; flex: none; text-align: center; font-weight: 800; }
  .reader__size-menu svg { flex: none; }
  .reader__size-words small { display: block; font-weight: 400; font-size: 0.85rem; color: var(--color-ink-light); }
  .reader__size-rule { display: block; border-top: 1px solid rgba(43, 43, 43, 0.2); margin: 0.35rem 0; }
  .reader__size-note { display: block; padding: 0.2rem 0.9rem 0.3rem; font-weight: 400; font-size: 0.85rem; color: var(--color-ink-light); }
</style>

<style is:global>
  /* The page-flip (docs/design/comic-spread-and-flip.md, "The page-flip"; comic-reader-spread-and-flip
     AC-11): reader pages opt in to cross-document view transitions, unless reduced motion is asked
     for. The page each turn leaves decides whether it plays and which way (the scripts in
     ReaderPage.astro); everything but the turning pages changes at once. 0.4 s in all. */
  ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
  ::view-transition-group(*) { animation-duration: 0.4s; }
  ::view-transition-image-pair(*) { perspective: 2400px; }
  ::view-transition-old(*), ::view-transition-new(*) { animation: none; }

  /* Forward: the right-hand page turns over to the left around the spine, its back becoming the new
     left-hand page; a spread turns as one sheet; a narrow page lifts off around its left edge. */
  html:active-view-transition-type(forward)::view-transition-old(kb-right) {
    z-index: 1; transform-origin: left center; animation: kb-out-to-left 0.4s ease-in both;
  }
  html:active-view-transition-type(forward)::view-transition-new(kb-left) {
    transform-origin: right center; animation: kb-in-from-right 0.4s ease-out both;
  }
  html:active-view-transition-type(forward)::view-transition-old(kb-left) { animation: kb-hold 0.4s both; }
  html:active-view-transition-type(forward)::view-transition-old(kb-spread) {
    z-index: 1; transform-origin: center; animation: kb-out-to-left 0.4s ease-in both;
  }
  html:active-view-transition-type(forward)::view-transition-new(kb-spread) {
    transform-origin: center; animation: kb-in-from-right 0.4s ease-out both;
  }
  html:active-view-transition-type(forward)::view-transition-old(kb-page) {
    z-index: 1; transform-origin: left center; animation: kb-lift-left 0.4s ease-in both;
  }

  /* Back: the reverse. */
  html:active-view-transition-type(back)::view-transition-old(kb-left) {
    z-index: 1; transform-origin: right center; animation: kb-out-to-right 0.4s ease-in both;
  }
  html:active-view-transition-type(back)::view-transition-new(kb-right) {
    transform-origin: left center; animation: kb-in-from-left 0.4s ease-out both;
  }
  html:active-view-transition-type(back)::view-transition-old(kb-right) { animation: kb-hold 0.4s both; }
  html:active-view-transition-type(back)::view-transition-old(kb-spread) {
    z-index: 1; transform-origin: center; animation: kb-out-to-right 0.4s ease-in both;
  }
  html:active-view-transition-type(back)::view-transition-new(kb-spread) {
    transform-origin: center; animation: kb-in-from-left 0.4s ease-out both;
  }
  html:active-view-transition-type(back)::view-transition-new(kb-page) {
    transform-origin: left center; animation: kb-lay-down 0.4s ease-out both;
  }
  html:active-view-transition-type(back)::view-transition-old(kb-page) { animation: kb-hold 0.4s both; }

  @keyframes kb-out-to-left { 0% { transform: rotateY(0); } 50%, 100% { transform: rotateY(-90deg); } }
  @keyframes kb-in-from-right { 0%, 50% { transform: rotateY(90deg); } 100% { transform: rotateY(0); } }
  @keyframes kb-out-to-right { 0% { transform: rotateY(0); } 50%, 100% { transform: rotateY(90deg); } }
  @keyframes kb-in-from-left { 0%, 50% { transform: rotateY(-90deg); } 100% { transform: rotateY(0); } }
  @keyframes kb-lift-left { from { transform: rotateY(0); } to { transform: rotateY(-90deg); } }
  @keyframes kb-lay-down { from { transform: rotateY(-90deg); } to { transform: rotateY(0); } }
  @keyframes kb-hold { from, to { opacity: 1; } }
</style>
