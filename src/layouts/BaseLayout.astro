---
import '../styles/global.css';

const {
  title = 'Kettlebird Creations',
  description = 'Writer & Illustrator • Star Goldberg'
} = Astro.props;

// Year is evaluated at build time
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Nunito:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="page">
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="site-logo" aria-label="Kettlebird Creations - Home">
          <span class="logo-text">Kettlebird Creations</span>
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle menu">
          <span class="menu-toggle-icon"></span>
        </button>
        <nav id="main-nav" class="main-nav">
          <ul class="nav-list">
            <li><a href="/portfolio">Portfolio</a></li>
            <li><a href="/comics">Comics</a></li>
            <li><a href="/writing">Writing</a></li>
            <li><a href="/shop">Shop</a></li>
            <li><a href="/commissions">Commissions</a></li>
            <li><a href="/about">About</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="page__content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-section">
          <h3 class="footer-heading">Connect</h3>
          <ul class="social-links">
            <li>
              <a href="https://kettle-bird.tumblr.com" target="_blank" rel="noopener noreferrer">
                <span class="social-icon">🌐</span> Tumblr
              </a>
            </li>
            <li>
              <a href="https://ko-fi.com/kettlebirdart" target="_blank" rel="noopener noreferrer">
                <span class="social-icon">☕</span> Ko-fi
              </a>
            </li>
            <li>
              <a href="https://bsky.app/profile/kettlebird.bsky.social" target="_blank" rel="noopener noreferrer">
                <span class="social-icon">🦋</span> Bluesky
              </a>
            </li>
          </ul>
        </div>
        <div class="footer-section">
          <h3 class="footer-heading">Contact</h3>
          <p class="footer-contact">
            <a href="mailto:kettlebirdillustration@gmail.com">kettlebirdillustration@gmail.com</a>
          </p>
        </div>
        <div class="footer-section footer-copyright">
          <p>&copy; {currentYear} Kettlebird Creations • Star Goldberg</p>
          <p class="footer-meta">All artwork and writing are the property of the artist.</p>
        </div>
      </div>
    </footer>
    <script>
      // Mobile menu toggle
      const menuToggle = document.querySelector('.menu-toggle');
      const mainNav = document.querySelector('.main-nav');
      
      if (menuToggle && mainNav) {
        menuToggle.addEventListener('click', () => {
          const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
          menuToggle.setAttribute('aria-expanded', String(!isExpanded));
          mainNav.classList.toggle('is-open');
        });
      }
    </script>
  </body>
</html>
