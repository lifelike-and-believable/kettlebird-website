---
// No need for currentYear in this standalone homepage
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kettlebird Creations • Writer & Illustrator</title>
    <meta
      name="description"
      content="Portfolio of Star Goldberg (they/them) - UPA-inspired illustrations, comics, and written works featuring fantasy characters and fanart."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Nunito:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --color-beige: #f5f1e8;
        --color-yellow: #f4ce6a;
        --color-orange: #e89a5a;
        --color-green: #a8d5ba;
        --color-dark-purple: #4a4063;
        --color-ink: #2b2b2b;

        /* Match the Paper_1_Torn.png width you are using */
        --paper-torn-width: 1600px;

        /*
          Height of the torn paper strip (covers title + nav).
          You can increase/decrease without causing clipping now.
        */
        --paper-torn-render-height: 300px;

        /* Space between the nav/buttons and the torn edge */
        --paper-torn-content-bottom-gap: 16px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
        background-color: var(--color-beige);
        color: var(--color-ink);
        line-height: 1.6;
        background-image: url('/assets/images/Paper_2_Tileable.png');
        background-size: 400px 400px;
        background-repeat: repeat;
      }

      .homepage {
        max-width: 1600px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }

      /* Header */
      .homepage-header {
        background-color: transparent;

        /*
          Keep your original "pull header edge-to-edge" behavior,
          but remove the bottom gap (0 gap to the grid).
        */
        margin: -2rem -1rem 0 -1rem;

        position: relative;
        z-index: 1;

        /* clips the torn paper on the sides when viewport is narrow */
        overflow: hidden;

        /*
          Normal content padding (top/sides) plus enough bottom padding to:
          - ensure the torn-paper strip is fully visible (no bottom clipping)
          - end exactly at the bottom of the header so the grid starts immediately after
        */
        padding-top: 2rem;
        padding-left: 1rem;
        padding-right: 1rem;
        padding-bottom: calc(
          2rem + var(--paper-torn-render-height) - var(--paper-torn-content-bottom-gap)
        );
      }

      /* Torn paper layer behind the title + menu */
      .homepage-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: var(--paper-torn-render-height);

        background-image: url('/assets/images/Paper_1_Torn.png');
        background-repeat: no-repeat;
        background-position: center top;

        /*
          - viewport narrower than image: use image width => crop sides only
          - viewport wider than image: use 100% => scale edge-to-edge
        */
        background-size: max(100%, var(--paper-torn-width)) 100%;

        pointer-events: none;
        z-index: 0;
      }

      /* Keep header content above the torn paper */
      .homepage-header > * {
        position: relative;
        z-index: 1;
      }

      .homepage-title {
        font-family: 'Nunito', sans-serif;
        font-size: clamp(3.5rem, 8vw, 5.5rem);
        font-weight: 700;
        margin: 0 0 0.25rem 0;
        letter-spacing: 0.02em;
      }

      .subtitle-nav-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .homepage-subtitle {
        font-family: 'Nunito', sans-serif;
        font-size: clamp(1.5rem, 4vw, 2.5rem);
        font-weight: 600;
        margin: 0;
      }

      /* Navigation */
      .homepage-nav {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .nav-button {
        font-family: 'Nunito', sans-serif;
        font-size: 1rem;
        padding: 0.5rem 1.25rem;
        border: none;
        background-image: url('/assets/images/Highlighter_Y.png');
        background-size: 100% 100%;
        background-repeat: no-repeat;
        background-position: center;
        color: var(--color-ink);
        text-decoration: none;
        display: inline-block;
        font-weight: 700;
        transition: all 0.2s ease-out;
      }

      .nav-button:hover {
        transform: scale(1.05);
        filter: brightness(1.1);
      }

      .nav-button.nav-button-highlight {
        color: var(--color-ink);
        font-weight: 700;
      }

      /* Main Grid */
      .grid-container {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        grid-template-rows: repeat(7, minmax(75px, auto));
        gap: 1rem;

        /* 0 gap: remove top spacing so grid starts immediately under header */
        margin-top: 0;

        margin-bottom: 2rem;
      }

      .grid-tile {
        border: 3px solid var(--color-ink);
        overflow: hidden;
        position: relative;
        min-height: 75px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: transform 0.2s;
      }

      .grid-tile:hover {
        transform: translate(-2px, -2px);
        box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.15);
      }

      .grid-tile-portfolio {
        grid-column: span 2;
        grid-row: span 2;
        background: #8b7355;
      }

      .grid-tile-logo {
        grid-column: span 2;
        grid-row: span 4;
        background: var(--color-yellow);
      }

      .grid-tile-merch {
        grid-column: span 2;
        grid-row: span 2;
        background: var(--color-orange);
      }

      .grid-tile-comics {
        grid-column: span 2;
        grid-row: span 3;
        background: #c8c8c8;
      }

      .grid-tile-commissions {
        grid-column: span 2;
        grid-row: span 2;
        background: #a8a8a8;
      }

      .grid-tile-writing {
        grid-column: 1 / span 2;
        grid-row: 6 / span 2;
        background: #d94f3d;
      }

      .grid-tile-contact {
        grid-column: 3 / span 2;
        grid-row: 5 / span 3;
        background: #cc5544;
      }

      .grid-tile-about {
        grid-column: 5 / span 1;
        grid-row: 5 / span 3;
        background: var(--color-green);
      }

      .grid-tile-about .tile-content {
        justify-content: flex-start;
      }

      .grid-tile-news {
        grid-column: 6 / span 1;
        grid-row: 5 / span 3;
        background: var(--color-yellow);
      }

      .grid-tile-news .tile-content {
        justify-content: flex-end;
      }

      .tile-content {
        text-align: center;
        padding: 1rem;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.2);
      }

      .tile-title {
        font-family: 'Nunito', sans-serif;
        font-size: clamp(1.5rem, 3vw, 2.5rem);
        font-weight: 700;
        color: white;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
      }

      .tile-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      /* Add subtle texture/pattern to tiles */
      .grid-tile-portfolio {
        background: #8b7355;
        background-image: url('/assets/images/bkgd-artwork.jpg');
        background-size: cover;
        background-position: center;
      }

      .grid-tile-comics {
        background: #c8c8c8;
        background-image: url('/assets/images/bkgd-Comics.jpg');
        background-size: cover;
        background-position: center;
      }

      .grid-tile-writing {
        background: #d94f3d;
        background-image: url('/assets/images/bkgd-writing.jpg');
        background-size: cover;
        background-position: center;
      }

      .grid-tile-commissions {
        background: #a8a8a8;
        background-image: url('/assets/images/bkgd-commissions.jpeg');
        background-size: cover;
        background-position: center;
      }

      .grid-tile-contact {
        background: linear-gradient(135deg, #cc5544 0%, #d94f3d 100%);
      }

      .logo-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
      }

      .logo-shape {
        width: clamp(150px, 50%, 250px);
        height: clamp(180px, 60%, 300px);
        background: var(--color-dark-purple);
        border-radius: 50% 50% 0 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        position: relative;
      }

      .logo-inner {
        width: 35%;
        height: 25%;
        background: var(--color-beige);
        border-radius: 50%;
        position: absolute;
        top: 30%;
        left: 50%;
        transform: translateX(-50%);
      }

      .logo-letters {
        font-family: 'Nunito', sans-serif;
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 700;
        color: var(--color-ink);
      }

      /* Social Links */
      .social-links {
        display: flex;
        gap: 0;
        flex-wrap: wrap;
        justify-content: center;
        margin-bottom: 3rem;
        max-width: 80%;
        margin-left: auto;
        margin-right: auto;
      }

      .social-link {
        font-family: 'Nunito', sans-serif;
        font-size: 1.5rem;
        padding: 1.25rem 2.5rem;
        text-decoration: none;
        color: var(--color-ink);
        font-weight: 700;
        transition: all 0.2s ease-out;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        background-size: 100% 100%;
        background-repeat: no-repeat;
        background-position: center;
        flex: 1 1 auto;
        min-width: 180px;
        border-right: 3px solid var(--color-ink);
      }

      .social-link:last-child {
        border-right: none;
      }

      .social-link:nth-child(1) {
        background-image: url('/assets/images/Highlighter_G.png');
      }
      .social-link:nth-child(2) {
        background-image: url('/assets/images/Highlighter_Y.png');
      }
      .social-link:nth-child(3) {
        background-image: url('/assets/images/Highlighter_O.png');
      }
      .social-link:nth-child(4) {
        background-image: url('/assets/images/Highlighter_M.png');
      }

      .social-link:hover {
        transform: scale(1.05);
        filter: brightness(1.1);
      }

      .social-link:focus-visible {
        outline: 3px solid var(--color-ink);
        outline-offset: 4px;
        transform: scale(1.05);
      }

      /* About Section */
      .about-section {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 2rem;
        margin-bottom: 2rem;
        align-items: start;
      }

      .about-text h2 {
        font-family: 'Nunito', sans-serif;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        margin-top: 0;
        margin-bottom: 1rem;
      }

      .portrait-placeholder {
        background-image: url('/assets/images/Postit.png');
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
        border: none;
        aspect-ratio: 3/4;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Nunito', sans-serif;
        font-size: 1.2rem;
        text-align: center;
        padding: 2rem;
      }

      .about-text {
        font-size: 1rem;
        line-height: 1.8;
        color: var(--color-ink);
      }

      /* Responsive */
      @media (max-width: 768px) {
        /* a little taller on mobile since nav wraps */
        :root {
          --paper-torn-render-height: 340px;
        }

        .subtitle-nav-container {
          flex-direction: column;
          align-items: flex-start;
        }

        .grid-container {
          grid-template-columns: repeat(2, 1fr);
        }

        .grid-tile-portfolio,
        .grid-tile-logo,
        .grid-tile-merch,
        .grid-tile-comics,
        .grid-tile-commissions,
        .grid-tile-writing,
        .grid-tile-contact {
          grid-column: span 2;
          grid-row: auto;
        }

        .grid-tile-about,
        .grid-tile-news {
          grid-column: span 1;
          grid-row: auto;
        }

        /* Mobile panel ordering */
        .grid-tile-logo {
          order: -1;
        } /* 1st - Logo/Hero */
        .grid-tile-portfolio {
          order: 0;
        } /* 2nd - Portfolio */
        .grid-tile-comics {
          order: 1;
        } /* 3rd - Comics */
        .grid-tile-writing {
          order: 2;
        } /* 4th - Writing */
        .grid-tile-commissions {
          order: 3;
        } /* 5th - Commissions */
        .grid-tile-merch {
          order: 4;
        } /* 6th - Merch */
        .grid-tile-about {
          order: 5;
        } /* 7th - About (left) */
        .grid-tile-news {
          order: 6;
        } /* 7th - News (right) */
        .grid-tile-contact {
          order: 7;
        } /* 8th - Contact */

        .about-section {
          grid-template-columns: 1fr;
        }

        .portrait-placeholder {
          max-width: 300px;
          margin: 0 auto;
        }
      }
    </style>
  </head>
  <body>
    <div class="homepage">
      <!-- Header -->
      <header class="homepage-header">
        <h1 class="homepage-title">Kettlebird</h1>
        <div class="subtitle-nav-container">
          <p class="homepage-subtitle">Comics + Illustration</p>
          <!-- Navigation -->
          <nav class="homepage-nav">
            <a href="/portfolio" class="nav-button">PORTFOLIO</a>
            <a href="/comics" class="nav-button">COMICS</a>
            <a href="/writing" class="nav-button">WRITING</a>
            <a href="/about" class="nav-button">ABOUT</a>
            <a href="#news" class="nav-button nav-button-highlight">NEWS</a>
          </nav>
        </div>
      </header>

      <!-- Main Grid -->
      <div class="grid-container">
        <!-- Portfolio Tile -->
        <a href="/portfolio" class="grid-tile grid-tile-portfolio">
*
