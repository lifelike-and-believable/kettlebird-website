---
import WritingPage from '../components/pages/WritingPage.astro';
import { getAllWrittenWorks, type WrittenWork } from '../lib/queries';

let works: WrittenWork[] = [];
try {
  works = await getAllWrittenWorks();
} catch (e) {
  console.warn('[writing] Could not fetch written works:', e);
}
---

<WritingPage works={works} />
