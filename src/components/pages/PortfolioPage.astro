---
// The portfolio. Rendered by src/pages/portfolio.astro and by the preview route
// (docs/specs/content-editing-preview.md), which can move to a piece or open it.
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { PreviewInfo } from '../../lib/preview/load';
import GalleryGrid from '../GalleryGrid';
import type { GalleryItem } from '../../lib/queries';

const { items, focusId, openId, preview = false } = Astro.props as {
  items: GalleryItem[];
  focusId?: string;
  openId?: string;
  preview?: boolean;
};
/** In the preview route: what the preview shows and outlines (docs/specs/content-editing-preview.md). */
const previewInfo = (Astro.props as { previewInfo?: PreviewInfo }).previewInfo;
---


<BaseLayout
  previewInfo={previewInfo}
  title="Portfolio • Kettlebird Creations"
  description="Illustrations, fanart, original characters, and commissioned work by Star Goldberg (Kettlebird)."
>
  <section class="portfolio-page">
    <header class="portfolio-header">
      <h1 class="page-title portfolio-title">Portfolio</h1>
      <p class="portfolio-subtitle">Illustrations, fanart, and original characters</p>
    </header>

    <GalleryGrid items={items} focusId={focusId} openId={openId} preview={preview} client:load />
  </section>
</BaseLayout>

<style>
  .portfolio-page {
    /* full-bleed bands handle their own width; no horizontal padding here */
    padding: 0 0 4rem;
  }

  .portfolio-header {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1rem 0;
  }

  .portfolio-title {
    margin: 0 0 0.25rem;
  }

  .portfolio-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.1rem;
    color: var(--color-dark-purple, #4a4063);
    margin: 0;
  }

  /* ── INDEX filter bar ─────────────────────────────────────── */
  :global(.gallery-index) {
    max-width: 1400px;
    margin: 0 auto 2rem;
    padding: 1.5rem 1rem 0;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  :global(.gallery-index__label) {
    font-family: 'DM Mono', monospace;
    font-size: 1.15rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.3rem 1.1rem;
    color: var(--color-ink, #2b2b2b);
    background: url('/assets/images/Highlighter_M.png') no-repeat center;
    background-size: 100% 100%;
    flex-shrink: 0;
  }

  :global(.gallery-filters) {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  :global(.filter-btn) {
    font-family: 'DM Mono', monospace;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.35rem 1rem;
    border: 2px solid var(--color-ink, #2b2b2b);
    background: transparent;
    color: var(--color-ink, #2b2b2b);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  :global(.filter-btn:hover),
  :global(.filter-btn--active) {
    background: var(--color-ink, #2b2b2b);
    color: var(--color-beige, #f5f1e8);
  }

  /* ── Stacked, edge-to-edge folder bands ───────────────────── */
  :global(.folder-stack) {
    display: flex;
    flex-direction: column;
  }

  /* Each band runs the full viewport width and butts against its
     neighbours — no gaps, no drop shadows. Kraft tone now; ready to
     swap background-image for a texture asset from Star later. */
  :global(.folder-section) {
    width: 100%;
    position: relative;
    background-color: #c3a47d;
    background-image: url('/assets/images/Paper_2_Tileable.png');
    background-size: 420px;
    background-blend-mode: multiply;
  }

  :global(.folder-section[data-cat='original'])   { background-color: #c9aa7e; }
  :global(.folder-section[data-cat='fanart'])      { background-color: #bd9f76; }
  :global(.folder-section[data-cat='commission'])  { background-color: #c2a06e; }
  :global(.folder-section[data-cat='featured'])    { background-color: #c9a87c; }
  :global(.folder-section[data-cat='wip'])         { background-color: #bfa884; }

  /* Torn-paper seam at the top edge of each band */
  :global(.folder-section::before) {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 16px;
    background: url('/assets/images/Paper_1_Torn.png') repeat-x top center;
    background-size: auto 16px;
    pointer-events: none;
  }

  :global(.folder-inner) {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2.75rem 1rem 1.75rem;
    position: relative;
  }

  /* Section label as a monospace marker tab straddling the top edge */
  :global(.folder-label) {
    position: absolute;
    top: -0.7rem;
    left: 1rem;
    font-family: 'DM Mono', monospace;
    font-weight: 500;
    /* Capped by the screen's width, as page titles are, so it stays on one line at phone width with
       large text; it can still wrap between words rather than run off the screen. */
    font-size: min(1.5rem, 7vw);
    letter-spacing: 0.02em;
    color: var(--color-ink, #2b2b2b);
    padding: 0.2rem 1rem;
    max-width: calc(100% - 2rem);
    overflow-wrap: break-word;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100% 100%;
  }

  :global(.folder-label[data-cat='original'])   { background-image: url('/assets/images/Highlighter_Y.png'); }
  :global(.folder-label[data-cat='fanart'])      { background-image: url('/assets/images/Highlighter_G.png'); }
  :global(.folder-label[data-cat='commission'])  { background-image: url('/assets/images/Highlighter_O.png'); }
  :global(.folder-label[data-cat='featured'])    { background-image: url('/assets/images/Highlighter_M.png'); }
  :global(.folder-label[data-cat='wip'])         { background-image: url('/assets/images/Highlighter_Y.png'); }

  /* ── Carousel ─────────────────────────────────────────────── */
  :global(.carousel) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  :global(.carousel__track) {
    display: flex;
    gap: 0.85rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    flex: 1;
    /* Narrower than a card on a small screen with large text: the track scrolls, the page doesn't. */
    min-width: 0;
    padding-bottom: 0.25rem;
  }

  :global(.carousel__track::-webkit-scrollbar) {
    display: none;
  }

  :global(.carousel__arrow) {
    flex-shrink: 0;
    /* Smaller on a narrow screen with large text, leaving room for the pictures. */
    width: min(2.5rem, 12vw);
    height: min(2.5rem, 12vw);
    background: var(--color-ink, #2b2b2b);
    color: var(--color-beige, #f5f1e8);
    border: none;
    font-size: min(1.6rem, 8vw);
    line-height: 1;
    cursor: pointer;
    font-family: 'Nunito', sans-serif;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.1s;
  }

  :global(.carousel__arrow:hover) {
    transform: scale(1.12);
  }

  /* ── Gallery card (thumbnail in carousel) ─────────────────── */
  :global(.gallery-card) {
    position: relative;
    border: 3px solid var(--color-ink, #2b2b2b);
    overflow: hidden;
    background: var(--color-beige, #f5f1e8);
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
    /* At most the track's width, so a whole piece shows on a small screen with large text. */
    width: min(220px, 100%);
    aspect-ratio: 1;
    scroll-snap-align: start;
    transition: transform 0.18s;
  }

  :global(.gallery-card:hover) {
    transform: scale(1.04);
    z-index: 1;
  }

  :global(.gallery-card__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  :global(.gallery-card__placeholder) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    background: var(--color-yellow, #f4ce6a);
  }

  :global(.gallery-card__overlay) {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    padding: 1.5rem 0.75rem 0.6rem;
    opacity: 0;
    transition: opacity 0.2s;
  }

  :global(.gallery-card:hover .gallery-card__overlay),
  :global(.gallery-card:focus-visible .gallery-card__overlay) {
    opacity: 1;
  }

  :global(.gallery-card__title) {
    font-family: 'DM Mono', monospace;
    font-weight: 500;
    font-size: 0.85rem;
    color: #fff;
  }

  :global(.gallery-empty) {
    font-family: 'DM Mono', monospace;
    font-size: 1rem;
    padding: 1rem 0;
    color: var(--color-ink, #2b2b2b);
  }

  /* Empty portfolio: the message and a way on to Star's social profiles (design-clear-placeholders). */
  :global(.gallery-empty-state) {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  :global(.gallery-empty__more) {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
  }

  :global(.gallery-empty__more a) {
    color: var(--color-ink, #2b2b2b);
    font-weight: 700;
  }

  /* ── Lightbox ─────────────────────────────────────────────── */
  :global(.lightbox) {
    position: fixed;
    inset: 0;
    background: rgba(43, 43, 43, 0.85);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  :global(.lightbox__inner) {
    background: var(--color-beige, #f5f1e8);
    border: 3px solid var(--color-ink, #2b2b2b);
    max-width: 900px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  :global(.lightbox__close) {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: var(--color-ink, #2b2b2b);
    color: var(--color-beige, #f5f1e8);
    border: none;
    font-size: 1rem;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    z-index: 1;
  }

  :global(.lightbox__img) {
    width: 100%;
    height: auto;
    display: block;
    max-height: 65vh;
    object-fit: contain;
    background: var(--color-ink, #2b2b2b);
  }

  :global(.lightbox__info) {
    padding: 1.25rem;
  }

  :global(.lightbox__title) {
    font-family: 'Nunito', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }

  :global(.lightbox__description) {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  :global(.lightbox__tags) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  :global(.lightbox__tag) {
    font-family: 'DM Mono', monospace;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    border: 2px solid var(--color-ink, #2b2b2b);
    background: var(--color-yellow, #f4ce6a);
  }

  /* ── Full screen (docs/design/portfolio-full-screen.md) ─────────────────── */
  :global(.lightbox__pic) { position: relative; background: var(--color-ink, #2b2b2b); }
  :global(.lightbox__pic .lightbox__img) { cursor: zoom-in; }
  :global(.lightbox__full) {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0.35rem 0.75rem;
    background: var(--color-beige, #f5f1e8);
    color: var(--color-ink, #2b2b2b);
    border: 2px solid var(--color-ink, #2b2b2b);
    font: 700 0.95rem 'Nunito', sans-serif;
    cursor: pointer;
  }
  :global(.lightbox__full:focus-visible) { outline: 3px solid var(--color-beige, #f5f1e8); outline-offset: 3px; box-shadow: 0 0 0 6px #4a4063; }
  @media (max-width: 699px) {
    :global(.lightbox__full) { padding: 0; width: 44px; }
    :global(.lightbox__full-label) { display: none; }
  }

  :global(.fs) {
    position: fixed;
    inset: 0;
    z-index: 2000;
    height: 100dvh;
    background: #161616;
    color: #f5f1e8;
    overflow: hidden;
    touch-action: none;
    user-select: none;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  }
  :global(.fs:focus) { outline: none; }
  :global(.fs__stage) { position: absolute; overflow: hidden; cursor: grab; }
  :global(.fs__stage.is-full) { inset: 0; }
  :global(.fs__img) { position: absolute; max-width: none; object-fit: contain; transform-origin: center; }
  :global(.fs__img--ease) { transition: transform 0.2s ease-out; }
  :global(.fs__failed) { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; margin: 0; font: 600 1.1rem 'Nunito', sans-serif; }
  :global(.fs__loading) {
    position: absolute; left: 50%; top: 50%; width: 32px; height: 32px; margin: -16px;
    border: 3px solid #f5f1e855; border-top-color: #f5f1e8; border-radius: 50%;
    animation: fs-spin 0.9s linear infinite;
  }
  @keyframes fs-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { :global(.fs__loading) { animation: none; } }

  :global(.fs__controls) { transition: opacity 0.2s; }
  :global(.fs__controls[data-hidden='true']) { opacity: 0; pointer-events: none; }
  :global(.fs__top) {
    position: absolute; top: 0; left: 0; right: 0; height: 60px; z-index: 2;
    display: flex; align-items: center; gap: 1rem; padding: 0.5rem 0.5rem 0.5rem 1rem;
    background: #161616; border-bottom: 1px solid #f5f1e833;
  }
  :global(.fs__title) { flex: 1; min-width: 0; font: 700 1.05rem 'Nunito', sans-serif; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :global(.fs__count) { font: 500 0.9rem 'DM Mono', monospace; white-space: nowrap; }
  :global(.fs__btn) {
    min-width: 44px; min-height: 44px; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    background: #161616; color: #f5f1e8; border: 2px solid #f5f1e8; font: 700 1.1rem 'Nunito', sans-serif; cursor: pointer;
  }
  :global(.fs__btn:focus-visible) { outline: 3px solid #f4ce6a; outline-offset: 2px; }
  :global(.fs__btn.is-off) { border-style: dashed; border-color: #f5f1e877; color: #f5f1e877; cursor: default; }
  :global(.fs__close) { flex-direction: row; padding: 0 0.75rem; background: #f5f1e8; color: #2b2b2b; font-size: 0.95rem; }
  :global(.fs__side) { position: absolute; z-index: 2; width: 56px; height: 72px; }
  :global(.fs__cap) { font: 600 0.7rem 'Nunito', sans-serif; }
  :global(.fs--wide .fs__side), :global(.fs__side) { top: 50%; transform: translateY(-50%); }
  :global(.fs__side--prev) { left: 0.5rem; }
  :global(.fs__side--next) { right: 0.5rem; }
  :global(.fs__bottom) { position: absolute; left: 0; right: 0; bottom: 0; height: 76px; z-index: 1; background: #161616; border-top: 1px solid #f5f1e833; }
  :global(.fs__zoom) {
    position: absolute; z-index: 2; bottom: 0.75rem; left: 50%; transform: translateX(-50%);
    display: flex; align-items: center; gap: 0.25rem; padding: 0.25rem; background: #161616; border: 2px solid #f5f1e8;
  }
  :global(.fs__zoom .fs__btn) { border-color: transparent; }
  :global(.fs__zoom .fs__btn.is-off) { border-color: #f5f1e877; }
  :global(.fs__level) { font: 500 0.85rem 'DM Mono', monospace; min-width: 4.5em; text-align: center; }
  :global(.fs__fit) { font-size: 0.85rem; }
  :global(.fs__map) { position: absolute; z-index: 2; right: 0.75rem; bottom: 0.75rem; width: 120px; border: 2px solid #f5f1e8; background: #000; }
  :global(.fs__map img) { display: block; width: 100%; opacity: 0.55; }
  :global(.fs__map i) { position: absolute; border: 2px solid #f4ce6a; }
  /* A phone held upright: Previous and Next in the bottom bar. */
  @media (max-width: 699px) and (orientation: portrait) {
    :global(.fs__side) { top: auto; bottom: 5px; transform: none; height: 66px; }
    :global(.fs__zoom) { bottom: 0.5rem; }
  }
</style>
