---
import '../styles/global.css';

const {
  title = 'Kettlebird Creations',
  description = 'Portfolio foundation with Astro + Sanity'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=DM+Sans:wght@400;500;700&family=Patrick+Hand:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="page">
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="paper-shell">
        <h1>Kettlebird Creations</h1>
        <p class="lede">
          Illustration, comics, and creative writing by Star Goldberg
        </p>
      </div>
    </header>
    <main id="main" class="page__content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="paper-shell">
        <p>&copy; {new Date().getFullYear()} Kettlebird Creations. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
