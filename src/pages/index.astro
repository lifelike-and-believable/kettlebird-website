---
import BaseLayout from '../layouts/BaseLayout.astro';
import RadialMenu from '../components/RadialMenu';
---

<BaseLayout
  title="Kettlebird Creations"
  description="Illustration, comics, and creative writing by Star Goldberg"
>
  <section class="hero">
    <div class="hero__center">
      <!-- Hero image/logomark at center -->
      <div class="hero__logomark">
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <!-- Hand-drawn circle badge -->
          <circle 
            cx="100" 
            cy="100" 
            r="90" 
            fill="var(--color-paper)" 
            stroke="var(--color-ink)" 
            stroke-width="3"
            style="filter: url(#rough);"
          />
          <!-- Kettlebird silhouette placeholder -->
          <path 
            d="M 70 120 Q 70 100, 85 90 Q 95 85, 105 90 L 110 85 Q 115 80, 120 85 L 115 95 Q 110 100, 105 100 Q 100 105, 100 115 L 95 125 Q 85 130, 75 125 L 70 120 Z" 
            fill="var(--color-ink-night)"
          />
          <!-- SVG roughen filter -->
          <defs>
            <filter id="rough">
              <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" result="noise"/>
              <feDisplacementMap in="SourceGraphic" in2="noise" scale="2" />
            </filter>
          </defs>
        </svg>
      </div>
      
      <!-- RadialMenu centered around the logomark with appropriate radius -->
      <RadialMenu radius={230} client:load />
    </div>
    
    <div class="hero__content">
      <h2 class="hero__title">Welcome to Kettlebird Creations</h2>
      <p class="hero__description">
        Discover original artwork, comics, and stories crafted with ink, imagination, and a touch of chaos.
      </p>
      
      <div class="hero__cta">
        <a href="/portfolio" class="cta-button">
          Explore Portfolio
        </a>
        <a href="/commissions" class="cta-button cta-button--secondary">
          Commission Info
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    padding: 4rem 1rem 3rem;
  }

  .hero__center {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(500px, 90vw);
    height: min(500px, 90vw);
  }

  .hero__logomark {
    width: 100%;
    height: 100%;
    animation: float 6s ease-in-out infinite;
    z-index: 5;
    position: relative;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__logomark {
      animation: none;
    }
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .hero__content {
    max-width: 600px;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 1rem;
    color: var(--color-ink-night);
  }

  .hero__description {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-ink);
    margin-bottom: 2rem;
  }

  .hero__cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: var(--color-primary);
    color: var(--color-paper);
    text-decoration: none;
    font-family: 'Caveat', 'Patrick Hand', sans-serif;
    font-size: 1.5rem;
    border: 2px solid var(--color-ink);
    border-radius: 3% 97% 2% 98% / 97% 3% 98% 2%;
    box-shadow: var(--shadow-paper);
    transition: all 120ms ease-out;
    min-width: 44px;
    min-height: 44px;
  }

  .cta-button:hover {
    background: var(--color-accent-1);
    transform: rotate(-2deg);
    box-shadow: var(--shadow-paper-hover);
  }

  .cta-button:active {
    transform: scale(0.95);
  }

  .cta-button--secondary {
    background: var(--color-secondary);
    color: var(--color-ink);
  }

  .cta-button--secondary:hover {
    background: var(--color-accent-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-button:hover {
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 70vh;
      padding: 3rem 1rem 2rem;
      gap: 2rem;
    }

    .hero__center {
      width: min(350px, 90vw);
      height: min(350px, 90vw);
    }
  }
</style>
