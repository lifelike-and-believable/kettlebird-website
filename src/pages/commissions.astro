---
import CommissionsPage from '../components/pages/CommissionsPage.astro';
import { commissionTypeCards } from '../lib/commission-cards';
import { getAllCommissionTypes, type CommissionType } from '../lib/queries';
import { getSettings } from '../lib/site-settings-source';

let commissionTypes: CommissionType[] = [];
try {
  commissionTypes = await getAllCommissionTypes();
} catch (e) {
  console.warn('[commissions] Could not fetch commission types:', e);
}
const settings = await getSettings();
const types = commissionTypeCards(commissionTypes);
---

<CommissionsPage settings={settings} types={types} />
