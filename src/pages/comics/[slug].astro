---
// Series pages, one per series with a web address. The page itself is src/components/pages/SeriesPage.astro.
import SeriesPage from '../../components/pages/SeriesPage.astro';
import { getComicSeries } from '../../lib/comics/source';
import type { ComicSeries } from '../../lib/comics/model';

export async function getStaticPaths() {
  const series = await getComicSeries();
  return series.filter((s) => s.slug).map((s) => ({ params: { slug: s.slug! }, props: { series: s } }));
}

const { series } = Astro.props as { series: ComicSeries };
---

<SeriesPage series={series} />
