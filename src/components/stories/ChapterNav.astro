---
// Previous chapter, Chapters and Next chapter, above and below a chapter's text, with the same names in
// both (docs/specs/story-reader-pages.md AC-8). On the newest chapter, the end says where the story stops.
import type { ChapterNav } from '../../lib/stories/model';

const { nav, end = false } = Astro.props as { nav: ChapterNav; end?: boolean };
---
<nav class:list={['chapter-nav', { 'chapter-nav--end': end }]} aria-label={end ? 'Chapters, end of chapter' : 'Chapters'}>
  {nav.previous && <a class="chapter-nav__link" href={nav.previous}>Previous chapter</a>}
  <a class="chapter-nav__link" href={nav.chapters}>Chapters</a>
  {nav.next && <a class="chapter-nav__link" href={nav.next}>Next chapter</a>}
  {end && nav.end && <p class="chapter-nav__end">{nav.end}</p>}
</nav>

<style>
  .chapter-nav {
    max-width: 65ch;
    margin: 1rem auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .chapter-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.85rem;
    border: 2px solid var(--color-ink);
    background: var(--color-beige);
    color: var(--color-ink);
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .chapter-nav__link:hover { background: var(--color-yellow); }
  .chapter-nav__end { margin: 0; font-family: 'Nunito', sans-serif; font-weight: 700; }
  .chapter-nav--end { margin-top: 2rem; }
  .chapter-nav--end .chapter-nav__link { flex: 1 1 100%; justify-content: center; font-size: 1.05rem; }
  .chapter-nav--end .chapter-nav__end { flex: 1 1 100%; text-align: center; }
  @media (min-width: 700px) {
    .chapter-nav--end .chapter-nav__link { flex: 1 1 0; }
  }
</style>
