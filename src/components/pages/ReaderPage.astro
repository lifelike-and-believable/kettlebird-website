---
// Reader page (rendered by src/pages/comics/[slug]/[chapter]/[page].astro and the preview route): one comic page, with Back to series, All pages, the location line, and the
// player-style controls. Designs: docs/design/comic-start-reading.md, docs/design/comic-turn-pages.md,
// docs/design/comic-sheet-and-controls.md (which replaces the Previous page / Next page pair).
// Specs: docs/specs/comic-reader-start-and-turn.md, docs/specs/comic-reader-sheet-and-controls.md.
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { PreviewInfo } from '../../lib/preview/load';
import {
  endNote,
  locationLine,
  pageAltText,
  readerPages,
  seriesPath,
  tabTitle,
  type ReaderPage,
} from '../../lib/comics/model';
import { allPagesHref, playControls, type ControlKind, type PlayControl } from '../../lib/comics/navigation';
import { pageAnnouncement, pagePreview, shareTitle } from '../../lib/comics/sharing';
import { readsAs, wideView, type WideView } from '../../lib/comics/spreads';
import { previewTurn } from '../../lib/preview/turns';
import { offersPanels, pagePanels } from '../../lib/comics/panels';


const { entry, nextImage, preview: inPreview = false, previewUrl } = Astro.props as {
  entry: ReaderPage;
  nextImage?: ReaderPage['page']['image'];
  /** In the preview: don't scroll (it would scroll the editor around the preview) or fetch the next page. */
  preview?: boolean;
  /** In a chapter's preview, its address: turns move within the chapter there (comic-reader-comic-settings AC-9). */
  previewUrl?: string;
};
const back = seriesPath(entry.series.slug!);
// Two-page spreads (docs/design/comic-spread-and-flip.md, docs/specs/comic-reader-spread-and-flip.md):
// the page carries its narrow view (this page) and its wide view (its group), and the width test in
// the styles below shows one. The script picks the same one with WIDE_MEDIA.
// How it reads (docs/specs/comic-reader-comic-settings.md): with pairs off, one view only, the narrow
// one, on every screen; with the flip off, the page doesn't opt in to the page-flip.
const reads = readsAs(entry.series);
const single: WideView = {
  kind: 'right',
  pages: [entry],
  previousPath: entry.previousPath,
  nextPath: entry.nextPath,
  isLast: entry.isLast,
  location: locationLine(entry),
  announcement: pageAnnouncement(entry),
  controls: playControls(entry),
};
const wide = reads.twoUp ? wideView(entry) : single;
const end = wide.isLast ? endNote(entry.series.status) : undefined;
// In a chapter's preview, a turn within the chapter goes to the preview's own address; anything
// else stays inactive, as every preview link is (AC-9).
const turnHref = (to?: string) => (previewUrl && to ? previewTurn(new URL(previewUrl), entry, to) : to);
const turnAttrs = (to?: string) => (previewUrl && turnHref(to) ? { 'data-preview-turn': '' } : {});
/** Shown on both views, or on one: a class that hides it on the other. */
const only = (narrow: boolean, onWide: boolean) => (narrow && onWide ? '' : narrow ? 'for-narrow' : 'for-wide');
const controls = playControls(entry);
// The wide set first: tools that look for a control by its visible word, like the tutorial runner,
// take the first match, and a laptop shows the wide set. Hidden sets are out of the Tab order and
// the accessibility tree, so the order changes nothing for readers.
const views: { view: 'narrow' | 'wide'; controls: PlayControl[] }[] = reads.twoUp
  ? [{ view: 'wide', controls: wide.controls }, { view: 'narrow', controls }]
  : [{ view: 'narrow', controls }];
const sides = wide.kind === 'pair' ? ['left', 'right'] : [wide.kind === 'spread' ? 'both' : wide.kind];
const nextWide = reads.twoUp && wide.nextPath ? readerPages(entry.series).find((e) => e.path === wide.nextPath) : undefined;
const nextWideImages = nextWide && !inPreview ? wideView(nextWide).pages.map((p) => p.page.image) : [];
const allPages = allPagesHref(entry);
// Panel by panel (docs/specs/comic-reader-panels.md): offered in chapters with panels, shown by the script.
const panelled = offersPanels(entry);
const panels = pagePanels(entry.page);
const preview = { ...pagePreview(entry, Astro.site!.href), type: 'article' };
// Drawn arrowheads: phones draw characters like ⏭ as emoji of their own (design, Layout).
const ICONS: Record<ControlKind, { viewBox: string; d: string }> = {
  first: { viewBox: '0 0 32 24', d: 'M30 4 L18 12 L30 20 Z M16 4 L4 12 L16 20 Z' },
  previous: { viewBox: '0 0 24 24', d: 'M17 4 L5 12 L17 20 Z' },
  next: { viewBox: '0 0 24 24', d: 'M7 4 L19 12 L7 20 Z' },
  newest: { viewBox: '0 0 32 24', d: 'M2 4 L14 12 L2 20 Z M16 4 L28 12 L16 20 Z' },
};
const SIZES = '(min-width: 62.5em) and (orientation: landscape) 50vw, (max-width: 700px) 100vw, 900px';
const TURNS: Partial<Record<ControlKind, string>> = { previous: 'previous', next: 'next' };
/** In the preview route: what the preview shows and outlines (docs/specs/content-editing-preview.md). */
const previewInfo = (Astro.props as { previewInfo?: PreviewInfo }).previewInfo;
---

<BaseLayout
  previewInfo={previewInfo}
  title={tabTitle(entry)}
  description={`${entry.series.title}, a comic by Star Goldberg.`}
  canonical={preview.url}
  preview={preview}
>
  <!-- Don't draw the page until the scroll below has run, so the site header never flashes on a
       turn, even when the page arrives in pieces. Browsers without render-blocking ignore it. -->
  {!inPreview && <link slot="head" rel="expect" href="#reader-scrolled" {...{ blocking: 'render' }} />}
  {reads.pageFlip && (
    <style is:inline slot="head">
      /* This comic turns its pages with the page-flip (comic-reader-comic-settings AC-5). */
      @media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }
    </style>
  )}
  {reads.pageFlip && (
    <script is:inline slot="head">
      // The page-flip (docs/specs/comic-reader-spread-and-flip.md AC-11): a turn arrives with its
      // direction, saved by the page it left. Anything else, or a picture that isn't ready, changes
      // the page without it. In the head, so it runs before the first frame.
      addEventListener('pagereveal', function (e) {
        var vt = e.viewTransition;
        if (!vt) return;
        var flip = null;
        try {
          flip = JSON.parse(sessionStorage.getItem('kb-flip') || 'null');
          sessionStorage.removeItem('kb-flip');
        } catch (_) {}
        var ready = Array.prototype.every.call(document.querySelectorAll('.reader__page img'), function (img) {
          return img.offsetParent === null || img.complete;
        });
        if (!flip || flip.to !== location.pathname + location.search || Date.now() - flip.at > 5000 || !ready || !vt.types) {
          vt.skipTransition();
          return;
        }
        vt.types.add(flip.dir);
      });
    </script>
  )}
  <div class:list={['reader', { 'reader--pairs': reads.twoUp, 'reader--panelled': panelled }]} data-pairs={reads.twoUp ? '' : undefined}>
    <div class="reader__bar">
      <a href={back} class="reader__back">Back to series</a>
      {panelled && (
        <button type="button" class="reader__panels" data-panels-toggle aria-pressed="false" hidden>
          <svg viewBox="0 0 16 22" width="14" height="20" aria-hidden="true" focusable="false">
            <rect x="1" y="1" width="14" height="20" fill="none" stroke="currentColor" stroke-width="2" />
            <rect x="3" y="3" width="10" height="7" fill="currentColor" />
            <rect x="3" y="12" width="4" height="7" fill="none" stroke="currentColor" stroke-width="1.5" />
            <rect x="9" y="12" width="4" height="7" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
          Panel by panel
        </button>
      )}
      {allPages && (
        <a href={allPages} class="reader__all" aria-label="All pages in this chapter">
          <span class="reader__grid" aria-hidden="true">{Array.from({ length: 9 }, () => <i></i>)}</span>
          All pages
        </a>
      )}
      {locationLine(entry) === wide.location ? (
        <h1 class="reader__location" data-part="reader-location">{wide.location}</h1>
      ) : (
        <>
          <h1 class="reader__location for-narrow" data-part="reader-location">{locationLine(entry)}</h1>
          <h1 class="reader__location for-wide" data-part="reader-location">{wide.location}</h1>
        </>
      )}
    </div>

    <div class="reader__book" data-reader-page data-part="reader-page" data-kind={wide.kind}>
      {wide.pages.map((p, i) => {
        const current = p.path === entry.path;
        const img = p.page.image;
        const first = i === 0;
        const last = i === wide.pages.length - 1;
        return (
          <div
            class:list={['reader__page', current ? 'is-current' : 'is-other', { 'is-spread': p.page.spread }]}
            data-panels={current && panelled ? JSON.stringify(panels) : undefined}
            data-side={sides[i]}
            style={`aspect-ratio: ${img.width} / ${img.height}; --page-ratio: ${(img.width / img.height).toFixed(4)};`}
          >
            <p class="reader__loading">Loading page… If it doesn't appear, try refreshing.</p>
            {current && panelled && <span class="reader__panel-mask" aria-hidden="true"></span>}
            <img
              src={img.src}
              srcset={img.srcset}
              sizes={p.page.spread ? '100vw' : SIZES}
              width={img.width}
              height={img.height}
              alt={pageAltText(p)}
              decoding="async"
              loading={current ? undefined : 'lazy'}
            />
            {current && entry.previousPath && (
              <a href={turnHref(entry.previousPath)} {...turnAttrs(entry.previousPath)} class:list={['reader__edge reader__edge--prev', { 'for-narrow': reads.twoUp }]} aria-hidden="true" tabindex="-1">‹</a>
            )}
            {current && entry.nextPath && (
              <a href={turnHref(entry.nextPath)} {...turnAttrs(entry.nextPath)} class:list={['reader__edge reader__edge--next', { 'for-narrow': reads.twoUp }]} aria-hidden="true" tabindex="-1">›</a>
            )}
            {reads.twoUp && first && wide.previousPath && (
              <a href={turnHref(wide.previousPath)} {...turnAttrs(wide.previousPath)} class="reader__edge reader__edge--prev for-wide" aria-hidden="true" tabindex="-1">‹</a>
            )}
            {reads.twoUp && last && wide.nextPath && (
              <a href={turnHref(wide.nextPath)} {...turnAttrs(wide.nextPath)} class="reader__edge reader__edge--next for-wide" aria-hidden="true" tabindex="-1">›</a>
            )}
          </div>
        );
      })}
    </div>
    {entry.page.spread && <p class="reader__turn-hint" aria-hidden="true">Turn your phone sideways to see it bigger.</p>}

    {views.map(({ view, controls: set }) => set.length > 0 && (
      <div class:list={['reader__controls-box', { [`for-${view}`]: reads.twoUp }]} data-view={view}>
        <nav class="reader__controls" aria-label="Page navigation">
          {set.map((c) => {
            const icon = ICONS[c.kind];
            const body = (
              <>
                <svg viewBox={icon.viewBox} width={c.kind === 'first' || c.kind === 'newest' ? 30 : 26} height="24" aria-hidden="true" focusable="false">
                  <path d={icon.d} fill="currentColor" />
                </svg>
                <span class="reader__control-caption">{c.caption}</span>
                <span class="reader__control-tip" aria-hidden="true">{c.name}</span>
              </>
            );
            return c.path ? (
              <a
                href={TURNS[c.kind] ? turnHref(c.path) : c.path}
                {...(TURNS[c.kind] ? turnAttrs(c.path) : {})}
                class={`reader__control reader__control--${c.kind}`}
                aria-label={c.name}
                rel={c.kind === 'previous' ? 'prev' : c.kind === 'next' ? 'next' : undefined}
                data-turn={TURNS[c.kind]}
                data-control={c.kind}
              >{body}</a>
            ) : (
              <a
                role="link"
                aria-disabled="true"
                aria-label={c.name}
                tabindex="-1"
                data-control={c.kind}
                class={`reader__control reader__control--${c.kind} is-off`}
              >{body}</a>
            );
          })}
        </nav>
      </div>
    ))}
    {end && (
      <div class:list={['reader__end', only(entry.isLast, wide.isLast)]}>
        <p class="reader__end-heading">{end.heading}</p>
        <p>{end.line}</p>
        <a href={back}>Back to series</a>
      </div>
    )}

    <!-- Share this page (design-comic-share-and-announce): needs a script, so it's shown by one. -->
    <div class="reader__share" data-share hidden>
      <button type="button" class="reader__share-button" data-share-button data-url={preview.url} data-title={shareTitle(entry)}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <circle cx="18" cy="5" r="3" fill="currentColor" /><circle cx="6" cy="12" r="3" fill="currentColor" /><circle cx="18" cy="19" r="3" fill="currentColor" />
          <path d="M8.6 10.7 L15.4 6.4 M8.6 13.3 L15.4 17.6" stroke="currentColor" stroke-width="2" />
        </svg>
        <span data-share-label>Share this page</span>
      </button>
      <p class="visually-hidden" role="status" data-share-status></p>
      <p class="reader__copy" data-copy hidden>
        <label for="copy-link">Copy this link:</label>
        <input id="copy-link" type="text" readonly value={preview.url} />
      </p>
    </div>
    <!-- What a screen reader hears when the page opens; filled in by the script below. -->
    <p class="visually-hidden" role="status" data-announce data-text={pageAnnouncement(entry)} data-text-wide={wide.announcement}></p>
  </div>

  {!inPreview && (
    <>
  <script is:inline>
    // Open with the reader bar at the top of the window, past the site header, so the whole page
    // shows and the next page appears without scrolling back up (design-comic-turn-pages). Inline,
    // right after the reader, and the page isn't drawn until the marker after it is parsed (the
    // render-blocking link above): otherwise the header can flash on screen at a turn. Skipped if
    // the fan has already scrolled; without a script the page simply starts at the top.
    if (window.scrollY === 0) document.querySelector('.reader')?.scrollIntoView({ block: 'start' });
  </script>
  <span id="reader-scrolled" hidden></span>
    </>
  )}

  {nextImage && !inPreview && <meta name="kb-next-image" content={nextImage.src} data-srcset={nextImage.srcset ?? ''} data-view="narrow" />}
  {nextWideImages.map((img) => <meta name="kb-next-image" content={img.src} data-srcset={img.srcset ?? ''} data-view="wide" />)}

  <script>
    import { announcesOnOpen, focusAfterTurn, type NavigationKind, type RememberedTurn } from '../../lib/comics/sharing';
    import { turnDirection, WIDE_MEDIA } from '../../lib/comics/spreads';
    import { panelAnnouncement, panelFrame, panelsOn, PANELS_OFF, type Panel } from '../../lib/comics/panels';

    // Two pages side by side when the width test matches (comic-reader-spread-and-flip AC-3); the
    // styles use the same test, so this picks the links that show.
    const wideScreen = matchMedia(WIDE_MEDIA);
    // A comic with two pages side by side off has only the narrow set (comic-reader-comic-settings AC-2).
    const pairs = document.querySelector('.reader')?.hasAttribute('data-pairs') ?? false;
    const view = () => (pairs && wideScreen.matches ? 'wide' : 'narrow');

    // Arrow keys and swipes follow the same links as Previous page and Next page
    // (design-comic-turn-pages, "How a page turn works"). Reading never needs this script.
    const link = (which: 'previous' | 'next') =>
      document.querySelector<HTMLAnchorElement>(`[data-view="${view()}"] [data-turn="${which}"]`);
    const zoomed = () => (window.visualViewport?.scale ?? 1) > 1.01;
    /** Set by panel by panel: takes a turn itself (true), or lets the page turn (false). */
    let panelTurn: ((which: 'previous' | 'next') => boolean) | undefined;
    const turnTo = (which: 'previous' | 'next') => {
      if (panelTurn?.(which)) return;
      const target = link(which);
      if (target) location.assign(target.href);
    };

    document.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey || zoomed()) return;
      const t = e.target as HTMLElement | null;
      if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
      const which = e.key === 'ArrowRight' ? 'next' : e.key === 'ArrowLeft' ? 'previous' : null;
      if (which && (link(which) || panelTurn)) {
        e.preventDefault();
        turnTo(which); // not a click: arrow keys don't move focus (design-comic-share-and-announce)
      }
    });

    const area = document.querySelector<HTMLElement>('[data-reader-page]');
    let start: { x: number; y: number } | null = null;
    area?.addEventListener('pointerdown', (e) => {
      start = e.pointerType === 'touch' && !zoomed() ? { x: e.clientX, y: e.clientY } : null;
    });
    area?.addEventListener('pointerup', (e) => {
      if (!start || e.pointerType !== 'touch') return;
      const dx = e.clientX - start.x;
      const dy = e.clientY - start.y;
      start = null;
      // A turn needs a clearly horizontal swipe; mostly vertical movement is scrolling.
      if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5 || zoomed()) return;
      turnTo(dx < 0 ? 'next' : 'previous');
    });

    // After a turn with a control, focus that control on the new page; announce each page as it
    // opens, except on a reload (design-comic-share-and-announce, Accessibility).
    const TURN_KEY = 'kb-turn';
    const navigation = ((performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type ??
      'navigate') as NavigationKind;
    let remembered: RememberedTurn | undefined;
    try {
      remembered = JSON.parse(sessionStorage.getItem(TURN_KEY) ?? 'null') ?? undefined;
      sessionStorage.removeItem(TURN_KEY);
    } catch {
      remembered = undefined;
    }
    let referrerPath: string | undefined;
    try {
      const from = new URL(document.referrer);
      referrerPath = from.origin === location.origin ? from.pathname : undefined;
    } catch {
      referrerPath = undefined;
    }
    const kind = focusAfterTurn(remembered, { navigation, referrerPath, time: Date.now() });
    if (kind) document.querySelector<HTMLElement>(`[data-view="${view()}"] [data-control="${kind}"]`)?.focus({ preventScroll: true });

    document.querySelectorAll<HTMLAnchorElement>('a[data-control][href]').forEach((control) => {
      control.addEventListener('click', () => {
        const turn: RememberedTurn = { kind: control.dataset.control as RememberedTurn['kind'], from: location.pathname, at: Date.now() };
        try {
          sessionStorage.setItem(TURN_KEY, JSON.stringify(turn));
        } catch {
          // Storage refused: the turn still happens, without keeping focus.
        }
      });
    });

    const announce = document.querySelector<HTMLElement>('[data-announce]');
    /** Added to the page's announcement when it opens panel by panel. */
    let panelSuffix = '';
    if (announce && announcesOnOpen(navigation)) {
      const fill = () =>
        setTimeout(() => {
          const text = (view() === 'wide' ? announce.dataset.textWide : announce.dataset.text) ?? '';
          announce.textContent = panelSuffix ? `${text} ${panelSuffix}` : text;
        }, 500);
      if (document.readyState === 'complete') fill();
      else window.addEventListener('load', fill, { once: true });
    }

    // Panel by panel (docs/specs/comic-reader-panels.md AC-11 to AC-15): one page at a time, the
    // current panel enlarged in the page area. The choice is kept in the browser; the panel, in the
    // page's history entry; a turn to another page says where to open it.
    const PANELS_KEY = 'kb-panels';
    const ARRIVE_KEY = 'kb-panel-arrive';
    const toggle = document.querySelector<HTMLButtonElement>('[data-panels-toggle]');
    const sheet = document.querySelector<HTMLElement>('.reader__page.is-current[data-panels]');
    if (toggle && sheet) {
      const reader = document.querySelector<HTMLElement>('.reader')!;
      const img = sheet.querySelector<HTMLImageElement>('img')!;
      const mask = sheet.querySelector<HTMLElement>('.reader__panel-mask')!;
      const panels = JSON.parse(sheet.dataset.panels ?? '[]') as Panel[];
      const headings = [...document.querySelectorAll<HTMLElement>('.reader__location')];
      headings.forEach((h) => (h.dataset.base = h.textContent ?? ''));
      const where = (href: string) => {
        const u = new URL(href, location.href);
        return u.pathname + u.search;
      };
      const stored = (key: string, value?: string) => {
        try {
          if (value === undefined) return localStorage.getItem(key);
          if (value) localStorage.setItem(key, value);
          else localStorage.removeItem(key);
        } catch {
          // Remembering is a convenience only.
        }
        return null;
      };
      let on = false;
      let panel = 0;
      const offered = () => !(pairs && wideScreen.matches);
      const say = (text: string) => {
        if (announce) announce.textContent = text;
      };
      const place = () => {
        if (!on || !panels.length) {
          img.style.transform = '';
          mask.hidden = true;
          return;
        }
        const w = sheet.clientWidth;
        const h = sheet.clientHeight;
        const p = panels[panel];
        const f = panelFrame(p, w, h);
        img.style.transform = `translate(${f.x}px, ${f.y}px) scale(${f.scale})`;
        mask.hidden = false;
        Object.assign(mask.style, {
          left: `${(p.x / 100) * w * f.scale + f.x}px`,
          top: `${(p.y / 100) * h * f.scale + f.y}px`,
          width: `${(p.width / 100) * w * f.scale}px`,
          height: `${(p.height / 100) * h * f.scale}px`,
        });
      };
      const label = () => {
        const suffix = panels.length ? ` · panel ${panel + 1} of ${panels.length}` : ' · whole page';
        headings.forEach((h) => (h.textContent = on ? `${h.dataset.base}${suffix}` : (h.dataset.base ?? '')));
        // The controls' full names say whether they step to a panel or a page.
        for (const which of ['previous', 'next'] as const) {
          const within = on && panels.length > 0 && (which === 'next' ? panel + 1 < panels.length : panel > 0);
          document.querySelectorAll<HTMLAnchorElement>(`[data-control="${which}"]`).forEach((a) => {
            // A control with no page to go to still steps through this page's panels.
            if (!a.hasAttribute('href')) {
              a.classList.toggle('is-off', !within);
              if (within) a.removeAttribute('aria-disabled');
              else a.setAttribute('aria-disabled', 'true');
              a.tabIndex = within ? 0 : -1;
            }
            const word = which === 'next' ? 'Next' : 'Previous';
            const name = on ? `${word} ${within ? 'panel' : 'page'}` : (a.dataset.name ?? a.getAttribute('aria-label') ?? '');
            a.dataset.name ??= a.getAttribute('aria-label') ?? '';
            a.setAttribute('aria-label', name);
            const tip = a.querySelector('.reader__control-tip');
            if (tip) tip.textContent = name;
          });
        }
      };
      const show = () => {
        reader.classList.toggle('is-panels', on);
        toggle.setAttribute('aria-pressed', String(on));
        label();
        place();
        if (on) history.replaceState({ ...(history.state ?? {}), panel }, '');
      };
      const setOn = (value: boolean, announceIt: boolean) => {
        on = value && offered();
        stored(PANELS_KEY, value ? '1' : '');
        show();
        if (announceIt) say(on ? (panels.length ? panelsOn(panel, panels.length) : `Panel by panel. ${PANELS_OFF}.`) : PANELS_OFF);
      };
      toggle.addEventListener('click', () => setOn(!on, true));
      const update = () => {
        toggle.hidden = !offered();
        if (!offered() && on) {
          on = false;
          show();
        } else if (offered() && !on && stored(PANELS_KEY) === '1') {
          on = true;
          show();
        }
      };
      wideScreen.addEventListener('change', update);
      window.addEventListener('resize', place);
      img.addEventListener('load', place);

      // Where to open: the panel kept for this page (a refresh), or where a turn asked, or the first.
      let arrive: { to: string; at: 'first' | 'last' } | undefined;
      try {
        arrive = JSON.parse(sessionStorage.getItem(ARRIVE_KEY) ?? 'null') ?? undefined;
        sessionStorage.removeItem(ARRIVE_KEY);
      } catch {
        arrive = undefined;
      }
      const kept = (history.state as { panel?: number } | null)?.panel;
      if (typeof kept === 'number' && kept < panels.length) panel = kept;
      else if (arrive?.to === location.pathname + location.search && arrive.at === 'last') panel = Math.max(0, panels.length - 1);
      on = stored(PANELS_KEY) === '1' && offered();
      toggle.hidden = !offered();
      show();
      if (on) panelSuffix = panels.length ? panelAnnouncement(panel, panels.length) : '';

      const leave = (which: 'previous' | 'next') => {
        const target = link(which);
        if (!target) return;
        try {
          sessionStorage.setItem(ARRIVE_KEY, JSON.stringify({ to: where(target.href), at: which === 'next' ? 'first' : 'last' }));
        } catch {
          // Without storage, the page opens at its first panel.
        }
      };
      panelTurn = (which) => {
        if (!on) return false;
        const within = panels.length > 0 && (which === 'next' ? panel + 1 < panels.length : panel > 0);
        if (within) {
          panel += which === 'next' ? 1 : -1;
          show();
          say(panelAnnouncement(panel, panels.length));
          return true;
        }
        leave(which);
        return false;
      };
      document.querySelectorAll<HTMLAnchorElement>('a[data-control="previous"], a[data-control="next"]').forEach((a) => {
        const which = a.dataset.control as 'previous' | 'next';
        const step = (e: Event) => {
          if (!on) return;
          if (panelTurn?.(which)) e.preventDefault();
        };
        a.addEventListener('click', step);
        // A control without an address isn't activated by Enter on its own.
        a.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && !a.hasAttribute('href')) step(e);
        });
      });
    }

    // Share this page: the share menu on touch screens, otherwise copy; copy by hand if that fails.
    const shareBox = document.querySelector<HTMLElement>('[data-share]');
    const shareButton = document.querySelector<HTMLButtonElement>('[data-share-button]');
    if (shareBox && shareButton) {
      shareBox.hidden = false;
      const label = shareButton.querySelector<HTMLElement>('[data-share-label]')!;
      const status = shareBox.querySelector<HTMLElement>('[data-share-status]')!;
      const copyBox = shareBox.querySelector<HTMLElement>('[data-copy]')!;
      const url = shareButton.dataset.url!;
      let reset: ReturnType<typeof setTimeout> | undefined;
      const copied = () => {
        label.textContent = 'Link copied';
        status.textContent = 'Link copied';
        shareButton.classList.add('is-done');
        clearTimeout(reset);
        reset = setTimeout(() => {
          label.textContent = 'Share this page';
          status.textContent = '';
          shareButton.classList.remove('is-done');
        }, 4000);
      };
      shareButton.addEventListener('click', async () => {
        if (typeof navigator.share === 'function' && matchMedia('(pointer: coarse)').matches) {
          try {
            await navigator.share({ title: shareButton.dataset.title, url });
            return;
          } catch (error) {
            if ((error as DOMException | undefined)?.name === 'AbortError') return;
          }
        }
        try {
          await navigator.clipboard.writeText(url);
          copied();
        } catch {
          copyBox.hidden = false;
          const input = copyBox.querySelector('input')!;
          input.focus();
          input.select();
        }
      });
    }

    // Fetch the next pages' images after this one loads, unless the browser asks to save data: the
    // next page on a narrow screen, the next pair or spread on a wide one.
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    if (!saveData) {
      window.addEventListener('load', () => {
        document.querySelectorAll<HTMLMetaElement>(`meta[name="kb-next-image"][data-view="${view()}"]`).forEach((next) => {
          const img = new Image();
          img.sizes = view() === 'wide' ? '50vw' : '(max-width: 700px) 100vw, 900px';
          if (next.dataset.srcset) img.srcset = next.dataset.srcset;
          img.src = next.content;
        });
      });
    }

    // The page-flip (comic-reader-spread-and-flip AC-11): only a turn to the previous or next page
    // plays it, so save its direction for the next page, or skip it. History and other links don't.
    window.addEventListener('pageswap', (event) => {
      const e = event as Event & {
        viewTransition?: { skipTransition(): void };
        activation?: { navigationType?: string; entry?: { url?: string } };
      };
      if (!e.viewTransition) return;
      const url = e.activation?.entry?.url;
      const where = (href: string) => {
        const u = new URL(href);
        return u.pathname + u.search;
      };
      const hrefs = (selector: string) => [...document.querySelectorAll<HTMLAnchorElement>(selector)].map((a) => where(a.href));
      const dir =
        url && e.activation?.navigationType === 'push'
          ? turnDirection(where(url), {
              previous: hrefs('a[data-turn="previous"][href], a.reader__edge--prev'),
              next: hrefs('a[data-turn="next"][href], a.reader__edge--next'),
            })
          : undefined;
      if (!dir) {
        e.viewTransition.skipTransition();
        return;
      }
      try {
        sessionStorage.setItem('kb-flip', JSON.stringify({ to: where(url!), dir, at: Date.now() }));
      } catch {
        e.viewTransition.skipTransition();
      }
    });
  </script>
</BaseLayout>

<style>
  .reader {
    scroll-margin-top: 0;
    max-width: 960px;
    margin: 0 auto;
    padding: 0.5rem 0.5rem 2rem;
  }
  /* The page around the reader already has side padding; on a narrow phone, don't add more, so the
     controls' captions fit even with enlarged text. */
  @media (max-width: 480px) {
    .reader { padding-inline: 0; }
  }

  .reader__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.5rem 0.25rem;
  }
  .reader__back { font-family: 'Nunito', sans-serif; font-weight: 700; color: var(--color-ink); }
  .reader__all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.3rem 0.6rem;
    border: 2px solid var(--color-ink);
    background: var(--color-beige);
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
  }
  .reader__grid { display: inline-grid; grid-template-columns: repeat(3, 5px); gap: 2px; }
  .reader__grid i { display: block; width: 5px; height: 5px; background: var(--color-ink); }
  /* Phones: Back to series and All pages on the first line, the location line under them. */
  @media (max-width: 699px) {
    .reader__location { flex-basis: 100%; }
  }
  @media (min-width: 700px) {
    .reader__all { order: 3; }
    .reader__location { margin-right: auto; }
  }
  .reader__location {
    margin: 0;
    font-family: 'DM Mono', monospace;
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* The page reserves its space; the loading message sits behind the image until it paints. */
  .reader__page {
    position: relative;
    margin: 0 auto;
    width: 100%;
    /* Fits the window below the reader bar (with All pages) and above the controls, so on a
       360 × 640 phone both are on the first screen. */
    max-height: calc(100vh - 12.5rem);
    max-width: min(100%, calc((100vh - 12.5rem) * var(--page-ratio, 0.6667)));
    background: var(--color-paper-dark);
  }
  /* A spread on a narrow screen is shrunk to fit its width; sideways, it fills it, with the controls a
     short scroll below (comic-reader-spread-and-flip AC-8). */
  .reader__page.is-spread { max-height: none; max-width: 100%; }
  .reader__turn-hint {
    display: none;
    margin: 0.5rem 0 0;
    text-align: center;
    font-size: 0.9rem;
    color: var(--color-ink-light);
  }
  @media (orientation: portrait) {
    .reader__turn-hint { display: block; }
  }

  /* Each view's parts. The width test is WIDE_MEDIA in src/lib/comics/spreads.ts. */
  @media not ((min-width: 62.5em) and (orientation: landscape)) {
    .for-wide, .reader__page.is-other { display: none !important; }
  }
  @media (min-width: 62.5em) and (orientation: landscape) {
    .for-narrow { display: none !important; }
    .reader--pairs { max-width: 1400px; }
    /* Two pages of the same height meeting at the spine, a page alone on its own side, or a spread
       across both (comic-reader-spread-and-flip AC-7). */
    .reader--pairs .reader__book {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: minmax(0, 1fr);
      height: calc(100vh - 12.5rem);
    }
    .reader--pairs .reader__book .reader__page {
      height: 100%;
      width: auto;
      max-width: 100%;
      max-height: none;
      margin: 0;
    }
    .reader--pairs .reader__page[data-side='left'] { grid-column: 1; justify-self: end; view-transition-name: kb-left; }
    .reader--pairs .reader__page[data-side='right'] { grid-column: 2; justify-self: start; view-transition-name: kb-right; }
    .reader--pairs .reader__page[data-side='both'] { grid-column: 1 / -1; justify-self: center; view-transition-name: kb-spread; }
    .reader--pairs .reader__book[data-kind='pair']::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 48px;
      transform: translateX(-50%);
      background: linear-gradient(to right, transparent, rgba(43, 43, 43, 0.22) 50%, transparent);
      pointer-events: none;
    }
    .reader__turn-hint { display: none; }
    /* With two pages side by side off, a spread shows alone, as wide as the page area allows
       (comic-reader-comic-settings AC-3). */
    .reader:not(.reader--pairs) .reader__page.is-spread {
      max-height: calc(100vh - 12.5rem);
      max-width: min(100%, calc((100vh - 12.5rem) * var(--page-ratio, 1.3333)));
    }
  }

  /* Panel by panel (comic-reader-panels AC-11, AC-12, AC-14). */
  .reader__panels {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.3rem 0.6rem;
    border: 2px solid var(--color-ink);
    background: var(--color-beige);
    font: 700 1rem 'Nunito', sans-serif;
    color: var(--color-ink);
    cursor: pointer;
  }
  .reader__panels[hidden] { display: none; }
  .reader__panels[aria-pressed='true'] { background: var(--color-ink); color: var(--color-beige); }
  @media (max-width: 699px) {
    /* The location line keeps two lines, so the page doesn't move from panel to panel. */
    .reader--panelled .reader__location { min-height: 2.6em; }
  }
  @media (min-width: 700px) {
    .reader__panels { order: 2; }
  }
  .reader.is-panels .reader__page.is-current { overflow: hidden; background: var(--color-paper-dark); }
  .reader.is-panels .reader__page.is-current img { transform-origin: 0 0; transition: transform 0.3s ease; }
  .reader__panel-mask {
    position: absolute;
    z-index: 1;
    box-shadow: 0 0 0 200vmax var(--color-paper-dark);
    pointer-events: none;
    transition: all 0.3s ease;
  }
  .reader__panel-mask[hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .reader.is-panels .reader__page.is-current img, .reader__panel-mask { transition: none; }
  }

  .reader__loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    margin: 0;
    text-align: center;
    color: var(--color-ink-light);
  }
  /* The page that turns on a narrow screen (the wide view names its sides above). */
  @media not ((min-width: 62.5em) and (orientation: landscape)) {
    .reader__page.is-current { view-transition-name: kb-page; }
  }
  /* With two pages side by side off, every screen turns the single page (comic-reader-comic-settings AC-5). */
  .reader:not(.reader--pairs) .reader__page.is-current { view-transition-name: kb-page; }
  .reader__page img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .reader__edge {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    width: 15%;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: var(--color-ink);
    text-decoration: none;
    opacity: 0;
    transition: opacity var(--transition-fast);
  }
  .reader__edge--prev { left: 0; }
  .reader__edge--next { right: 0; }
  @media (hover: hover) and (min-width: 700px) {
    .reader__edge { display: flex; }
    .reader__edge:hover { opacity: 0.6; background: rgba(245, 241, 232, 0.4); }
  }

  .reader__controls-box {
    container-type: inline-size;
    max-width: 640px;
    margin: 1rem auto 0;
  }
  .reader__controls {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
  }
  /* When the captions don't fit on one row (enlarged text on a narrow phone), two by two:
     Previous and Next on top, First and Newest under them. */
  @container (max-width: 17rem) {
    .reader__controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .reader__control--previous { order: 1; }
    .reader__control--next { order: 2; }
    .reader__control--first { order: 3; }
    .reader__control--newest { order: 4; }
  }
  .reader__control {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 56px;
    padding: 0.25rem 0;
    border: 3px solid var(--color-ink);
    background: var(--color-beige);
    color: var(--color-ink);
    text-decoration: none;
  }
  .reader__control svg { height: 24px; flex: none; }
  .reader__control-caption {
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 0.8rem;
    line-height: 1.1;
    text-align: center;
  }
  /* A control that can't be used keeps its place, dashed and faded. */
  .reader__control.is-off {
    border-style: dashed;
    border-color: rgba(43, 43, 43, 0.4);
    color: rgba(43, 43, 43, 0.45);
  }
  /* The full name, above the control, on hover and keyboard focus. */
  .reader__control-tip {
    display: none;
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    padding: 0.25rem 0.5rem;
    background: var(--color-ink);
    color: var(--color-beige);
    font-family: 'Nunito', sans-serif;
    font-weight: 600;
    font-size: 0.8rem;
    white-space: nowrap;
    pointer-events: none;
  }
  .reader__control--first .reader__control-tip { left: 0; transform: none; }
  .reader__control--newest .reader__control-tip { left: auto; right: 0; transform: none; }
  .reader__control:hover .reader__control-tip,
  .reader__control:focus-visible .reader__control-tip { display: block; }

  .reader__share {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    max-width: 640px;
    margin: 1rem auto 0;
  }
  .reader__share[hidden], .reader__copy[hidden] { display: none; }
  .reader__share-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.4rem 1rem;
    border: 2px solid var(--color-ink);
    background: transparent;
    color: var(--color-ink);
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
  }
  .reader__share-button.is-done { background: var(--color-paper-dark); }
  .reader__copy { width: 100%; margin: 0; font-family: 'Nunito', sans-serif; font-weight: 600; }
  .reader__copy label { display: block; margin-bottom: 0.25rem; }
  .reader__copy input {
    width: 100%;
    min-height: 44px;
    padding: 0.4rem;
    border: 2px solid var(--color-ink);
    background: #fff;
    font-family: 'DM Mono', monospace;
    font-size: 0.85rem;
  }
  .reader__end { max-width: 640px; margin: 0.75rem auto 0; text-align: center; }
  .reader__end p { margin: 0 0 0.25rem; }
  .reader__end-heading { font-family: 'Nunito', sans-serif; font-weight: 700; }

  @media (prefers-reduced-motion: reduce) {
    .reader__edge { transition: none; }
  }
</style>

<style is:global>
  /* The page-flip (docs/design/comic-spread-and-flip.md, "The page-flip"; comic-reader-spread-and-flip
     AC-11): reader pages opt in to cross-document view transitions, unless reduced motion is asked
     for. The page each turn leaves decides whether it plays and which way (the scripts in
     ReaderPage.astro); everything but the turning pages changes at once. 0.4 s in all. */
  ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
  ::view-transition-group(*) { animation-duration: 0.4s; }
  ::view-transition-image-pair(*) { perspective: 2400px; }
  ::view-transition-old(*), ::view-transition-new(*) { animation: none; }

  /* Forward: the right-hand page turns over to the left around the spine, its back becoming the new
     left-hand page; a spread turns as one sheet; a narrow page lifts off around its left edge. */
  html:active-view-transition-type(forward)::view-transition-old(kb-right) {
    z-index: 1; transform-origin: left center; animation: kb-out-to-left 0.4s ease-in both;
  }
  html:active-view-transition-type(forward)::view-transition-new(kb-left) {
    transform-origin: right center; animation: kb-in-from-right 0.4s ease-out both;
  }
  html:active-view-transition-type(forward)::view-transition-old(kb-left) { animation: kb-hold 0.4s both; }
  html:active-view-transition-type(forward)::view-transition-old(kb-spread) {
    z-index: 1; transform-origin: center; animation: kb-out-to-left 0.4s ease-in both;
  }
  html:active-view-transition-type(forward)::view-transition-new(kb-spread) {
    transform-origin: center; animation: kb-in-from-right 0.4s ease-out both;
  }
  html:active-view-transition-type(forward)::view-transition-old(kb-page) {
    z-index: 1; transform-origin: left center; animation: kb-lift-left 0.4s ease-in both;
  }

  /* Back: the reverse. */
  html:active-view-transition-type(back)::view-transition-old(kb-left) {
    z-index: 1; transform-origin: right center; animation: kb-out-to-right 0.4s ease-in both;
  }
  html:active-view-transition-type(back)::view-transition-new(kb-right) {
    transform-origin: left center; animation: kb-in-from-left 0.4s ease-out both;
  }
  html:active-view-transition-type(back)::view-transition-old(kb-right) { animation: kb-hold 0.4s both; }
  html:active-view-transition-type(back)::view-transition-old(kb-spread) {
    z-index: 1; transform-origin: center; animation: kb-out-to-right 0.4s ease-in both;
  }
  html:active-view-transition-type(back)::view-transition-new(kb-spread) {
    transform-origin: center; animation: kb-in-from-left 0.4s ease-out both;
  }
  html:active-view-transition-type(back)::view-transition-new(kb-page) {
    transform-origin: left center; animation: kb-lay-down 0.4s ease-out both;
  }
  html:active-view-transition-type(back)::view-transition-old(kb-page) { animation: kb-hold 0.4s both; }

  @keyframes kb-out-to-left { 0% { transform: rotateY(0); } 50%, 100% { transform: rotateY(-90deg); } }
  @keyframes kb-in-from-right { 0%, 50% { transform: rotateY(90deg); } 100% { transform: rotateY(0); } }
  @keyframes kb-out-to-right { 0% { transform: rotateY(0); } 50%, 100% { transform: rotateY(90deg); } }
  @keyframes kb-in-from-left { 0%, 50% { transform: rotateY(-90deg); } 100% { transform: rotateY(0); } }
  @keyframes kb-lift-left { from { transform: rotateY(0); } to { transform: rotateY(-90deg); } }
  @keyframes kb-lay-down { from { transform: rotateY(-90deg); } to { transform: rotateY(0); } }
  @keyframes kb-hold { from, to { opacity: 1; } }
</style>
