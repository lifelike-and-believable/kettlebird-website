---
// Reader page (rendered by src/pages/comics/[slug]/[chapter]/[page].astro and the preview route): one comic page, with Back to series, All pages, the location line, and the
// player-style controls. Designs: docs/design/comic-start-reading.md, docs/design/comic-turn-pages.md,
// docs/design/comic-sheet-and-controls.md (which replaces the Previous page / Next page pair).
// Specs: docs/specs/comic-reader-start-and-turn.md, docs/specs/comic-reader-sheet-and-controls.md.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../Arrow.astro';
import type { ArrowKind } from '../../lib/arrows';
import type { PreviewInfo } from '../../lib/preview/load';
import {
  endNote,
  locationLine,
  pageAltText,
  readerPages,
  seriesPath,
  tabTitle,
  type ReaderPage,
} from '../../lib/comics/model';
import { allPagesHref, playControls, type ControlKind, type PlayControl } from '../../lib/comics/navigation';
import { pageAnnouncement, pagePreview, shareTitle } from '../../lib/comics/sharing';
import { readsAs, wideView, type WideView } from '../../lib/comics/spreads';
import { previewTurn } from '../../lib/preview/turns';
import { offersPanels, pagePanels, readerSizes } from '../../lib/comics/panels';
import { chapterColumn, pageCap, PAGE_SIZE_KEY } from '../../lib/comics/page-size';


const { entry, nextImage, preview: inPreview = false, previewUrl } = Astro.props as {
  entry: ReaderPage;
  nextImage?: ReaderPage['page']['image'];
  /** In the preview: don't scroll (it would scroll the editor around the preview) or fetch the next page. */
  preview?: boolean;
  /** In a chapter's preview, its address: turns move within the chapter there (comic-reader-comic-settings AC-9). */
  previewUrl?: string;
};
const back = seriesPath(entry.series.slug!);
// Two-page spreads (docs/design/comic-spread-and-flip.md, docs/specs/comic-reader-spread-and-flip.md):
// the page carries its narrow view (this page) and its wide view (its group), and the width test in
// the styles below shows one. The script picks the same one with WIDE_MEDIA.
// How it reads (docs/specs/comic-reader-comic-settings.md): with pairs off, one view only, the narrow
// one, on every screen; with the flip off, the page doesn't opt in to the page-flip.
const reads = readsAs(entry.series);
const single: WideView = {
  kind: 'right',
  pages: [entry],
  previousPath: entry.previousPath,
  nextPath: entry.nextPath,
  isLast: entry.isLast,
  location: locationLine(entry),
  announcement: pageAnnouncement(entry),
  controls: playControls(entry),
};
const wide = reads.twoUp ? wideView(entry) : single;
const end = wide.isLast ? endNote(entry.series.status) : undefined;
// In a chapter's preview, a turn within the chapter goes to the preview's own address; anything
// else stays inactive, as every preview link is (AC-9).
const turnHref = (to?: string) => (previewUrl && to ? previewTurn(new URL(previewUrl), entry, to) : to);
const turnAttrs = (to?: string) => (previewUrl && turnHref(to) ? { 'data-preview-turn': '' } : {});
/** Shown on both views, or on one: a class that hides it on the other. */
const only = (narrow: boolean, onWide: boolean) => (narrow && onWide ? '' : narrow ? 'for-narrow' : 'for-wide');
const controls = playControls(entry);
// The wide set first: tools that look for a control by its visible word, like the tutorial runner,
// take the first match, and a laptop shows the wide set. Hidden sets are out of the Tab order and
// the accessibility tree, so the order changes nothing for readers.
const views: { view: 'narrow' | 'wide'; controls: PlayControl[] }[] = reads.twoUp
  ? [{ view: 'wide', controls: wide.controls }, { view: 'narrow', controls }]
  : [{ view: 'narrow', controls }];
const sides = wide.kind === 'pair' ? ['left', 'right'] : [wide.kind === 'spread' ? 'both' : wide.kind];
const nextWide = reads.twoUp && wide.nextPath ? readerPages(entry.series).find((e) => e.path === wide.nextPath) : undefined;
const nextWideImages = nextWide && !inPreview ? wideView(nextWide).pages.map((p) => p.page.image) : [];
const allPages = allPagesHref(entry);
// Panel by panel (docs/specs/comic-reader-panels.md): offered in chapters with panels, shown by the script.
const panelled = offersPanels(entry);
const panels = pagePanels(entry.page);
const preview = { ...pagePreview(entry, Astro.site!.href), type: 'article' };
// How pages fit on a computer (docs/design/comic-page-width.md, docs/specs/comic-reader-page-size.md): the comic's
// size, each page's largest width, and the chapter's column; a fan's own choice is applied before the page shows.
const comicSize = entry.series.pageSize ?? 'screen';
const largest = entry.series.largestPageWidth;
const capOf = (p: ReaderPage) => pageCap(p.page.image, Boolean(p.page.spread), largest);
const singles = entry.chapter.pages.filter((p) => !p.spread);
const column = chapterColumn(entry.chapter.pages, largest) || 600;
const widest = singles.find((p) => pageCap(p.image, false, largest) === column)?.image ?? entry.page.image;
const SIZE_NAMES = { screen: 'Fit the screen', width: 'Fit the width', height: 'Fit the height' } as const;
const SIZE_NOTES = {
  screen: 'The whole page and the buttons at once. For every comic',
  width: "As wide as the page's picture, or the window if narrower. For every comic",
  height: 'As tall as the window. For every comic',
} as const;
const nextCap = nextImage ? (entry.nextPath ? pageCap(nextImage, Boolean(readerPages(entry.series).find((e) => e.path === entry.nextPath)?.page.spread), largest) : 0) : 0;
// The site's drawn arrows (docs/design/arrows.md): phones draw typed characters as emoji of their own.
const ARROW_FOR: Record<ControlKind, ArrowKind> = { first: 'first', previous: 'previous', next: 'next', newest: 'last' };
const TURNS: Partial<Record<ControlKind, string>> = { previous: 'previous', next: 'next' };
/** In the preview route: what the preview shows and outlines (docs/specs/content-editing-preview.md). */
const previewInfo = (Astro.props as { previewInfo?: PreviewInfo }).previewInfo;
---

<BaseLayout
  previewInfo={previewInfo}
  title={tabTitle(entry)}
  description={`${entry.series.title}, a comic by Star Goldberg.`}
  canonical={preview.url}
  preview={preview}
>
  <!-- Don't draw the page until the scroll below has run, so the site header never flashes on a
       turn, even when the page arrives in pieces. Browsers without render-blocking ignore it. -->
  {!inPreview && <link slot="head" rel="expect" href="#reader-scrolled" {...{ blocking: 'render' }} />}
  {panelled && (
    <script is:inline slot="head">
      // Panel by panel shows one page at a time on every screen (docs/specs/comic-reader-panels-two-up.md
      // AC-4): marked here, before the first frame, so a pair never shows first and the page-flip turns
      // one page.
      try {
        if (localStorage.getItem('kb-panels') === '1') document.documentElement.classList.add('kb-one-page');
      } catch (_) {}
    </script>
  )}
  <script is:inline slot="head" define:vars={{ comicSize, key: PAGE_SIZE_KEY, own: !inPreview }}>
    // How pages fit on a computer (comic-reader-page-size AC-19): the fan's own choice, else the comic's, marked
    // before the first frame so a page never changes size after it shows. The styles apply it on computers only.
    var size = comicSize;
    var mine = null;
    if (own) {
      try {
        mine = localStorage.getItem(key);
      } catch (_) {}
    }
    if (mine === 'screen' || mine === 'width' || mine === 'height') size = mine;
    else mine = null;
    var root = document.documentElement;
    if (size !== 'screen') root.classList.add('kb-fit-' + size);
    if (mine) root.dataset.kbOwnSize = mine;
  </script>
  {reads.pageFlip && (
    <style is:inline slot="head">
      /* This comic turns its pages with the page-flip (comic-reader-comic-settings AC-5). */
      @media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }
    </style>
  )}
  {reads.pageFlip && (
    <script is:inline slot="head">
      // The page-flip (docs/specs/comic-reader-spread-and-flip.md AC-11): a turn arrives with its
      // direction, saved by the page it left. Anything else, or a picture that isn't ready, changes
      // the page without it. In the head, so it runs before the first frame.
      addEventListener('pagereveal', function (e) {
        var vt = e.viewTransition;
        if (!vt) return;
        var flip = null;
        try {
          flip = JSON.parse(sessionStorage.getItem('kb-flip') || 'null');
          sessionStorage.removeItem('kb-flip');
        } catch (_) {}
        var ready = Array.prototype.every.call(document.querySelectorAll('.reader__page img'), function (img) {
          return img.offsetParent === null || img.complete;
        });
        if (!flip || flip.to !== location.pathname + location.search || Date.now() - flip.at > 5000 || !ready || !vt.types) {
          vt.skipTransition();
          return;
        }
        vt.types.add(flip.dir);
      });
    </script>
  )}
  <div
    class:list={['reader', { 'reader--pairs': reads.twoUp, 'reader--panelled': panelled }]}
    data-pairs={reads.twoUp ? '' : undefined}
    data-page-size={comicSize}
    data-largest={largest}
    style={`--kb-col: ${column}px; --kb-ratio: ${(widest.width / widest.height).toFixed(4)};`}
  >
    <div class="reader__bar">
      <a href={back} class="reader__back">Back to series</a>
      {(panelled || allPages) && (
        <!-- On phones, the two show their pictures only, together at the right; their words stay for
             assistive technology, and the name shows under each on hover and focus
             (docs/design/comic-reader-phone-bar.md, docs/specs/comic-reader-phone-bar.md). -->
        <div class="reader__tools">
          <!-- A fan's page size, on computers (comic-reader-page-size AC-15 to AC-20): shown by the script. -->
          <div class="reader__size" data-page-size-control hidden>
            <button type="button" class="reader__size-button" aria-label="Page size" aria-haspopup="menu" aria-expanded="false" aria-controls="kb-size-menu">
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
                <rect x="7" y="6" width="10" height="12" fill="none" stroke="currentColor" stroke-width="2" />
                <path d="M2 6V2h4M2 2l4 4M22 6V2h-4M22 2l-4 4M2 18v4h4M2 22l4-4M22 18v4h-4M22 22l-4-4" fill="none" stroke="currentColor" stroke-width="1.75" />
              </svg>
              <span class="reader__size-tip" aria-hidden="true">Page size</span>
            </button>
            <div class="reader__size-menu" id="kb-size-menu" role="menu" aria-label="Page size on this computer" hidden>
              {(['comic', 'screen', 'width', 'height'] as const).map((value) => {
                const shape = value === 'comic' ? comicSize : value;
                return (
                  <>
                    <button type="button" role="menuitemradio" aria-checked={value === 'comic' ? 'true' : 'false'} tabindex="-1" data-size={value}>
                      <span class="reader__size-tick" aria-hidden="true"></span>
                      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                        {shape === 'screen' && <><rect x="7" y="5" width="10" height="14" fill="none" stroke="currentColor" stroke-width="2" /><path d="M2 7V2h5M22 7V2h-5M2 17v5h5M22 17v5h-5" fill="none" stroke="currentColor" stroke-width="2" /></>}
                        {shape === 'width' && <><rect x="5" y="2" width="14" height="20" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".45" /><path d="M2 12h20M2 12l4-4M2 12l4 4M22 12l-4-4M22 12l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></>}
                        {shape === 'height' && <><rect x="5" y="2" width="14" height="20" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".45" /><path d="M12 2v20M12 2l-4 4M12 2l4 4M12 22l-4-4M12 22l4-4" fill="none" stroke="currentColor" stroke-width="2" /></>}
                      </svg>
                      <span class="reader__size-words">
                        {value === 'comic' ? `Comic's choice: ${SIZE_NAMES[comicSize]}` : SIZE_NAMES[value]}
                        <small>{value === 'comic' ? "Follows this comic's setting" : SIZE_NOTES[value]}</small>
                      </span>
                    </button>
                    {value === 'comic' && <span class="reader__size-rule" role="none"></span>}
                  </>
                );
              })}
              <span class="reader__size-rule" role="none"></span>
              <span class="reader__size-note" role="none" data-size-note data-panels-text="Panel by panel always fits the screen. Your choice applies when it's off.">Kept on this computer.</span>
            </div>
          </div>
          {panelled && (
            <button type="button" class="reader__panels reader__tool" data-panels-toggle aria-pressed="false" hidden>
              <!-- A page of panels, the one being read drawn heavier. Interim, until Star draws it. -->
              <svg viewBox="0 0 16 22" width="14" height="20" aria-hidden="true" focusable="false">
                <rect x="1" y="1" width="14" height="20" fill="none" stroke="currentColor" stroke-width="1.5" />
                <rect x="3.25" y="3.25" width="9.5" height="6.5" fill="none" stroke="currentColor" stroke-width="2.5" />
                <rect x="3" y="12" width="4" height="7" fill="none" stroke="currentColor" stroke-width="1.25" />
                <rect x="9" y="12" width="4" height="7" fill="none" stroke="currentColor" stroke-width="1.25" />
              </svg>
              <span class="reader__tool-word">Panel by panel</span>
              <span class="reader__tool-tip" aria-hidden="true">Panel by panel</span>
            </button>
          )}
          {allPages && (
            <a href={allPages} class="reader__all reader__tool" aria-label="All pages in this chapter">
              <span class="reader__grid" aria-hidden="true">{Array.from({ length: 9 }, () => <i></i>)}</span>
              <span class="reader__tool-word">All pages</span>
              <span class="reader__tool-tip" aria-hidden="true">All pages in this chapter</span>
            </a>
          )}
        </div>
      )}
      {locationLine(entry) === wide.location ? (
        <h1 class="reader__location" data-part="reader-location">{wide.location}</h1>
      ) : (
        <>
          <h1 class="reader__location for-narrow" data-part="reader-location">{locationLine(entry)}</h1>
          <h1 class="reader__location for-wide" data-part="reader-location">{wide.location}</h1>
        </>
      )}
    </div>

    <div class="reader__book" data-reader-page data-part="reader-page" data-kind={wide.kind}>
      {wide.pages.map((p, i) => {
        const current = p.path === entry.path;
        const img = p.page.image;
        const first = i === 0;
        const last = i === wide.pages.length - 1;
        return (
          <div
            class:list={['reader__page', current ? 'is-current' : 'is-other', { 'is-spread': p.page.spread }]}
            data-panels={current && panelled ? JSON.stringify(panels) : undefined}
            data-side={sides[i]}
            data-cap={capOf(p)}
            style={`aspect-ratio: ${img.width} / ${img.height}; --page-ratio: ${(img.width / img.height).toFixed(4)}; --kb-cap: ${capOf(p)}px;`}
          >
            <p class="reader__loading">Loading page… If it doesn't appear, try refreshing.</p>
            {current && panelled && <span class="reader__panel-mask" aria-hidden="true"></span>}
            <img
              src={img.src}
              srcset={img.srcset}
              sizes={readerSizes(img, Boolean(p.page.spread), panelled, { size: comicSize, cap: capOf(p) })}
              width={img.width}
              height={img.height}
              alt={pageAltText(p)}
              decoding="async"
              loading={current ? undefined : 'lazy'}
            />
            {current && entry.previousPath && (
              <a href={turnHref(entry.previousPath)} {...turnAttrs(entry.previousPath)} class:list={['reader__edge reader__edge--prev', { 'for-narrow': reads.twoUp }]} aria-hidden="true" tabindex="-1"><span class="arrow-btn"><Arrow kind="previous" /></span></a>
            )}
            {current && entry.nextPath && (
              <a href={turnHref(entry.nextPath)} {...turnAttrs(entry.nextPath)} class:list={['reader__edge reader__edge--next', { 'for-narrow': reads.twoUp }]} aria-hidden="true" tabindex="-1"><span class="arrow-btn"><Arrow kind="next" /></span></a>
            )}
            {reads.twoUp && first && wide.previousPath && (
              <a href={turnHref(wide.previousPath)} {...turnAttrs(wide.previousPath)} class="reader__edge reader__edge--prev for-wide" aria-hidden="true" tabindex="-1"><span class="arrow-btn"><Arrow kind="previous" /></span></a>
            )}
            {reads.twoUp && last && wide.nextPath && (
              <a href={turnHref(wide.nextPath)} {...turnAttrs(wide.nextPath)} class="reader__edge reader__edge--next for-wide" aria-hidden="true" tabindex="-1"><span class="arrow-btn"><Arrow kind="next" /></span></a>
            )}
          </div>
        );
      })}
    </div>
    {entry.page.spread && <p class="reader__turn-hint" aria-hidden="true">Turn your phone sideways to see it bigger.</p>}

    {views.map(({ view, controls: set }) => set.length > 0 && (
      <div class:list={['reader__controls-box', { [`for-${view}`]: reads.twoUp }]} data-view={view}>
        <nav class="reader__controls" aria-label="Page navigation">
          {set.map((c) => {
            const body = (
              <>
                <Arrow kind={ARROW_FOR[c.kind]} />
                <span class="reader__control-caption">{c.caption}</span>
                <span class="reader__control-tip" aria-hidden="true">{c.name}</span>
              </>
            );
            return c.path ? (
              <a
                href={TURNS[c.kind] ? turnHref(c.path) : c.path}
                {...(TURNS[c.kind] ? turnAttrs(c.path) : {})}
                class={`arrow-btn reader__control reader__control--${c.kind}`}
                aria-label={c.name}
                rel={c.kind === 'previous' ? 'prev' : c.kind === 'next' ? 'next' : undefined}
                data-turn={TURNS[c.kind]}
                data-control={c.kind}
              >{body}</a>
            ) : (
              <a
                role="link"
                aria-disabled="true"
                aria-label={c.name}
                tabindex="-1"
                data-control={c.kind}
                class={`arrow-btn reader__control reader__control--${c.kind} is-off`}
              >{body}</a>
            );
          })}
        </nav>
      </div>
    ))}
    {end && (
      <div class:list={['reader__end', only(entry.isLast, wide.isLast)]}>
        <p class="reader__end-heading">{end.heading}</p>
        <p>{end.line}</p>
        <a href={back}>Back to series</a>
      </div>
    )}

    <!-- Share this page (design-comic-share-and-announce): needs a script, so it's shown by one. -->
    <div class="reader__share" data-share hidden>
      <button type="button" class="reader__share-button" data-share-button data-url={preview.url} data-title={shareTitle(entry)}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <circle cx="18" cy="5" r="3" fill="currentColor" /><circle cx="6" cy="12" r="3" fill="currentColor" /><circle cx="18" cy="19" r="3" fill="currentColor" />
          <path d="M8.6 10.7 L15.4 6.4 M8.6 13.3 L15.4 17.6" stroke="currentColor" stroke-width="2" />
        </svg>
        <span data-share-label>Share this page</span>
      </button>
      <p class="visually-hidden" role="status" data-share-status></p>
      <p class="reader__copy" data-copy hidden>
        <label for="copy-link">Copy this link:</label>
        <input id="copy-link" type="text" readonly value={preview.url} />
      </p>
    </div>
    <!-- What a screen reader hears when the page opens; filled in by the script below. -->
    <p class="visually-hidden" role="status" data-announce data-text={pageAnnouncement(entry)} data-text-wide={wide.announcement}></p>
  </div>

  {!inPreview && (
    <>
  <script is:inline>
    // Open with the reader bar at the top of the window, past the site header, so the whole page
    // shows and the next page appears without scrolling back up (design-comic-turn-pages). Inline,
    // right after the reader, and the page isn't drawn until the marker after it is parsed (the
    // render-blocking link above): otherwise the header can flash on screen at a turn. Skipped if
    // the fan has already scrolled; without a script the page simply starts at the top.
    if (window.scrollY === 0) document.querySelector('.reader')?.scrollIntoView({ block: 'start' });
  </script>
  <span id="reader-scrolled" hidden></span>
    </>
  )}

  {nextImage && !inPreview && <meta name="kb-next-image" content={nextImage.src} data-srcset={nextImage.srcset ?? ''} data-view="narrow" data-width={nextImage.width} data-height={nextImage.height} data-cap={nextCap} />}
  {nextWideImages.map((img) => <meta name="kb-next-image" content={img.src} data-srcset={img.srcset ?? ''} data-view="wide" data-width={img.width} data-height={img.height} data-cap={pageCap(img, img.width > img.height, largest)} />)}

  <script>
    import { announcesOnOpen, focusAfterTurn, type NavigationKind, type RememberedTurn } from '../../lib/comics/sharing';
    import { turnDirection, WIDE_MEDIA } from '../../lib/comics/spreads';
    import { panelAnnouncement, panelFrame, panelsOffAnnouncement, panelsOn, PANELS_OFF, readerSizes, type Panel } from '../../lib/comics/panels';
    import { PAGE_SIZE_KEY, type PageSize } from '../../lib/comics/page-size';

    // Two pages side by side when the width test matches (comic-reader-spread-and-flip AC-3); the
    // styles use the same test, so this picks the links that show.
    const wideScreen = matchMedia(WIDE_MEDIA);
    // A comic with two pages side by side off has only the narrow set (comic-reader-comic-settings AC-2).
    const pairs = document.querySelector('.reader')?.hasAttribute('data-pairs') ?? false;
    // Panel by panel shows one page at a time on every screen (comic-reader-panels-two-up): the page is
    // marked, and the one-page view's links, controls and announcements are the ones that count.
    const onePage = () => document.documentElement.classList.contains('kb-one-page');
    const view = () => (pairs && wideScreen.matches && !onePage() ? 'wide' : 'narrow');

    // Arrow keys and swipes follow the same links as Previous page and Next page
    // (design-comic-turn-pages, "How a page turn works"). Reading never needs this script.
    const link = (which: 'previous' | 'next') =>
      document.querySelector<HTMLAnchorElement>(`[data-view="${view()}"] [data-turn="${which}"]`);
    const zoomed = () => (window.visualViewport?.scale ?? 1) > 1.01;
    /** Set by panel by panel: takes a turn itself (true), or lets the page turn (false). */
    let panelTurn: ((which: 'previous' | 'next') => boolean) | undefined;
    const turnTo = (which: 'previous' | 'next') => {
      if (panelTurn?.(which)) return;
      const target = link(which);
      if (target) location.assign(target.href);
    };

    /** Set by Page size: its menu is open, and the arrow keys are its own (comic-reader-page-size AC-17). */
    let sizeMenuOpen = () => false;
    document.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey || zoomed() || sizeMenuOpen()) return;
      const t = e.target as HTMLElement | null;
      if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
      const which = e.key === 'ArrowRight' ? 'next' : e.key === 'ArrowLeft' ? 'previous' : null;
      if (which && (link(which) || panelTurn)) {
        e.preventDefault();
        turnTo(which); // not a click: arrow keys don't move focus (design-comic-share-and-announce)
      }
    });

    const area = document.querySelector<HTMLElement>('[data-reader-page]');
    let start: { x: number; y: number } | null = null;
    area?.addEventListener('pointerdown', (e) => {
      start = e.pointerType === 'touch' && !zoomed() ? { x: e.clientX, y: e.clientY } : null;
    });
    area?.addEventListener('pointerup', (e) => {
      if (!start || e.pointerType !== 'touch') return;
      const dx = e.clientX - start.x;
      const dy = e.clientY - start.y;
      start = null;
      // A turn needs a clearly horizontal swipe; mostly vertical movement is scrolling.
      if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5 || zoomed()) return;
      turnTo(dx < 0 ? 'next' : 'previous');
    });

    // After a turn with a control, focus that control on the new page; announce each page as it
    // opens, except on a reload (design-comic-share-and-announce, Accessibility).
    const TURN_KEY = 'kb-turn';
    const navigation = ((performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type ??
      'navigate') as NavigationKind;
    let remembered: RememberedTurn | undefined;
    try {
      remembered = JSON.parse(sessionStorage.getItem(TURN_KEY) ?? 'null') ?? undefined;
      sessionStorage.removeItem(TURN_KEY);
    } catch {
      remembered = undefined;
    }
    let referrerPath: string | undefined;
    try {
      const from = new URL(document.referrer);
      referrerPath = from.origin === location.origin ? from.pathname : undefined;
    } catch {
      referrerPath = undefined;
    }
    const kind = focusAfterTurn(remembered, { navigation, referrerPath, time: Date.now() });
    if (kind) document.querySelector<HTMLElement>(`[data-view="${view()}"] [data-control="${kind}"]`)?.focus({ preventScroll: true });

    document.querySelectorAll<HTMLAnchorElement>('a[data-control][href]').forEach((control) => {
      control.addEventListener('click', () => {
        const turn: RememberedTurn = { kind: control.dataset.control as RememberedTurn['kind'], from: location.pathname, at: Date.now() };
        try {
          sessionStorage.setItem(TURN_KEY, JSON.stringify(turn));
        } catch {
          // Storage refused: the turn still happens, without keeping focus.
        }
      });
    });

    const announce = document.querySelector<HTMLElement>('[data-announce]');
    /** Added to the page's announcement when it opens panel by panel. */
    let panelSuffix = '';
    /** Set when something else has been said since the page opened, so the page's own line doesn't replace it. */
    let spoken = false;
    if (announce && announcesOnOpen(navigation)) {
      const fill = () =>
        setTimeout(() => {
          if (spoken) return;
          const text = (view() === 'wide' ? announce.dataset.textWide : announce.dataset.text) ?? '';
          announce.textContent = panelSuffix ? `${text} ${panelSuffix}` : text;
        }, 500);
      if (document.readyState === 'complete') fill();
      else window.addEventListener('load', fill, { once: true });
    }

    // Panel by panel (docs/specs/comic-reader-panels.md AC-11 to AC-15; with two pages side by side,
    // comic-reader-panels-two-up): one page at a time on every screen, the current panel enlarged in
    // the page area. The choice is kept in the browser; the panel, in the
    // page's history entry; a turn to another page says where to open it.
    const PANELS_KEY = 'kb-panels';
    const ARRIVE_KEY = 'kb-panel-arrive';
    const toggle = document.querySelector<HTMLButtonElement>('[data-panels-toggle]');
    const sheet = document.querySelector<HTMLElement>('.reader__page.is-current[data-panels]');
    if (toggle && sheet) {
      const reader = document.querySelector<HTMLElement>('.reader')!;
      const img = sheet.querySelector<HTMLImageElement>('img')!;
      const mask = sheet.querySelector<HTMLElement>('.reader__panel-mask')!;
      const panels = JSON.parse(sheet.dataset.panels ?? '[]') as Panel[];
      const headings = [...document.querySelectorAll<HTMLElement>('.reader__location')];
      headings.forEach((h) => (h.dataset.base = h.textContent ?? ''));
      const where = (href: string) => {
        const u = new URL(href, location.href);
        return u.pathname + u.search;
      };
      const stored = (key: string, value?: string) => {
        try {
          if (value === undefined) return localStorage.getItem(key);
          if (value) localStorage.setItem(key, value);
          else localStorage.removeItem(key);
        } catch {
          // Remembering is a convenience only.
        }
        return null;
      };
      let on = false;
      let panel = 0;
      const book = document.querySelector<HTMLElement>('[data-reader-page]');
      const say = (text: string) => {
        if (announce) announce.textContent = text;
      };
      const place = () => {
        if (!on || !panels.length) {
          img.style.transform = '';
          mask.hidden = true;
          return;
        }
        const w = sheet.clientWidth;
        const h = sheet.clientHeight;
        const p = panels[panel];
        const f = panelFrame(p, w, h);
        img.style.transform = `translate(${f.x}px, ${f.y}px) scale(${f.scale})`;
        mask.hidden = false;
        Object.assign(mask.style, {
          left: `${(p.x / 100) * w * f.scale + f.x}px`,
          top: `${(p.y / 100) * h * f.scale + f.y}px`,
          width: `${(p.width / 100) * w * f.scale}px`,
          height: `${(p.height / 100) * h * f.scale}px`,
        });
      };
      const label = () => {
        const suffix = panels.length ? ` · panel ${panel + 1} of ${panels.length}` : ' · whole page';
        headings.forEach((h) => (h.textContent = on ? `${h.dataset.base}${suffix}` : (h.dataset.base ?? '')));
        // The controls' full names say whether they step to a panel or a page.
        for (const which of ['previous', 'next'] as const) {
          const within = on && panels.length > 0 && (which === 'next' ? panel + 1 < panels.length : panel > 0);
          document.querySelectorAll<HTMLAnchorElement>(`[data-control="${which}"]`).forEach((a) => {
            // A control with no page to go to still steps through this page's panels.
            if (!a.hasAttribute('href')) {
              a.classList.toggle('is-off', !within);
              if (within) a.removeAttribute('aria-disabled');
              else a.setAttribute('aria-disabled', 'true');
              a.tabIndex = within ? 0 : -1;
            }
            const word = which === 'next' ? 'Next' : 'Previous';
            const name = on ? `${word} ${within ? 'panel' : 'page'}` : (a.dataset.name ?? a.getAttribute('aria-label') ?? '');
            a.dataset.name ??= a.getAttribute('aria-label') ?? '';
            a.setAttribute('aria-label', name);
            const tip = a.querySelector('.reader__control-tip');
            if (tip) tip.textContent = name;
          });
        }
      };
      const show = () => {
        // Instant: the styles show the one-page view or the pair, with no transition between them.
        document.documentElement.classList.toggle('kb-one-page', on);
        reader.classList.toggle('is-panels', on);
        toggle.setAttribute('aria-pressed', String(on));
        label();
        place();
        if (on) history.replaceState({ ...(history.state ?? {}), panel }, '');
      };
      const setOn = (value: boolean) => {
        on = value;
        stored(PANELS_KEY, value ? '1' : '');
        show();
        if (on) say(panels.length ? panelsOn(panel, panels.length) : `Panel by panel. ${PANELS_OFF}.`);
        // Off: what arriving at the view now showing says (the pair, a spread, or "Whole page").
        else say(panelsOffAnnouncement(view(), book?.dataset.kind ?? '', announce?.dataset.textWide ?? ''));
      };
      toggle.addEventListener('click', () => setOn(!on));
      // Only moving between panels pans and zooms (comic-reader-panels AC-14): arriving on a page, a
      // resize or the picture loading puts the view in place at once.
      const still = (then: () => void) => {
        reader.classList.add('kb-still');
        then();
        void img.offsetWidth;
        requestAnimationFrame(() => requestAnimationFrame(() => reader.classList.remove('kb-still')));
      };
      // Resizing or turning the screen changes nothing but the panel's place: one page stays one page.
      window.addEventListener('resize', () => still(place));
      img.addEventListener('load', () => still(place));

      // Where to open: the panel kept for this page (a refresh), or where a turn asked, or the first.
      let arrive: { to: string; at: 'first' | 'last' } | undefined;
      try {
        arrive = JSON.parse(sessionStorage.getItem(ARRIVE_KEY) ?? 'null') ?? undefined;
        sessionStorage.removeItem(ARRIVE_KEY);
      } catch {
        arrive = undefined;
      }
      const kept = (history.state as { panel?: number } | null)?.panel;
      if (typeof kept === 'number' && kept < panels.length) panel = kept;
      else if (arrive?.to === location.pathname + location.search && arrive.at === 'last') panel = Math.max(0, panels.length - 1);
      on = stored(PANELS_KEY) === '1';
      toggle.hidden = false;
      still(show);
      if (on) panelSuffix = panels.length ? panelAnnouncement(panel, panels.length) : '';

      const leave = (which: 'previous' | 'next') => {
        const target = link(which);
        if (!target) return;
        try {
          sessionStorage.setItem(ARRIVE_KEY, JSON.stringify({ to: where(target.href), at: which === 'next' ? 'first' : 'last' }));
        } catch {
          // Without storage, the page opens at its first panel.
        }
      };
      panelTurn = (which) => {
        if (!on) return false;
        const within = panels.length > 0 && (which === 'next' ? panel + 1 < panels.length : panel > 0);
        if (within) {
          panel += which === 'next' ? 1 : -1;
          show();
          say(panelAnnouncement(panel, panels.length));
          return true;
        }
        leave(which);
        return false;
      };
      document.querySelectorAll<HTMLAnchorElement>('a[data-control="previous"], a[data-control="next"]').forEach((a) => {
        const which = a.dataset.control as 'previous' | 'next';
        const step = (e: Event) => {
          if (!on) return;
          if (panelTurn?.(which)) e.preventDefault();
        };
        a.addEventListener('click', step);
        // A control without an address isn't activated by Enter on its own.
        a.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && !a.hasAttribute('href')) step(e);
        });
      });
    }

    // Share this page: the share menu on touch screens, otherwise copy; copy by hand if that fails.
    const shareBox = document.querySelector<HTMLElement>('[data-share]');
    const shareButton = document.querySelector<HTMLButtonElement>('[data-share-button]');
    if (shareBox && shareButton) {
      shareBox.hidden = false;
      const label = shareButton.querySelector<HTMLElement>('[data-share-label]')!;
      const status = shareBox.querySelector<HTMLElement>('[data-share-status]')!;
      const copyBox = shareBox.querySelector<HTMLElement>('[data-copy]')!;
      const url = shareButton.dataset.url!;
      let reset: ReturnType<typeof setTimeout> | undefined;
      const copied = () => {
        label.textContent = 'Link copied';
        status.textContent = 'Link copied';
        shareButton.classList.add('is-done');
        clearTimeout(reset);
        reset = setTimeout(() => {
          label.textContent = 'Share this page';
          status.textContent = '';
          shareButton.classList.remove('is-done');
        }, 4000);
      };
      shareButton.addEventListener('click', async () => {
        if (typeof navigator.share === 'function' && matchMedia('(pointer: coarse)').matches) {
          try {
            await navigator.share({ title: shareButton.dataset.title, url });
            return;
          } catch (error) {
            if ((error as DOMException | undefined)?.name === 'AbortError') return;
          }
        }
        try {
          await navigator.clipboard.writeText(url);
          copied();
        } catch {
          copyBox.hidden = false;
          const input = copyBox.querySelector('input')!;
          input.focus();
          input.select();
        }
      });
    }

    // How pages fit on a computer (docs/specs/comic-reader-page-size.md AC-15 to AC-20): Page size, its menu, and
    // the fan's choice, kept in the browser for every comic. The head script has already marked the page.
    const root = document.documentElement;
    const reader = document.querySelector<HTMLElement>('.reader');
    const comicSize = (reader?.dataset.pageSize ?? 'screen') as PageSize;
    const SIZE_NAMES: Record<PageSize, string> = { screen: 'Fit the screen', width: 'Fit the width', height: 'Fit the height' };
    const sizeInUse = (): PageSize => (root.classList.contains('kb-fit-width') ? 'width' : root.classList.contains('kb-fit-height') ? 'height' : 'screen');
    /** The `sizes` a picture asks with, for the size in use (AC-7). */
    const sizesFor = (width: number, height: number, spread: boolean, cap: number) =>
      readerSizes({ width, height }, spread, Boolean(document.querySelector('.reader--panelled')), { size: sizeInUse(), cap });
    const sizeControl = document.querySelector<HTMLElement>('[data-page-size-control]');
    if (sizeControl && reader) {
      const button = sizeControl.querySelector<HTMLButtonElement>('.reader__size-button')!;
      const tip = sizeControl.querySelector<HTMLElement>('.reader__size-tip')!;
      const sizeMenu = sizeControl.querySelector<HTMLElement>('[role="menu"]')!;
      const items = [...sizeMenu.querySelectorAll<HTMLButtonElement>('[role="menuitemradio"]')];
      const note = sizeMenu.querySelector<HTMLElement>('[data-size-note]')!;
      const keptText = note.textContent ?? '';
      sizeControl.hidden = false;
      sizeMenuOpen = () => !sizeMenu.hidden;

      const show = () => {
        const own = root.dataset.kbOwnSize as PageSize | undefined;
        for (const it of items) {
          const on = (it.dataset.size === 'comic' && !own) || it.dataset.size === own;
          it.setAttribute('aria-checked', String(on));
          it.querySelector('.reader__size-tick')!.textContent = on ? '✓' : '';
        }
        button.setAttribute('aria-label', own ? `Page size: ${SIZE_NAMES[own]}, your choice` : 'Page size');
        tip.textContent = own ? `Page size: ${SIZE_NAMES[own]}` : 'Page size';
        button.toggleAttribute('data-own', Boolean(own));
        // Each picture asks for the size it now shows at.
        document.querySelectorAll<HTMLElement>('.reader__page').forEach((pg) => {
          const img = pg.querySelector('img');
          if (img) img.sizes = sizesFor(img.width || Number(img.getAttribute('width')), img.height || Number(img.getAttribute('height')), pg.classList.contains('is-spread'), Number(pg.dataset.cap));
        });
      };
      const apply = (own: PageSize | undefined) => {
        const size = own ?? comicSize;
        root.classList.toggle('kb-fit-width', size === 'width');
        root.classList.toggle('kb-fit-height', size === 'height');
        if (own) root.dataset.kbOwnSize = own;
        else delete root.dataset.kbOwnSize;
        show();
      };
      const close = (focusButton: boolean) => {
        if (sizeMenu.hidden) return;
        sizeMenu.hidden = true;
        button.setAttribute('aria-expanded', 'false');
        if (focusButton) button.focus();
      };
      const openMenu = () => {
        const panels = reader.classList.contains('is-panels');
        note.textContent = panels ? (note.dataset.panelsText ?? keptText) : keptText;
        sizeMenu.hidden = false;
        button.setAttribute('aria-expanded', 'true');
        (items.find((it) => it.getAttribute('aria-checked') === 'true') ?? items[0])!.focus();
      };
      const choose = (value: string) => {
        const own = value === 'comic' ? undefined : (value as PageSize);
        try {
          if (own) localStorage.setItem(PAGE_SIZE_KEY, own);
          else localStorage.removeItem(PAGE_SIZE_KEY);
        } catch {
          // Storage refused: the choice applies to this page only (AC-19).
        }
        apply(own);
        close(true);
        const name = SIZE_NAMES[own ?? comicSize];
        spoken = true;
        if (reader.classList.contains('is-panels')) {
          if (announce) announce.textContent = `Page size: ${name}. Applies when Panel by panel is off.`;
          return;
        }
        reader.scrollIntoView({ block: 'start' });
        if (announce) announce.textContent = `Page size: ${name}.`;
      };

      button.addEventListener('click', () => (sizeMenu.hidden ? openMenu() : close(true)));
      button.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || ((e.key === 'Enter' || e.key === ' ') && sizeMenu.hidden)) {
          e.preventDefault();
          openMenu();
        }
      });
      items.forEach((it, i) => {
        it.addEventListener('click', () => choose(it.dataset.size ?? 'comic'));
        it.addEventListener('keydown', (e) => {
          const go = (n: number) => items[(n + items.length) % items.length]!.focus();
          if (e.key === 'ArrowDown') go(i + 1);
          else if (e.key === 'ArrowUp') go(i - 1);
          else if (e.key === 'Home') go(0);
          else if (e.key === 'End') go(items.length - 1);
          else if (e.key === 'Enter' || e.key === ' ') choose(it.dataset.size ?? 'comic');
          else if (e.key === 'Escape' || e.key === 'Tab') close(true);
          else if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
          e.preventDefault();
        });
      });
      document.addEventListener('pointerdown', (e) => {
        if (!sizeMenu.hidden && !sizeControl.contains(e.target as Node)) close(false);
      });
      show();
    }

    // Fetch the next pages' images after this one loads, unless the browser asks to save data: the
    // next page on a narrow screen, the next pair or spread on a wide one.
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    if (!saveData) {
      window.addEventListener('load', () => {
        document.querySelectorAll<HTMLMetaElement>(`meta[name="kb-next-image"][data-view="${view()}"]`).forEach((next) => {
          const img = new Image();
          const w = Number(next.dataset.width);
          const h = Number(next.dataset.height);
          // The size the next page will show at (comic-reader-page-size AC-7).
          img.sizes = w && h ? sizesFor(w, h, view() === 'wide' ? w > h : false, Number(next.dataset.cap)) : view() === 'wide' ? '50vw' : '(max-width: 700px) 100vw, 900px';
          if (next.dataset.srcset) img.srcset = next.dataset.srcset;
          img.src = next.content;
        });
      });
    }

    // The page-flip (comic-reader-spread-and-flip AC-11): only a turn to the previous or next page
    // plays it, so save its direction for the next page, or skip it. History and other links don't.
    window.addEventListener('pageswap', (event) => {
      const e = event as Event & {
        viewTransition?: { skipTransition(): void };
        activation?: { navigationType?: string; entry?: { url?: string } };
      };
      if (!e.viewTransition) return;
      const url = e.activation?.entry?.url;
      const where = (href: string) => {
        const u = new URL(href);
        return u.pathname + u.search;
      };
      const hrefs = (selector: string) => [...document.querySelectorAll<HTMLAnchorElement>(selector)].map((a) => where(a.href));
      const dir =
        url && e.activation?.navigationType === 'push'
          ? turnDirection(where(url), {
              previous: hrefs('a[data-turn="previous"][href], a.reader__edge--prev'),
              next: hrefs('a[data-turn="next"][href], a.reader__edge--next'),
            })
          : undefined;
      if (!dir) {
        e.viewTransition.skipTransition();
        return;
      }
      try {
        sessionStorage.setItem('kb-flip', JSON.stringify({ to: where(url!), dir, at: Date.now() }));
      } catch {
        e.viewTransition.skipTransition();
      }
    });
  </script>
</BaseLayout>

<style>
  .reader {
    scroll-margin-top: 0;
    /* At least a window tall, so the scroll on load (below the reader, before the footer is
       parsed) can always bring the bar to the top: every page then opens at the same place,
       with or without the end note (design-comic-spread-and-flip, 2026-11-05). */
    min-height: 100vh;
    max-width: 960px;
    margin: 0 auto;
    padding: 0.5rem 0.5rem 2rem;
  }
  /* The page around the reader already has side padding; on a narrow phone, don't add more, so the
     controls' captions fit even with enlarged text. */
  @media (max-width: 480px) {
    .reader { padding-inline: 0; }
  }

  .reader__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.5rem 0.25rem;
  }
  .reader__back { font-family: 'Nunito', sans-serif; font-weight: 700; color: var(--color-ink); }
  .reader__all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.3rem 0.6rem;
    border: 2px solid var(--color-ink);
    background: var(--color-beige);
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
  }
  .reader__grid { display: inline-grid; grid-template-columns: repeat(3, 5px); gap: 2px; }
  .reader__grid i { display: block; width: 5px; height: 5px; background: var(--color-ink); }
  /* Phones: Back to series and the two buttons on the first line, the location line under them. On
     phones, either way up, the buttons show their pictures only, as 44 px squares together at the right,
     and stay together if they wrap (comic-reader-phone-bar AC-1, AC-5). Their words stay in the button,
     visually hidden, and the name shows under it on hover and keyboard focus, right-aligned, so it's
     inside the screen (AC-2, AC-3). */
  .reader__tool-tip { display: none; }
  @media (max-width: 699px) {
    .reader__location { flex-basis: 100%; }
    .reader__tools { display: flex; gap: 1rem; margin-left: auto; }
    .reader__tool { position: relative; width: 44px; height: 44px; padding: 0; justify-content: center; gap: 0; }
    .reader__panels svg { width: 18px; height: 26px; }
    .reader__all .reader__grid { grid-template-columns: repeat(3, 6px); }
    .reader__all .reader__grid i { width: 6px; height: 6px; }
    .reader__tool-word {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .reader__tool-tip {
      position: absolute;
      top: calc(100% + 8px);
      right: -2px; /* the button's outer edge, past its 2 px border */
      z-index: 3;
      padding: 0.25rem 0.5rem;
      background: var(--color-ink);
      color: var(--color-beige);
      font: 600 0.8rem 'Nunito', sans-serif;
      white-space: nowrap;
      pointer-events: none;
    }
    .reader__tool:focus-visible .reader__tool-tip { display: block; }
  }
  /* Hover only where a device can hover: on touch, a tap would leave the label stuck over the page. */
  @media (max-width: 699px) and (hover: hover) {
    .reader__tool:hover .reader__tool-tip { display: block; }
  }
  @media (min-width: 700px) {
    .reader__tools { display: contents; }
    .reader__all { order: 3; }
    .reader__location { margin-right: auto; }
  }
  .reader__location {
    margin: 0;
    font-family: 'DM Mono', monospace;
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* The page reserves its space; the loading message sits behind the image until it paints. */
  .reader__page {
    position: relative;
    margin: 0 auto;
    width: 100%;
    /* Fits the visible screen below the reader bar and above the controls: the small viewport, with the
       browser's toolbars showing, where 100vh on iPhone Safari is the screen with them hidden
       (comic-reader-phone-bar AC-8). 100vh for browsers without svh. */
    max-height: calc(100vh - 12.5rem);
    max-height: calc(100svh - 12.5rem);
    max-width: min(100%, calc((100vh - 12.5rem) * var(--page-ratio, 0.6667)));
    max-width: min(100%, calc((100svh - 12.5rem) * var(--page-ratio, 0.6667)));
    background: var(--color-paper-dark);
  }
  /* A spread on a narrow screen is shrunk to fit its width; sideways, it fills it, with the controls a
     short scroll below (comic-reader-spread-and-flip AC-8). */
  .reader__page.is-spread { max-height: none; max-width: 100%; }
  .reader__turn-hint {
    display: none;
    margin: 0.5rem 0 0;
    text-align: center;
    font-size: 0.9rem;
    color: var(--color-ink-light);
  }
  @media (orientation: portrait) {
    .reader__turn-hint { display: block; }
  }

  /* Each view's parts. The width test is WIDE_MEDIA in src/lib/comics/spreads.ts. Panel by panel marks
     the page one page at a time (kb-one-page), which shows the narrow view on every screen
     (comic-reader-panels-two-up). */
  @media not ((min-width: 62.5em) and (orientation: landscape)) {
    .for-wide, .reader__page.is-other { display: none !important; }
  }
  :global(html.kb-one-page) .for-wide,
  :global(html.kb-one-page) .reader__page.is-other { display: none !important; }
  @media (min-width: 62.5em) and (orientation: landscape) {
    :global(html:not(.kb-one-page)) .for-narrow { display: none !important; }
    :global(html:not(.kb-one-page)) .reader--pairs { max-width: 1400px; }
    /* Two pages of the same height meeting at the spine, a page alone on its own side, or a spread
       across both (comic-reader-spread-and-flip AC-7). */
    :global(html:not(.kb-one-page)) .reader--pairs .reader__book {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: minmax(0, 1fr);
      height: calc(100vh - 12.5rem);
      height: calc(100svh - 12.5rem);
    }
    :global(html:not(.kb-one-page)) .reader--pairs .reader__book .reader__page {
      height: 100%;
      width: auto;
      max-width: 100%;
      max-height: none;
      margin: 0;
    }
    :global(html:not(.kb-one-page)) .reader--pairs .reader__page[data-side='left'] { grid-column: 1; justify-self: end; view-transition-name: kb-left; }
    :global(html:not(.kb-one-page)) .reader--pairs .reader__page[data-side='right'] { grid-column: 2; justify-self: start; view-transition-name: kb-right; }
    :global(html:not(.kb-one-page)) .reader--pairs .reader__page[data-side='both'] { grid-column: 1 / -1; justify-self: center; view-transition-name: kb-spread; }
    :global(html:not(.kb-one-page)) .reader--pairs .reader__book[data-kind='pair']::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 48px;
      transform: translateX(-50%);
      background: linear-gradient(to right, transparent, rgba(43, 43, 43, 0.22) 50%, transparent);
      pointer-events: none;
    }
    .reader__turn-hint { display: none; }
    /* With two pages side by side off, or one page at a time, a spread shows alone, as wide as the page
       area allows (comic-reader-comic-settings AC-3). */
    .reader:not(.reader--pairs) .reader__page.is-spread,
    :global(html.kb-one-page) .reader__page.is-spread {
      max-height: calc(100vh - 12.5rem);
      max-height: calc(100svh - 12.5rem);
      max-width: min(100%, calc((100vh - 12.5rem) * var(--page-ratio, 1.3333)));
      max-width: min(100%, calc((100svh - 12.5rem) * var(--page-ratio, 1.3333)));
