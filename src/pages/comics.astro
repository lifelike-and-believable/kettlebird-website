---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllComicSeries, type ComicSeries } from '../lib/queries';
import { urlFor } from '../lib/sanity';

let series: ComicSeries[] = [];
try {
  series = await getAllComicSeries();
} catch (e) {
  console.warn('[comics] Could not fetch comic series:', e);
}

const STATUS_LABELS: Record<string, string> = {
  ongoing: 'Ongoing',
  complete: 'Complete',
  hiatus: 'On Hiatus',
};

const STATUS_COLORS: Record<string, string> = {
  ongoing: 'var(--color-green)',
  complete: 'var(--color-yellow)',
  hiatus: 'var(--color-orange)',
};

const TYPE_LABELS: Record<string, string> = {
  original: 'Original',
  fancomic: 'Fancomic',
};
---

<BaseLayout
  title="Comics • Kettlebird Creations"
  description="Original comics and fancomics by Star Goldberg (Kettlebird)."
>
  <section class="comics-page">
    <header class="page-header">
      <h1 class="page-title">Comics</h1>
      <p class="page-subtitle">Original stories and fancomics</p>
    </header>

    {series.length === 0 ? (
      <div class="empty-state">
        <p class="empty-state__text">Comics in progress — pages coming soon!</p>
        <div class="empty-state__doodle" aria-hidden="true">🖊️</div>
      </div>
    ) : (
      <ul class="series-grid">
        {series.map((s) => {
          const imgUrl = s.coverImage?.asset
            ? urlFor(s.coverImage).width(500).height(700).fit('crop').auto('format').url()
            : null;

          const statusColor = s.status ? STATUS_COLORS[s.status] : 'var(--color-yellow)';

          return (
            <li class="series-card">
              <a href={`/comics/${s.slug?.current}`} class="series-card__link">
                <div class="series-card__cover">
                  {imgUrl
                    ? <img src={imgUrl} alt={s.title} class="series-card__img" width={500} height={700} loading="lazy" />
                    : <div class="series-card__cover-placeholder" aria-hidden="true">📚</div>
                  }
                  {s.status && (
                    <span class="series-card__status" style={`background: ${statusColor}`}>
                      {STATUS_LABELS[s.status] ?? s.status}
                    </span>
                  )}
                </div>
                <div class="series-card__body">
                  <h2 class="series-card__title">{s.title}</h2>
                  <div class="series-card__meta">
                    {s.type && <span class="meta-tag">{TYPE_LABELS[s.type] ?? s.type}</span>}
                    {s.pageCount != null && (
                      <span class="meta-tag meta-tag--pages">{s.pageCount} page{s.pageCount !== 1 ? 's' : ''}</span>
                    )}
                  </div>
                  {s.description && <p class="series-card__description">{s.description}</p>}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .comics-page {
    max-width: 1300px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-family: 'Nunito', sans-serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    margin: 0 0 0.25rem;
  }

  .page-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.1rem;
    color: var(--color-dark-purple, #4a4063);
    margin: 0;
  }

  /* ── Empty state ── */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 5rem 1rem;
    border: 3px dashed var(--color-dark-purple, #4a4063);
    text-align: center;
  }

  .empty-state__text {
    font-family: 'Nunito', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-dark-purple, #4a4063);
    margin: 0;
  }

  .empty-state__doodle {
    font-size: 3rem;
  }

  /* ── Series grid ── */
  .series-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .series-card {
    border: 3px solid var(--color-ink, #2b2b2b);
    background: var(--color-beige, #f5f1e8);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .series-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 rgba(0,0,0,0.12);
  }

  .series-card__link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .series-card__cover {
    position: relative;
    aspect-ratio: 5/7;
    overflow: hidden;
    border-bottom: 3px solid var(--color-ink, #2b2b2b);
  }

  .series-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .series-card__cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    background: var(--color-yellow, #f4ce6a);
  }

  .series-card__status {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    font-family: 'Nunito', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border: 2px solid var(--color-ink, #2b2b2b);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .series-card__body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .series-card__title {
    font-family: 'Nunito', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
  }

  .series-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .meta-tag {
    font-family: 'Nunito', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border: 2px solid var(--color-ink, #2b2b2b);
    background: transparent;
  }

  .meta-tag--pages {
    background: var(--color-green, #a8d5ba);
  }

  .series-card__description {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    color: var(--color-ink, #2b2b2b);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 400px) {
    .series-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
