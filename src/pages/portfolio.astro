---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid';
import { getAllGalleryItems, type GalleryItem } from '../lib/queries';

type DisplayItem = GalleryItem & { placeholderSrc?: string };

let items: GalleryItem[] = [];
try {
  items = await getAllGalleryItems();
} catch (e) {
  console.warn('[portfolio] Could not fetch gallery items:', e);
}

// Real sample artwork stands in for thumbnails until Sanity is wired up.
const SAMPLE_IMAGES = [
  '/assets/images/bkgd-artwork.jpg',
  '/assets/images/bkgd-commissions.jpeg',
  '/assets/images/bkgd-Comics.jpg',
  '/assets/images/bkgd-writing.jpg',
];

function placeholders(cat: string, titles: string[]): DisplayItem[] {
  return titles.map((title, i) => ({
    _id: `ph-${cat}-${i}`,
    title,
    slug: { current: `${cat}-${i}` },
    image: null as any,
    category: [cat],
    placeholderSrc: SAMPLE_IMAGES[i % SAMPLE_IMAGES.length],
  }));
}

const PLACEHOLDER_ITEMS: DisplayItem[] = [
  ...placeholders('original', [
    'Original Character Study', 'Creature Design', 'Environment Concept',
    'Character Lineup', 'Illustration Series', 'Comic Page',
  ]),
  ...placeholders('fanart', [
    'Adventure Time', 'Gravity Falls', 'Steven Universe',
    'My Hero Academia', 'She-Ra', 'Tarot Series',
  ]),
  ...placeholders('commission', [
    'Book Cover', 'Brand Character', 'Editorial Illustration',
    'Game Asset Pack', 'Poster Design', 'Sticker Sheet',
  ]),
];

const displayItems: DisplayItem[] = items.length > 0 ? items : PLACEHOLDER_ITEMS;
---

<BaseLayout
  title="Portfolio • Kettlebird Creations"
  description="Illustrations, fanart, original characters, and commissioned work by Star Goldberg (Kettlebird)."
>
  <section class="portfolio-page">
    <header class="portfolio-header">
      <h1 class="page-title portfolio-title">Portfolio</h1>
      <p class="portfolio-subtitle">Illustrations, fanart, and original characters</p>
    </header>

    <GalleryGrid items={displayItems} client:load />
  </section>
</BaseLayout>

<style>
  .portfolio-page {
    /* full-bleed bands handle their own width; no horizontal padding here */
    padding: 0 0 4rem;
  }

  .portfolio-header {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1rem 0;
  }

  .portfolio-title {
    margin: 0 0 0.25rem;
  }

  .portfolio-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.1rem;
    color: var(--color-dark-purple, #4a4063);
    margin: 0;
  }

  /* ── INDEX filter bar ─────────────────────────────────────── */
  :global(.gallery-index) {
    max-width: 1400px;
    margin: 0 auto 2rem;
    padding: 1.5rem 1rem 0;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  :global(.gallery-index__label) {
    font-family: 'DM Mono', monospace;
    font-size: 1.15rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.3rem 1.1rem;
    color: var(--color-ink, #2b2b2b);
    background: url('/assets/images/Highlighter_M.png') no-repeat center;
    background-size: 100% 100%;
    flex-shrink: 0;
  }

  :global(.gallery-filters) {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  :global(.filter-btn) {
    font-family: 'DM Mono', monospace;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.35rem 1rem;
    border: 2px solid var(--color-ink, #2b2b2b);
    background: transparent;
    color: var(--color-ink, #2b2b2b);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  :global(.filter-btn:hover),
  :global(.filter-btn--active) {
    background: var(--color-ink, #2b2b2b);
    color: var(--color-beige, #f5f1e8);
  }

  /* ── Stacked, edge-to-edge folder bands ───────────────────── */
  :global(.folder-stack) {
    display: flex;
    flex-direction: column;
  }

  /* Each band runs the full viewport width and butts against its
     neighbours — no gaps, no drop shadows. Kraft tone now; ready to
     swap background-image for a texture asset from Star later. */
  :global(.folder-section) {
    width: 100%;
    position: relative;
    background-color: #c3a47d;
    background-image: url('/assets/images/Paper_2_Tileable.png');
    background-size: 420px;
    background-blend-mode: multiply;
  }

  :global(.folder-section[data-cat='original'])   { background-color: #c9aa7e; }
  :global(.folder-section[data-cat='fanart'])      { background-color: #bd9f76; }
  :global(.folder-section[data-cat='commission'])  { background-color: #c2a06e; }
  :global(.folder-section[data-cat='featured'])    { background-color: #c9a87c; }
  :global(.folder-section[data-cat='wip'])         { background-color: #bfa884; }

  /* Torn-paper seam at the top edge of each band */
  :global(.folder-section::before) {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 16px;
    background: url('/assets/images/Paper_1_Torn.png') repeat-x top center;
    background-size: auto 16px;
    pointer-events: none;
  }

  :global(.folder-inner) {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2.75rem 1rem 1.75rem;
    position: relative;
  }

  /* Section label as a monospace marker tab straddling the top edge */
  :global(.folder-label) {
    position: absolute;
    top: -0.7rem;
    left: 1rem;
    font-family: 'DM Mono', monospace;
    font-weight: 500;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    color: var(--color-ink, #2b2b2b);
    padding: 0.2rem 1rem;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100% 100%;
  }

  :global(.folder-label[data-cat='original'])   { background-image: url('/assets/images/Highlighter_Y.png'); }
  :global(.folder-label[data-cat='fanart'])      { background-image: url('/assets/images/Highlighter_G.png'); }
  :global(.folder-label[data-cat='commission'])  { background-image: url('/assets/images/Highlighter_O.png'); }
  :global(.folder-label[data-cat='featured'])    { background-image: url('/assets/images/Highlighter_M.png'); }
  :global(.folder-label[data-cat='wip'])         { background-image: url('/assets/images/Highlighter_Y.png'); }

  /* ── Carousel ─────────────────────────────────────────────── */
  :global(.carousel) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  :global(.carousel__track) {
    display: flex;
    gap: 0.85rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    flex: 1;
    padding-bottom: 0.25rem;
  }

  :global(.carousel__track::-webkit-scrollbar) {
    display: none;
  }

  :global(.carousel__arrow) {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-ink, #2b2b2b);
    color: var(--color-beige, #f5f1e8);
    border: none;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    font-family: 'Nunito', sans-serif;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.1s;
  }

  :global(.carousel__arrow:hover) {
    transform: scale(1.12);
  }

  /* ── Gallery card (thumbnail in carousel) ─────────────────── */
  :global(.gallery-card) {
    position: relative;
    border: 3px solid var(--color-ink, #2b2b2b);
    overflow: hidden;
    background: var(--color-beige, #f5f1e8);
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
    width: 220px;
    height: 220px;
    scroll-snap-align: start;
    transition: transform 0.18s;
  }

  :global(.gallery-card:hover) {
    transform: scale(1.04);
    z-index: 1;
  }

  :global(.gallery-card__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  :global(.gallery-card__placeholder) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    background: var(--color-yellow, #f4ce6a);
  }

  :global(.gallery-card__overlay) {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    padding: 1.5rem 0.75rem 0.6rem;
    opacity: 0;
    transition: opacity 0.2s;
  }

  :global(.gallery-card:hover .gallery-card__overlay),
  :global(.gallery-card:focus-visible .gallery-card__overlay) {
    opacity: 1;
  }

  :global(.gallery-card__title) {
    font-family: 'DM Mono', monospace;
    font-weight: 500;
    font-size: 0.85rem;
    color: #fff;
  }

  :global(.gallery-empty) {
    font-family: 'DM Mono', monospace;
    font-size: 1rem;
    padding: 1rem 0;
    color: var(--color-ink, #2b2b2b);
  }

  /* ── Lightbox ─────────────────────────────────────────────── */
  :global(.lightbox) {
    position: fixed;
    inset: 0;
    background: rgba(43, 43, 43, 0.85);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  :global(.lightbox__inner) {
    background: var(--color-beige, #f5f1e8);
    border: 3px solid var(--color-ink, #2b2b2b);
    max-width: 900px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  :global(.lightbox__close) {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: var(--color-ink, #2b2b2b);
    color: var(--color-beige, #f5f1e8);
    border: none;
    font-size: 1rem;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    z-index: 1;
  }

  :global(.lightbox__img) {
    width: 100%;
    height: auto;
    display: block;
    max-height: 65vh;
    object-fit: contain;
    background: var(--color-ink, #2b2b2b);
  }

  :global(.lightbox__info) {
    padding: 1.25rem;
  }

  :global(.lightbox__title) {
    font-family: 'Nunito', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }

  :global(.lightbox__description) {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  :global(.lightbox__tags) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  :global(.lightbox__tag) {
    font-family: 'DM Mono', monospace;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    border: 2px solid var(--color-ink, #2b2b2b);
    background: var(--color-yellow, #f4ce6a);
  }
</style>
