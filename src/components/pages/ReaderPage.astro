  .reader__share-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.4rem 1rem;
    border: 2px solid var(--color-ink);
    background: transparent;
    color: var(--color-ink);
