---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kettlebird Creations • Writer & Illustrator"
  description="Portfolio of Star Goldberg (they/them) - UPA-inspired illustrations, comics, and written works featuring fantasy characters and fanart."
>
  <!-- Hero Section with Radial Navigation -->
  <section class="hero">
    <div class="hero-content">
      <nav class="radial-hub" aria-label="Main navigation">
        <!-- Central logo -->
        <div class="radial-center">
          <div class="radial-logo-ring">
            <img
              src="/assets/images/logo-primary_Placeholder.jpg"
              alt="Kettlebird Creations logo – a stylised bird silhouette with the letters K and B"
              class="radial-logo-img"
              width="200"
              height="200"
              loading="eager"
            />
          </div>
        </div>

        <!-- Radial menu items positioned around the logo -->
        <ul class="radial-menu">
          <li class="radial-item radial-item--top">
            <a href="/">Home</a>
          </li>
          <li class="radial-item radial-item--top-right">
            <a href="/portfolio">Artwork</a>
          </li>
          <li class="radial-item radial-item--right">
            <a href="/comics">Comics</a>
          </li>
          <li class="radial-item radial-item--bottom-right">
            <a href="/writing">Writing</a>
          </li>
          <li class="radial-item radial-item--bottom">
            <a href="/about#contact">Contact</a>
          </li>
          <li class="radial-item radial-item--bottom-left">
            <a href="/commissions">Commissions</a>
          </li>
          <li class="radial-item radial-item--left">
            <a href="/shop">Merch</a>
          </li>
          <li class="radial-item radial-item--top-left">
            <a href="/about">About</a>
          </li>
        </ul>
      </nav>
    </div>
  </section>

  <!-- Featured Work Preview -->
  <section class="section section-featured">
    <h2 class="section-heading">
      Featured Artwork
      <span class="sketchy-underline" aria-hidden="true"></span>
    </h2>
    <div class="artwork-grid">
      <article class="artwork-card">
        <div class="artwork-placeholder" style="--artwork-color: var(--color-accent-1);">
          <span class="artwork-icon">🎨</span>
        </div>
        <h3 class="artwork-title">Fantasy Portraits</h3>
        <p class="artwork-description">Character illustrations featuring orcs, tieflings, and other fantasy folks.</p>
      </article>
      <article class="artwork-card">
        <div class="artwork-placeholder" style="--artwork-color: var(--color-secondary);">
          <span class="artwork-icon">✨</span>
        </div>
        <h3 class="artwork-title">Fanart Collection</h3>
        <p class="artwork-description">Celebrating beloved characters from across various fandoms and media.</p>
      </article>
      <article class="artwork-card">
        <div class="artwork-placeholder" style="--artwork-color: var(--color-accent-2);">
          <span class="artwork-icon">🌟</span>
        </div>
        <h3 class="artwork-title">Original Characters</h3>
        <p class="artwork-description">Unique character designs with personality and flair.</p>
      </article>
      <article class="artwork-card">
        <div class="artwork-placeholder" style="--artwork-color: var(--color-splash-1);">
          <span class="artwork-icon">🖼️</span>
        </div>
        <h3 class="artwork-title">Sketches & Studies</h3>
        <p class="artwork-description">Process work and experimental pieces.</p>
      </article>
    </div>
    <a href="/portfolio" class="section-link">View Full Portfolio →</a>
  </section>

  <!-- Comics Preview -->
  <section class="section section-comics">
    <h2 class="section-heading">
      Comics
      <span class="sketchy-underline" aria-hidden="true"></span>
    </h2>
    <div class="comics-grid">
      <a href="https://www.tumblr.com/kettle-bird/802567583219023872/the-writer-and-the-story-of-the-world-a-great-god" target="_blank" rel="noopener noreferrer" class="comic-card-link">
        <article class="comic-card">
          <div class="comic-cover" style="--comic-color: var(--color-ink-night);">
            <span class="comic-icon">📝</span>
          </div>
          <h3 class="comic-title">The Writer and the Story of the World</h3>
          <p class="comic-description">A Great God Grove fan comic exploring narrative and creation.</p>
          <span class="comic-status">Complete</span>
        </article>
      </a>
      <article class="comic-card">
        <div class="comic-cover" style="--comic-color: var(--color-accent-1);">
          <span class="comic-icon">📖</span>
        </div>
        <h3 class="comic-title">Short Stories</h3>
        <p class="comic-description">One-shot comics and mini-series featuring original characters.</p>
        <span class="comic-status">Available Now</span>
      </article>
    </div>
    <a href="/comics" class="section-link">Read Comics →</a>
  </section>

  <!-- Written Works Preview -->
  <section class="section section-writing">
    <h2 class="section-heading">
      Written Works
      <span class="sketchy-underline" aria-hidden="true"></span>
    </h2>
    <div class="writing-grid">
      <article class="writing-card">
        <div class="writing-cover">
          <span class="writing-icon">📚</span>
        </div>
        <h3 class="writing-title">Fantasy Fiction</h3>
        <p class="writing-description">Short stories and longer works exploring fantastical worlds and characters.</p>
      </article>
      <article class="writing-card">
        <div class="writing-cover">
          <span class="writing-icon">✍️</span>
        </div>
        <h3 class="writing-title">Creative Essays</h3>
        <p class="writing-description">Reflections on art, storytelling, and the creative process.</p>
      </article>
    </div>
    <a href="/writing" class="section-link">Explore Writing →</a>
  </section>

  <!-- Commissions Section -->
  <section class="section section-commissions">
    <div class="commission-banner">
      <div class="commission-status">
        <span class="status-indicator status-open"></span>
        <h2 class="commission-heading">Commissions: Open</h2>
      </div>
      <p class="commission-intro">
        I'm currently accepting commission work for character illustrations, 
        portrait pieces, and custom artwork. Whether you're looking for a 
        D&D character, an original design, or fanart, I'd love to work with you!
      </p>
      <ul class="commission-offerings">
        <li>✨ Character portraits & illustrations</li>
        <li>🎨 Fantasy character designs</li>
        <li>💫 Fanart commissions</li>
        <li>📖 Comic page illustration</li>
      </ul>
      <a href="/commissions" class="btn btn-secondary">Learn More</a>
    </div>
  </section>

  <!-- About Preview -->
  <section class="section section-about">
    <div class="about-preview">
      <h2 class="section-heading">
        About the Artist
        <span class="sketchy-underline" aria-hidden="true"></span>
      </h2>
      <p class="about-text">
        I'm Star Goldberg, a writer and illustrator based in Canada. My work is 
        heavily influenced by the UPA animation style, with a focus on character-driven 
        storytelling. I specialize in fantasy characters—especially orcs, tieflings, 
        and elves—as well as fanart from properties like X-Men, TMNT, and The Murderbot 
        Diaries. When I'm not drawing, I'm writing fiction and exploring new ways to 
        tell stories through both words and images.
      </p>
      <a href="/about" class="section-link">More About Me →</a>
    </div>
  </section>
</BaseLayout>
