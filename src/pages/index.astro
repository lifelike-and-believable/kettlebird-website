---
import BaseLayout from '../layouts/BaseLayout.astro';
import RadialMenu from '../components/RadialMenu';
---

<BaseLayout
  title="Kettlebird Creations"
  description="Illustration, comics, and creative writing by Star Goldberg"
>
  <section class="hero">
    <div class="hero__center">
      <!-- Hero image/logomark at center - acts as menu trigger on hover -->
      <div class="hero__logomark">
        <!-- Use actual KB bird logo image -->
        <!-- For now, using styled SVG until logo-primary.jpg is added to public/images/ -->
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="logo-svg">
          <!-- Orange background circle -->
          <circle 
            cx="100" 
            cy="100" 
            r="95" 
            fill="#f4a261"
          />
          <!-- Dark bird silhouette -->
          <g transform="translate(100, 100)">
            <!-- Bird body -->
            <ellipse cx="0" cy="5" rx="30" ry="40" fill="#264653"/>
            <!-- Bird head -->
            <circle cx="0" cy="-20" r="25" fill="#264653"/>
            <!-- Eye -->
            <circle cx="0" cy="-20" r="8" fill="#f5f1e8"/>
            <circle cx="0" cy="-20" r="4" fill="#d95d39"/>
            <!-- Beak -->
            <path d="M 0,-35 L 15,-40 L 0,-25 Z" fill="#d95d39"/>
            <!-- Wings -->
            <ellipse cx="-20" cy="0" rx="15" ry="30" fill="#264653" transform="rotate(-20)"/>
            <ellipse cx="20" cy="0" rx="15" ry="30" fill="#264653" transform="rotate(20)"/>
            <!-- Tail feathers -->
            <path d="M -15,35 Q -25,50 -20,55 L -10,40 Z" fill="#264653"/>
            <path d="M 0,40 Q 0,55 5,60 L 0,45 Z" fill="#264653"/>
            <path d="M 15,35 Q 25,50 20,55 L 10,40 Z" fill="#264653"/>
          </g>
          <!-- K and B letters -->
          <text x="60" y="170" font-family="Caveat, Patrick Hand, sans-serif" font-size="45" font-weight="700" fill="#264653">K</text>
          <text x="120" y="170" font-family="Caveat, Patrick Hand, sans-serif" font-size="45" font-weight="700" fill="#264653">B</text>
        </svg>
      </div>
      
      <!-- RadialMenu in hover mode, no toggle button -->
      <RadialMenu radius={230} hoverMode={true} showToggle={false} client:load />
    </div>
    
    <div class="hero__content">
      <h2 class="hero__title">Welcome to Kettlebird Creations</h2>
      <p class="hero__description">
        Discover original artwork, comics, and stories crafted with ink, imagination, and a touch of chaos.
      </p>
      
      <div class="hero__cta">
        <a href="/portfolio" class="cta-button">
          Explore Portfolio
        </a>
        <a href="/commissions" class="cta-button cta-button--secondary">
          Commission Info
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    padding: 4rem 1rem 3rem;
  }

  .hero__center {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(500px, 90vw);
    height: min(500px, 90vw);
  }

  .hero__logomark {
    width: 100%;
    height: 100%;
    z-index: 5;
    position: relative;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .hero__logomark:hover {
    transform: scale(1.05);
  }

  .hero__logomark .logo-svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(4px 4px 8px rgba(0, 0, 0, 0.2));
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__logomark {
      animation: none;
      transition: none;
    }
    
    .hero__logomark:hover {
      transform: none;
    }
  }

  .hero__content {
    max-width: 600px;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 1rem;
    color: var(--color-ink-night);
  }

  .hero__description {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-ink);
    margin-bottom: 2rem;
  }

  .hero__cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: var(--color-primary);
    color: var(--color-paper);
    text-decoration: none;
    font-family: 'Caveat', 'Patrick Hand', sans-serif;
    font-size: 1.5rem;
    border: 2px solid var(--color-ink);
    border-radius: 3% 97% 2% 98% / 97% 3% 98% 2%;
    box-shadow: var(--shadow-paper);
    transition: all 120ms ease-out;
    min-width: 44px;
    min-height: 44px;
  }

  .cta-button:hover {
    background: var(--color-accent-1);
    transform: rotate(-2deg);
    box-shadow: var(--shadow-paper-hover);
  }

  .cta-button:active {
    transform: scale(0.95);
  }

  .cta-button--secondary {
    background: var(--color-secondary);
    color: var(--color-ink);
  }

  .cta-button--secondary:hover {
    background: var(--color-accent-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-button:hover {
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 70vh;
      padding: 3rem 1rem 2rem;
      gap: 2rem;
    }

    .hero__center {
      width: min(350px, 90vw);
      height: min(350px, 90vw);
    }
  }
</style>
