  }

  /* Panel by panel (comic-reader-panels AC-11, AC-12, AC-14). */
  .reader__panels {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.3rem 0.6rem;
    border: 2px solid var(--color-ink);
