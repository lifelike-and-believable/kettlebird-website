---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kettlebird Creations • Writer & Illustrator"
  description="Portfolio of Star Goldberg (they/them) - UPA-inspired illustrations, comics, and written works featuring fantasy characters and fanart."
>
  <div class="homepage">
    <!-- Main Grid -->
    <div class="grid-container">
      <a href="/portfolio" class="grid-tile grid-tile-portfolio">
        <div class="tile-content"><span class="tile-title">PORTFOLIO</span></div>
      </a>
      <div class="grid-tile grid-tile-logo">
        <img src="/assets/images/kblogo.png" alt="Kettlebird Logo" class="tile-image" width="1600" height="1600" />
      </div>
      <a href="/shop" class="grid-tile grid-tile-merch">
        <div class="tile-content"><span class="tile-title">SHOP</span></div>
      </a>
      <a href="/comics" class="grid-tile grid-tile-comics">
        <div class="tile-content"><span class="tile-title">COMICS</span></div>
      </a>
      <a href="/commissions" class="grid-tile grid-tile-commissions">
        <div class="tile-content"><span class="tile-title">COMMISSIONS</span></div>
      </a>
      <a href="/writing" class="grid-tile grid-tile-writing">
        <div class="tile-content"><span class="tile-title">WRITING</span></div>
      </a>
      <a href="/about#contact" class="grid-tile grid-tile-contact">
        <div class="tile-content"><span class="tile-title">CONTACT ME!</span></div>
      </a>
      <a href="/about" class="grid-tile grid-tile-about">
        <div class="tile-content"><span class="tile-title">ABOUT</span></div>
      </a>
      <a href="/news" class="grid-tile grid-tile-news">
        <div class="tile-content"><span class="tile-title">NEWS</span></div>
      </a>
    </div>

    <!-- Social Links -->
    <div class="social-links">
      <a href="https://bsky.app/profile/kettlebird.bsky.social" target="_blank" rel="noopener noreferrer" class="social-link">BLUESKY</a>
      <a href="https://kettle-bird.tumblr.com" target="_blank" rel="noopener noreferrer" class="social-link">TUMBLR</a>
      <a href="https://www.instagram.com/kettlebirdart" target="_blank" rel="noopener noreferrer" class="social-link">INSTAGRAM</a>
      <a href="https://ko-fi.com/kettlebirdart" target="_blank" rel="noopener noreferrer" class="social-link">KO-FI</a>
    </div>

    <!-- About the Artist -->
    <section class="about-section">
      <div class="portrait-placeholder">[Insert<br />Portrait Here]</div>
      <div class="about-text">
        <h2>ABOUT THE ARTIST</h2>
        <p>
          "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et
          dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip
          ex ea commodo consequat."
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .homepage {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 1rem 2rem;
  }

  /* ── Grid ── */
  .grid-container {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(7, minmax(75px, auto));
    gap: 1rem;
    margin-top: -24px; /* overlap torn paper edge */
    margin-bottom: 2rem;
  }

  .grid-tile {
    border: 3px solid var(--color-ink);
    overflow: hidden;
    position: relative;
    min-height: 75px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.2s;
  }

  .grid-tile:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.15);
  }

  .grid-tile-portfolio {
    grid-column: span 2;
    grid-row: span 2;
    background: #8b7355 url('/assets/images/bkgd-artwork.jpg') center / cover;
  }

  .grid-tile-logo {
    grid-column: span 2;
    grid-row: span 4;
    background: var(--color-yellow);
  }

  .grid-tile-merch {
    grid-column: span 2;
    grid-row: span 2;
    background: var(--color-orange);
  }

  .grid-tile-comics {
    grid-column: span 2;
    grid-row: span 3;
    background: #c8c8c8 url('/assets/images/bkgd-Comics.jpg') center / cover;
  }

  .grid-tile-commissions {
    grid-column: span 2;
    grid-row: span 2;
    background: #a8a8a8 url('/assets/images/bkgd-commissions.jpeg') center / cover;
  }

  .grid-tile-writing {
    grid-column: 1 / span 2;
    grid-row: 6 / span 2;
    background: #d94f3d url('/assets/images/bkgd-writing.jpg') center / cover;
  }

  .grid-tile-contact {
    grid-column: 3 / span 2;
    grid-row: 5 / span 3;
    background: linear-gradient(135deg, #cc5544 0%, #d94f3d 100%);
  }

  .grid-tile-about {
    grid-column: 5 / span 1;
    grid-row: 5 / span 3;
    background: var(--color-green);
  }

  .grid-tile-about .tile-content { justify-content: flex-start; }

  .grid-tile-news {
    grid-column: 6 / span 1;
    grid-row: 5 / span 3;
    background: var(--color-yellow);
  }

  .grid-tile-news .tile-content { justify-content: flex-end; }

  .tile-content {
    text-align: center;
    padding: 1rem;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.2);
  }

  .tile-title {
    font-family: 'Nunito', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    color: white;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  }

  .tile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Social links ── */
  .social-links {
    display: flex;
    flex-direction: row;
    gap: 0;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 3rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .social-link {
    font-family: 'Nunito', sans-serif;
    font-size: 1.5rem;
    padding: 1.25rem 2.5rem;
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 700;
    transition: transform 0.2s ease-out, filter 0.2s ease-out;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position: center;
    flex: 1 1 auto;
    min-width: 160px;
  }

  .social-link:nth-child(1) { background-image: url('/assets/images/Highlighter_G.png'); }
  .social-link:nth-child(2) { background-image: url('/assets/images/Highlighter_Y.png'); }
  .social-link:nth-child(3) { background-image: url('/assets/images/Highlighter_O.png'); }
  .social-link:nth-child(4) { background-image: url('/assets/images/Highlighter_M.png'); }

  .social-link:hover { transform: scale(1.05); filter: brightness(1.1); }
  .social-link:focus-visible {
    outline: 3px solid var(--color-ink);
    outline-offset: 4px;
    transform: scale(1.05);
  }

  /* ── About section ── */
  .about-section {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    margin-bottom: 2rem;
    align-items: start;
  }

  .about-text h2 {
    font-family: 'Nunito', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .portrait-placeholder {
    background-image: url('/assets/images/Postit.png');
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    border: none;
    aspect-ratio: 3/4;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Nunito', sans-serif;
    font-size: 1.2rem;
    text-align: center;
    padding: 2rem;
  }

  .about-text {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-ink);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .grid-container {
      grid-template-columns: repeat(2, 1fr);
    }

    .grid-tile-portfolio,
    .grid-tile-logo,
    .grid-tile-merch,
    .grid-tile-comics,
    .grid-tile-commissions,
    .grid-tile-writing,
    .grid-tile-contact {
      grid-column: span 2;
      grid-row: auto;
    }

    .grid-tile-about,
    .grid-tile-news {
      grid-column: span 1;
      grid-row: auto;
    }

    .grid-tile-logo       { order: -1; }
    .grid-tile-portfolio  { order: 0; }
    .grid-tile-comics     { order: 1; }
    .grid-tile-writing    { order: 2; }
    .grid-tile-commissions{ order: 3; }
    .grid-tile-merch      { order: 4; }
    .grid-tile-about      { order: 5; }
    .grid-tile-news       { order: 6; }
    .grid-tile-contact    { order: 7; }

    .about-section {
      grid-template-columns: 1fr;
    }

    .portrait-placeholder {
      max-width: 300px;
      margin: 0 auto;
    }
  }
</style>
