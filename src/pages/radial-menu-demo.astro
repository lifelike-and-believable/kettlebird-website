---
import RadialMenu from '../components/RadialMenu';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RadialMenu Demo - Kettlebird Creations</title>
  <style>
    .demo-container {
      min-height: 100vh;
      padding: 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2rem;
    }

    .demo-content {
      max-width: 800px;
      text-align: center;
    }

    .demo-content h1 {
      font-size: 3rem;
      margin-bottom: 1rem;
      color: var(--color-primary);
    }

    .demo-content p {
      font-size: 1.25rem;
      margin-bottom: 2rem;
      color: var(--color-ink-light);
    }

    .demo-instructions {
      background: var(--color-paper);
      border: 2px solid var(--color-ink);
      border-radius: 3% 97% 2% 98% / 97% 3% 98% 2%;
      padding: 2rem;
      box-shadow: var(--shadow-paper);
      margin-top: 2rem;
      text-align: left;
    }

    .demo-instructions h2 {
      font-size: 1.75rem;
      margin-bottom: 1rem;
      color: var(--color-accent-2);
    }

    .demo-instructions ul {
      list-style: none;
      padding: 0;
    }

    .demo-instructions li {
      padding: 0.5rem 0;
      display: flex;
      align-items: start;
      gap: 0.75rem;
    }

    .demo-instructions li::before {
      content: '→';
      color: var(--color-primary);
      font-weight: bold;
      flex-shrink: 0;
    }

    .badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      background: var(--color-accent-1);
      color: white;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 600;
      margin: 0 0.25rem;
    }
  </style>
</head>
<body>
  <div class="demo-container">
    <div class="demo-content">
      <h1>✨ RadialMenu Demo</h1>
      <p>
        Click the <span class="badge">Menu</span> button in the bottom-right corner 
        to see the radial navigation menu in action!
      </p>

      <div class="demo-instructions">
        <h2>Try these interactions:</h2>
        <ul>
          <li>
            <strong>Click the toggle button</strong> to open/close the menu
          </li>
          <li>
            <strong>Hover over items</strong> to see smooth animations and rotation effects
          </li>
          <li>
            <strong>Press Escape</strong> to close the menu
          </li>
          <li>
            <strong>Use arrow keys</strong> (↑ ↓ ← →) to navigate between items
          </li>
          <li>
            <strong>Press Home/End</strong> to jump to first/last item
          </li>
          <li>
            <strong>Tab through items</strong> for keyboard accessibility
          </li>
          <li>
            <strong>Click outside</strong> to close the menu
          </li>
        </ul>
      </div>

      <div class="demo-instructions" style="margin-top: 1.5rem;">
        <h2>Features:</h2>
        <ul>
          <li>
            🎨 <strong>7 menu items</strong> positioned in a perfect circle using CSS trigonometry
          </li>
          <li>
            ✨ <strong>Framer Motion animations</strong> with staggered reveal
          </li>
          <li>
            ♿ <strong>Fully accessible</strong> with ARIA roles and keyboard support
          </li>
          <li>
            📱 <strong>Responsive design</strong> adapts to mobile screens
          </li>
          <li>
            🎯 <strong>44px touch targets</strong> for mobile accessibility
          </li>
          <li>
            🌙 <strong>Respects prefers-reduced-motion</strong> for accessibility
          </li>
          <li>
            🎭 <strong>Hand-drawn aesthetic</strong> matching Kettlebird design system
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Add RadialMenu with client:load directive for interactivity -->
  <RadialMenu client:load />
</body>
</html>
