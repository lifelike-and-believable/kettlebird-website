  .reader:not(.reader--pairs) .reader__page.is-current,
  :global(html.kb-one-page) .reader__page.is-current { view-transition-name: kb-page; }
  .reader__page img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
