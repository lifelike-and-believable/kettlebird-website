---
// Reader pages, one per comic page. The page itself is src/components/pages/ReaderPage.astro.
import ReaderPage from '../../../../components/pages/ReaderPage.astro';
import { getComicSeries } from '../../../../lib/comics/source';
import { readerPages, type ReaderPage as Entry } from '../../../../lib/comics/model';

export async function getStaticPaths() {
  const series = await getComicSeries();
  return series.flatMap((s) =>
    readerPages(s).map((entry) => ({
      params: { slug: s.slug!, chapter: String(entry.chapter.number), page: String(entry.pageNumber) },
      props: { entry, nextImage: readerPages(s).find((e) => e.path === entry.nextPath)?.page.image },
    })),
  );
}

const { entry, nextImage } = Astro.props as { entry: Entry; nextImage?: Entry['page']['image'] };
---

<ReaderPage entry={entry} nextImage={nextImage} />
