  }
  .reader.kb-still .reader__page.is-current img, .reader.kb-still .reader__panel-mask { transition: none; }

  .reader__loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    margin: 0;
    text-align: center;
    color: var(--color-ink-light);
