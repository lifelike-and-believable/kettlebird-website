---
import '../styles/global.css';
import SiteFooter from '../components/settings/SiteFooter.astro';
import { getSettings } from '../lib/site-settings-source';
import type { Settings } from '../lib/site-settings';
import type { PreviewInfo } from '../lib/preview/load';
import PreviewFrame from '../components/PreviewFrame.astro';
import { jsonLd, pageNoindex, SITE_CARD, siteHref } from '../lib/seo';

const {
  title = 'Kettlebird Creations',
  description = 'Writer & Illustrator • Star Goldberg',
  noindex = false,
  canonical,
  preview,
  structuredData,
  adult = false,
  settings: givenSettings,
  previewInfo,
} = Astro.props as {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Absolute canonical address. */
  canonical?: string;
  /** A link preview for social sites (design-comic-share-and-announce, design-site-search): the site card's
   * picture and alt text unless an image is given. */
  preview?: { title: string; description: string; image?: string; imageAlt?: string; url: string; type?: string };
  /** Structured data for search engines (docs/specs/site-search.md AC-9). */
  structuredData?: Record<string, unknown>;
  /** A ticked story's page or chapter: marked adult for safe search (site-search AC-10). */
  adult?: boolean;
  /** Site settings to use instead of the published ones: the preview route passes a draft in. */
  settings?: Settings;
  /** Only on preview pages: outlines, notes and inactive links (docs/specs/content-editing-preview.md). */
  previewInfo?: PreviewInfo;
};

const settings = givenSettings ?? (await getSettings());
// site-search AC-1: every page asks not to be listed until the site is at https://kettlebird.com.
const robotsNoindex = pageNoindex(Astro.site, noindex);
const previewImage = preview?.image ?? new URL(SITE_CARD.path, siteHref(Astro.site)).href;
const previewImageAlt = preview?.image ? preview.imageAlt : SITE_CARD.alt;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robotsNoindex && <meta name="robots" content="noindex" />}
    {adult && <meta name="rating" content="adult" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {preview && (
      <>
        <meta property="og:site_name" content="Kettlebird Creations" />
        <meta property="og:type" content={preview.type ?? 'website'} />
        <meta property="og:title" content={preview.title} />
        <meta property="og:description" content={preview.description} />
        <meta property="og:url" content={preview.url} />
        <meta property="og:image" content={previewImage} />
        <meta property="og:image:width" content={String(SITE_CARD.width)} />
        <meta property="og:image:height" content={String(SITE_CARD.height)} />
        {previewImageAlt && <meta property="og:image:alt" content={previewImageAlt} />}
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    {structuredData && <script type="application/ld+json" set:html={jsonLd(structuredData)} />}
    <!-- The site's icon: the Kettlebird bird on its own orange (design-home-tiles-and-icon). -->
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
    <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;700&family=Nunito:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class="page">
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <div class="header-inner">
        <!-- The title and subtitle are grouped so phones can put the menu button beside both; wider
             screens lay them out as before, with the links beside the subtitle (design-phone-header). -->
        <div class="header-brand">
          <a href="/" class="site-title-link" aria-label="Kettlebird Creations — Home">
            <span class="site-title">Kettlebird</span>
          </a>
          <p class="site-subtitle">Comics + Illustration</p>
        </div>
        <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle menu">
          <span class="menu-toggle-icon"></span>
        </button>
        <nav id="main-nav" class="main-nav">
          <ul class="nav-list">
            <li><a href="/portfolio" class="nav-btn">PORTFOLIO</a></li>
            <li><a href="/comics" class="nav-btn">COMICS</a></li>
            <li><a href="/writing" class="nav-btn">WRITING</a></li>
            <li><a href="/shop" class="nav-btn">SHOP</a></li>
            <li><a href="/commissions" class="nav-btn">COMMISSIONS</a></li>
            <li><a href="/about" class="nav-btn">ABOUT</a></li>
            <li><a href="/news" class="nav-btn">NEWS</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="page__content">
      <slot />
    </main>

    <SiteFooter settings={settings} />

    <script>
      const menuToggle = document.querySelector('.menu-toggle');
      const mainNav = document.querySelector('.main-nav');

      if (menuToggle && mainNav) {
        menuToggle.addEventListener('click', () => {
          const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
          menuToggle.setAttribute('aria-expanded', String(!isExpanded));
          mainNav.classList.toggle('is-open');
        });
      }
    </script>
    {previewInfo && <PreviewFrame info={previewInfo} />}
  </body>
</html>

<style>
  /* ── Torn-paper header (design-phone-header) ──
     As tall as its content at every width. The paper is drawn on a layer that reaches 2.2vw below the
     header, so the image's transparent bottom strip falls outside it and the tear is the header's
     bottom edge. The image is at least 160% of the screen's width, so every screen shows its middle
     slice, where the tear dips at both edges (wide screens used to show its high ends). */
  .site-header {
    background: none;
    position: relative;
    z-index: 100;
    overflow: visible;
    /* Suppress the border + shadow that global.css adds to .site-header */
    border-bottom: none;
    box-shadow: none;
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -2.2vw 0;
    z-index: -1;
    pointer-events: none;
    background: url('/assets/images/Paper_1_Torn.png') no-repeat center bottom / auto max(30vw, 100%);
  }

  /* Wider screens: the title, then the subtitle with the links beside it, as before. */
  .header-inner {
    max-width: 1600px;
    margin: 0 auto;
    /* 22 px between the text and the highest point of the tear, as on phones: the tear's own height
       is about 3.1vw at this image size (design-phone-header). */
    padding: 2rem 1rem max(2.25rem, calc(22px + 3.1vw));
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'title title'
      'subtitle nav';
    align-items: center;
    column-gap: 1rem;
  }

  .header-brand { display: contents; }
  .site-title-link { grid-area: title; }
  .site-subtitle { grid-area: subtitle; }
  .main-nav { grid-area: nav; justify-self: end; }

  .site-title-link {
    text-decoration: none;
    color: var(--color-ink);
    display: block;
  }

  .site-title {
    font-family: 'Nunito', sans-serif;
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.1;
    margin: 0 0 0.25rem;
    display: block;
  }

  .site-subtitle {
    font-family: 'Nunito', sans-serif;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 600;
    line-height: 1.25;
    margin: 0;
    color: var(--color-ink);
  }

  /* ── Nav buttons ── */
  .main-nav {
    display: block;
  }

  .nav-list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .nav-btn {
    font-family: 'Nunito', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.5rem 1.25rem;
    border: none;
    background-image: url('/assets/images/Highlighter_Y.png');
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position: center;
    color: var(--color-ink);
    text-decoration: none;
    display: inline-block;
    transition: transform 0.2s ease-out, filter 0.2s ease-out;
  }

  .nav-btn:hover,
  .nav-btn:focus {
    transform: scale(1.05);
    filter: brightness(1.1);
    color: var(--color-ink);
  }

  /* ── Mobile menu toggle ── */
  .menu-toggle {
    display: none;
    background: none;
    border: 2px solid var(--color-ink);
    padding: 0.5rem;
    cursor: pointer;
    width: 44px;
    height: 44px;
    position: relative;
    flex-shrink: 0;
  }

  .menu-toggle:focus {
    outline: 2px solid var(--color-dark-purple);
    outline-offset: 2px;
  }

  .menu-toggle-icon {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-ink);
    position: relative;
  }

  .menu-toggle-icon::before,
  .menu-toggle-icon::after {
    content: '';
    position: absolute;
    width: 24px;
    height: 2px;
    background: var(--color-ink);
    left: 0;
    transition: transform 0.2s ease-out;
  }

  .menu-toggle-icon::before { top: -8px; }
  .menu-toggle-icon::after  { bottom: -8px; }

  .menu-toggle[aria-expanded="true"] .menu-toggle-icon { background: transparent; }
  .menu-toggle[aria-expanded="true"] .menu-toggle-icon::before { transform: translateY(8px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] .menu-toggle-icon::after  { transform: translateY(-8px) rotate(-45deg); }

  @media (max-width: 768px) {
    .menu-toggle {
      display: block;
    }

    /* Phones and small tablets: the title and subtitle on the left, the menu button beside both; with
       enlarged text the button wraps under them. The links open as a panel under the header. */
    .header-inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem 0.75rem;
      padding: 0.875rem 1rem max(2.25rem, calc(22px + 3.1vw));
    }

    .header-brand { display: block; min-width: 0; }

    .site-title {
      font-size: min(2.5rem, 13vw);
      margin: 0;
    }

    .site-subtitle {
      font-size: 1.0625rem;
      margin-top: 0.125rem;
    }

    .main-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-beige);
      border-top: 2px solid var(--color-ink);
      border-bottom: 2px solid var(--color-ink);
      padding: 0.75rem 1rem;
      z-index: 200;
    }

    .main-nav.is-open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      gap: 0.4rem;
    }

    .nav-btn {
      display: block;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-btn:hover,
    .nav-btn:focus,
    .site-logo:hover .logo-text,
    .site-logo:focus .logo-text {
      transform: none;
    }
  }
</style>
