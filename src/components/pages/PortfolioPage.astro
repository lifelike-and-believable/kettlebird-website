---
// The portfolio. Rendered by src/pages/portfolio.astro and by the preview route
// (docs/specs/content-editing-preview.md), which can move to a piece or open it.
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { PreviewInfo } from '../../lib/preview/load';
import GalleryGrid from '../GalleryGrid';
import type { GalleryItem } from '../../lib/queries';
import { canonicalUrl, siteHref } from '../../lib/seo';
import { featuredPiece, portfolioPreviewImage } from '../../lib/portfolio-preview';
import { buildFolders, subfolderDescription, subfolderPath, subfolderTitle, type Subfolder } from '../../lib/portfolio/folders';

const { items, subfolders = [], openSubfolder, focusId, openId, preview = false } = Astro.props as {
  items: GalleryItem[];
  subfolders?: Subfolder[];
  /** A subfolder's own page (portfolio-folders AC-12, AC-14), or its Preview. */
  openSubfolder?: string;
  focusId?: string;
  openId?: string;
  preview?: boolean;
};
/** In the preview route: what the preview shows and outlines (docs/specs/content-editing-preview.md). */
const previewInfo = (Astro.props as { previewInfo?: PreviewInfo }).previewInfo;
// site-search AC-4 to AC-8: the canonical address and link preview.
// A subfolder's page has its own (portfolio-folders AC-14).
const opened = openSubfolder ? buildFolders(items, subfolders).flatMap((v) => v.subfolders.map((s) => ({ ...s, folder: v.folder }))).find((s) => s.subfolder._id === openSubfolder) : undefined;
const pageTitle = opened ? subfolderTitle(opened.subfolder.name, opened.folder.title) : 'Portfolio • Kettlebird Creations';
const pageDescription = opened
  ? subfolderDescription(opened.subfolder.name, opened.folder.title, opened.pieces.length)
  : 'Illustrations, fanart, original characters, and commissioned work by Star Goldberg (Kettlebird).';
const canonical = canonicalUrl(siteHref(Astro.site), (opened && subfolderPath(opened.subfolder)) || '/portfolio');
const piece = opened ? opened.pieces[0] : featuredPiece(items);
const picture = piece && portfolioPreviewImage(piece);
---


<BaseLayout
  previewInfo={previewInfo}
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  preview={{ title: pageTitle, description: pageDescription, url: canonical, image: picture?.image, imageAlt: picture?.alt }}
>
  <section class="portfolio-page">
    <header class="portfolio-header">
      <h1 class="page-title portfolio-title">Portfolio</h1>
      <p class="portfolio-subtitle">Illustrations, fanart, and original characters</p>
    </header>

    <GalleryGrid items={items} subfolders={subfolders} openSubfolder={openSubfolder} focusId={focusId} openId={openId} preview={preview} client:load />
  </section>
</BaseLayout>

<style>
  .portfolio-page {
    /* full-bleed bands handle their own width; no horizontal padding here */
    padding: 0 0 4rem;
  }

  .portfolio-header {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1rem 0;
  }

  .portfolio-title {
    margin: 0 0 0.25rem;
  }

  .portfolio-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.1rem;
    color: var(--color-dark-purple, #4a4063);
    margin: 0;
  }

  /* ── Folders (docs/design/portfolio-folders.md; docs/specs/portfolio-folders.md AC-1 to AC-8) ── */
  :global(.folder-stack) {
    display: flex;
    flex-direction: column;
    /* Edge to edge: past the main column's 1rem padding (global.css .page__content). */
    margin-inline: -1rem;
    /* Room for the first folder's tab, which rises 2.25rem above its edge. */
    padding-top: 3.4rem;
    --kraft: #c4a274;
    --kraft-dark: #b8956a;
  }

  /* A folder: its tabs, then its kraft body. The body overlaps the one above, with a fine contact line
     and a soft shadow cast upward (AC-2). The tabs are in the page's flow, their first line over the
     folder above, so a tab whose words wrap pushes its own folder down rather than covering the one
     above. The row's height is 9/16 of the folder's width, at most 240 px (AC-3;
     portfolio-size AC-1). */
  :global(.folder-section) {
    position: relative;
    display: flex;
    flex-direction: column;
    margin-top: -0.3rem;
  }
  :global(.folder-body) {
    position: relative;
    container-type: inline-size;
    padding: 1.5rem 0 3rem;
    background-color: var(--kraft);
    background-image: url('/assets/images/Paper_2_Tileable.png');
    background-size: 420px;
    background-blend-mode: multiply;
    box-shadow:
      0 -1px 0 rgba(0, 0, 0, 0.16),
      0 -6px 12px -4px rgba(0, 0, 0, 0.28);
  }
  :global(.folder-section:nth-child(even) .folder-body) { background-color: var(--kraft-dark); }

  /* The tabs, on the folder's top edge on its section's fixed side; one line high above the edge. */
  :global(.folder-tabs) {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 0.6rem;
    align-items: flex-end;
    max-width: calc(100% - 5rem);
    margin: -2.25rem 4rem -0.05rem;
  }
  :global(.folder--right .folder-tabs) { align-self: flex-end; flex-direction: row-reverse; }
  :global(.folder--left .folder-tabs) { align-self: flex-start; }

  /* The tab's paper is drawn on ::before, tilted back so its sides slant in a little while its top
     corners stay rounded (the lead's choices, 2026-11-08). The phone's sizes at every width
     (portfolio-size AC-3). */
  :global(.folder-tab) {
    --tab-bg: var(--kraft);
    --tilt: 70px;
    position: relative;
    isolation: isolate;
    padding: 0.4rem 1.2rem 0.35rem;
    font-family: 'DM Mono', monospace;
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: var(--color-ink, #2b2b2b);
    overflow-wrap: break-word;
    min-width: 0;
  }
  :global(.folder-section:nth-child(even) .folder-tab:not(.folder-tab--index)) { --tab-bg: var(--kraft-dark); }
  :global(.folder-tab::before) {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--tab-bg);
    background-image: url('/assets/images/Paper_2_Tileable.png');
    background-size: 420px;
    background-blend-mode: multiply;
    border-radius: 14px 14px 0 0;
    transform: perspective(var(--tilt)) rotateX(9deg);
    transform-origin: bottom;
    box-shadow:
      0 -1px 0 rgba(0, 0, 0, 0.16),
      0 -5px 10px -4px rgba(0, 0, 0, 0.28),
      -4px -2px 8px -5px rgba(0, 0, 0, 0.25),
      4px -2px 8px -5px rgba(0, 0, 0, 0.25);
  }
  :global(.folder-tab--open) { --tilt: 220px; }
  :global(.folder-tab--index) {
    /* The highlighter pink of today's Index label, light enough for ink at any size (4.5:1). */
    --tab-bg: #e88ab9;
    flex: none;
    font-size: 1.1rem;
    padding: 0.35rem 1rem 0.3rem;
    text-decoration: none;
  }
  :global(.folder-tab--index:focus-visible) { outline: 2px solid var(--color-dark-purple, #4a4063); outline-offset: 2px; }

  /* ── The row (AC-3, AC-5) ─────────────────────────────────── */
  :global(.folder-row) {
    position: relative;
    height: min(100cqw * 9 / 16, 240px);
  }
  :global(.carousel__track) {
    display: flex;
    gap: 1.1rem;
    height: calc(100% + 12px);
    margin-block: -6px;
    padding: 6px 5.5rem;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    box-sizing: border-box;
  }
  :global(.carousel__track::-webkit-scrollbar) { display: none; }
  :global(.carousel__arrow) {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    z-index: 2;
  }
  :global(.carousel__arrow--left) { left: 1.25rem; }
  :global(.carousel__arrow--right) { right: 1.25rem; }
  :global(.folder-row--empty) { display: flex; align-items: center; padding: 0 5.5rem; }

  /* A piece: whole, at its own shape, at the row's height, with a paper edge and a soft shadow. */
  :global(.gallery-card) {
    position: relative;
    flex: none;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--color-beige, #f5f1e8);
    box-shadow: 0 0 0 3px var(--color-beige, #f5f1e8), 0 2px 6px 3px rgba(0, 0, 0, 0.25);
    cursor: pointer;
  }
  :global(.gallery-card:focus-visible) { outline: 3px solid var(--color-dark-purple, #4a4063); outline-offset: 5px; }
  :global(.gallery-card__img) { display: block; height: 100%; width: auto; }
  :global(.gallery-card__placeholder) {
    height: 100%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    background: var(--color-yellow, #f4ce6a);
  }
  :global(.gallery-card__overlay) {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    padding: 1.5rem 0.75rem 0.6rem;
    opacity: 0;
    transition: opacity 0.2s;
    text-align: left;
  }
  :global(.gallery-card:hover .gallery-card__overlay),
  :global(.gallery-card:focus-visible .gallery-card__overlay) { opacity: 1; }
  :global(.gallery-card__title) { font-family: 'DM Mono', monospace; font-weight: 500; font-size: 0.85rem; color: #fff; }

  /* A subfolder's thumbnail: a square at the row's height, its grid of pieces, its name under it (AC-8). */
  :global(.subfolder-card) {
    flex: none;
    height: 100%;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    background: var(--color-beige, #f5f1e8);
    box-shadow: 0 0 0 3px var(--color-beige, #f5f1e8), 0 2px 6px 3px rgba(0, 0, 0, 0.25);
    color: var(--color-ink, #2b2b2b);
    text-decoration: none;
  }
  :global(.subfolder-card:focus-visible) { outline: 3px solid var(--color-dark-purple, #4a4063); outline-offset: 5px; }
  :global(.subfolder-grid) {
    flex: 1;
    min-height: 0;
    display: grid;
    gap: 3px;
    aspect-ratio: 1;
  }
  :global(.subfolder-grid[data-size='2']) { grid-template: repeat(2, minmax(0, 1fr)) / repeat(2, minmax(0, 1fr)); }
  :global(.subfolder-grid[data-size='3']) { grid-template: repeat(3, minmax(0, 1fr)) / repeat(3, minmax(0, 1fr)); }
  :global(.subfolder-grid__cell) { min-height: 0; background: #ebe4d4; overflow: hidden; }
  :global(.subfolder-grid__cell img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  :global(.subfolder-card__name) {
    font-family: 'DM Mono', monospace;
    font-weight: 500;
    font-size: 0.85rem;
    padding: 0.2rem 0.4rem;
    text-align: center;
    overflow-wrap: break-word;
  }

  /* ── Phones (AC-3, AC-5, AC-8, AC-16) ─────────────────────── */
  @media (max-width: 639px) {
    :global(.folder-body) { padding: 1.4rem 0 3rem; }
    :global(.folder-tabs) { margin: -2.25rem 1rem -0.05rem; max-width: calc(100% - 2rem); }
    :global(.folder-tab--open) { font-size: 1.15rem; }
    :global(.folder-row) { margin-bottom: 4rem; }
    :global(.carousel__track) { padding: 6px 0; gap: 0.6rem; }
    :global(.carousel__arrow) { top: auto; bottom: -3.6rem; transform: none; }
    :global(.carousel__arrow--left) { left: 1rem; }
    :global(.carousel__arrow--right) { right: 1rem; }
    :global(.folder-row--empty) { padding: 0 1rem; }
    /* At most 2 × 2 on a phone. */
    :global(.subfolder-grid[data-size]) { grid-template: repeat(2, minmax(0, 1fr)) / repeat(2, minmax(0, 1fr)); }
    :global(.subfolder-grid__cell:nth-child(n + 5)) { display: none; }
  }

  :global(.gallery-empty) {
    font-family: 'DM Mono', monospace;
    font-size: 1rem;
    padding: 1rem 0;
    color: var(--color-ink, #2b2b2b);
  }

  /* Empty portfolio: the message and a way on to Star's social profiles (design-clear-placeholders). */
  :global(.gallery-empty-state) {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  :global(.gallery-empty__more) {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
  }

  :global(.gallery-empty__more a) {
    color: var(--color-ink, #2b2b2b);
    font-weight: 700;
  }

  /* ── Lightbox ─────────────────────────────────────────────── */
  :global(.lightbox) {
    position: fixed;
    inset: 0;
    background: rgba(43, 43, 43, 0.85);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  :global(.lightbox__inner) {
    background: var(--color-beige, #f5f1e8);
    border: 3px solid var(--color-ink, #2b2b2b);
    max-width: 900px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  :global(.lightbox__close) {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: var(--color-ink, #2b2b2b);
    color: var(--color-beige, #f5f1e8);
    border: none;
    font-size: 1rem;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    z-index: 1;
  }

  :global(.lightbox__img) {
    width: 100%;
    height: auto;
    display: block;
    max-height: 65vh;
    object-fit: contain;
    background: var(--color-ink, #2b2b2b);
  }

  :global(.lightbox__info) {
    padding: 1.25rem;
  }

  :global(.lightbox__title) {
    font-family: 'Nunito', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }

  :global(.lightbox__description) {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  :global(.lightbox__tags) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  :global(.lightbox__tag) {
    font-family: 'DM Mono', monospace;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    border: 2px solid var(--color-ink, #2b2b2b);
    background: var(--color-yellow, #f4ce6a);
  }

  /* ── Full screen (docs/design/portfolio-full-screen.md) ─────────────────── */
  :global(.lightbox__pic) { position: relative; background: var(--color-ink, #2b2b2b); }
  :global(.lightbox__pic .lightbox__img) { cursor: zoom-in; }
  :global(.lightbox__full) {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0.35rem 0.75rem;
    background: var(--color-beige, #f5f1e8);
    color: var(--color-ink, #2b2b2b);
    border: 2px solid var(--color-ink, #2b2b2b);
    font: 700 0.95rem 'Nunito', sans-serif;
    cursor: pointer;
  }
  :global(.lightbox__full:focus-visible) { outline: 3px solid var(--color-beige, #f5f1e8); outline-offset: 3px; box-shadow: 0 0 0 6px #4a4063; }
  @media (max-width: 699px) {
    :global(.lightbox__full) { padding: 0; width: 44px; }
    :global(.lightbox__full-label) { display: none; }
  }

  :global(.fs) {
    position: fixed;
    inset: 0;
    z-index: 2000;
    height: 100dvh;
    background: #161616;
    color: #f5f1e8;
    overflow: hidden;
    touch-action: none;
    user-select: none;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  }
  :global(.fs:focus) { outline: none; }
  :global(.fs__stage) { position: absolute; overflow: hidden; cursor: grab; }
  :global(.fs__stage.is-full) { inset: 0; }
  :global(.fs__img) { position: absolute; max-width: none; object-fit: contain; transform-origin: center; pointer-events: none; -webkit-user-drag: none; }
  /* The phone's own image long-press (save, drag and drop) would take over a held finger. */
  :global(.fs__stage), :global(.fs__img) { -webkit-touch-callout: none; }
  :global(.fs__img--ease) { transition: transform 0.2s ease-out; }
  :global(.fs__failed) { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; margin: 0; font: 600 1.1rem 'Nunito', sans-serif; }
  :global(.fs__loading) {
    position: absolute; left: 50%; top: 50%; width: 32px; height: 32px; margin: -16px;
    border: 3px solid #f5f1e855; border-top-color: #f5f1e8; border-radius: 50%;
    animation: fs-spin 0.9s linear infinite;
  }
  @keyframes fs-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { :global(.fs__loading) { animation: none; } }

  :global(.fs__controls) { transition: opacity 0.2s; }
  :global(.fs__controls[data-hidden='true']) { opacity: 0; pointer-events: none; }
  :global(.fs__top) {
    position: absolute; top: 0; left: 0; right: 0; height: 60px; z-index: 2;
    display: flex; align-items: center; gap: 1rem; padding: 0.5rem 0.5rem 0.5rem 1rem;
    background: #161616; border-bottom: 1px solid #f5f1e833;
  }
  :global(.fs__title) { flex: 1; min-width: 0; font: 700 1.05rem 'Nunito', sans-serif; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :global(.fs__count) { font: 500 0.9rem 'DM Mono', monospace; white-space: nowrap; }
  :global(.fs__btn) {
    min-width: 44px; min-height: 44px; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    background: #161616; color: #f5f1e8; border: 2px solid #f5f1e8; font: 700 1.1rem 'Nunito', sans-serif; cursor: pointer;
  }
  :global(.fs__btn:focus-visible) { outline: 3px solid #f4ce6a; outline-offset: 2px; }
  :global(.fs__btn.is-off) { border-style: dashed; border-color: #f5f1e877; color: #f5f1e877; cursor: default; }
  :global(.fs__close) { flex-direction: row; padding: 0 0.75rem; background: #f5f1e8; color: #2b2b2b; font-size: 0.95rem; }
  /* Previous and Next: the arrow button on dark (docs/design/arrows.md), growing to fit its caption. */
  :global(.fs__side) { position: absolute; z-index: 2; min-width: 56px; min-height: 72px; padding: 4px 8px; }
  :global(.fs__cap) { font: 600 0.7rem 'Nunito', sans-serif; white-space: nowrap; }
  :global(.fs--wide .fs__side), :global(.fs__side) { top: 50%; transform: translateY(-50%); }
  :global(.fs__side--prev) { left: 0.5rem; }
  :global(.fs__side--next) { right: 0.5rem; }
  :global(.fs__bottom) { position: absolute; left: 0; right: 0; bottom: 0; height: 76px; z-index: 1; background: #161616; border-top: 1px solid #f5f1e833; }
  :global(.fs__zoom) {
    position: absolute; z-index: 2; bottom: 0.75rem; left: 50%; transform: translateX(-50%);
    display: flex; align-items: center; gap: 0.25rem; padding: 0.25rem; background: #161616; border: 2px solid #f5f1e8;
  }
  :global(.fs__zoom .fs__btn) { border-color: transparent; }
  :global(.fs__zoom .fs__btn.is-off) { border-color: #f5f1e877; }
  :global(.fs__level) { font: 500 0.85rem 'DM Mono', monospace; min-width: 4.5em; text-align: center; }
  :global(.fs__fit) { font-size: 0.85rem; }
  :global(.fs__map) { position: absolute; z-index: 2; right: 0.75rem; bottom: 0.75rem; width: 120px; border: 2px solid #f5f1e8; background: #000; }
  :global(.fs__map img) { display: block; width: 100%; opacity: 0.55; }
  :global(.fs__map i) { position: absolute; border: 2px solid #f4ce6a; }
  /* A phone held upright: Previous and Next in the bottom bar. */
  @media (max-width: 699px) and (orientation: portrait) {
    :global(.fs__side) { top: auto; bottom: 5px; transform: none; min-height: 66px; }
    :global(.fs__zoom) { bottom: 0.5rem; }
  }
</style>
