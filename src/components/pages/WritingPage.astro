---
// The Writing page. Rendered by src/pages/writing.astro and by the preview route
// (docs/specs/content-editing-preview.md). Cards from the story model: a story with a page has Read,
// and its title and cover link to it (docs/specs/story-reader-pages.md AC-2).
import Lines from '../Lines.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { PreviewInfo } from '../../lib/preview/load';
import { alsoOn, cardLine, hasPage, ratingLine, sortForWriting, storyPath, type Story } from '../../lib/stories/model';

const { stories } = Astro.props as { stories: Story[] };
const works = sortForWriting(stories);

const GENRE_COLORS = ['--color-yellow', '--color-green', '--color-orange'];
/** In the preview route: what the preview shows and outlines (docs/specs/content-editing-preview.md). */
const previewInfo = (Astro.props as { previewInfo?: PreviewInfo }).previewInfo;
---


<BaseLayout
  previewInfo={previewInfo}
  title="Writing • Kettlebird Creations"
  description="Fiction, fanfiction, and other written works by Star Goldberg (Kettlebird)."
>
  <section class="writing-page">
    <header class="page-header">
      <h1 class="page-title">Writing</h1>
      <p class="page-subtitle">Fiction, fanfic, and other words</p>
    </header>

    {works.length === 0 ? (
      <div class="empty-state">
        <p class="empty-state__text">Stories coming soon — check back shortly!</p>
        <div class="empty-state__doodle" aria-hidden="true">✍️</div>
      </div>
    ) : (
      <ul class="works-list">
        {works.map((work) => {
          const page = hasPage(work) ? storyPath(work.slug!) : undefined;
          const rating = ratingLine(work.rating);
          const line = cardLine(work);
          const cover = work.cover
            ? <img src={work.cover.src} srcset={work.cover.srcset} sizes="200px" alt="" class="work-card__img" width={work.cover.width} height={work.cover.height} loading="lazy" />
            : <div class="work-card__cover-placeholder" aria-hidden="true">📖</div>;

          return (
            <li class="work-card" id={`item-${work.id}`} data-part={`item-${work.id}`}>
              <div class="work-card__cover">
                {page ? <a href={page} tabindex="-1" aria-hidden="true">{cover}</a> : cover}
              </div>
              <div class="work-card__body">
                <h2 class="work-card__title">{page ? <a href={page}>{work.title}</a> : work.title}</h2>
                {(work.genres.length > 0 || rating) && (
                  <ul class="tag-list" aria-label="About this story">
                    {work.genres.map((g, i) => (
                      <li class="tag" style={`background: var(${GENRE_COLORS[i % GENRE_COLORS.length]})`}>{g}</li>
                    ))}
                    {rating && <li class="tag tag--rating">{rating}</li>}
                  </ul>
                )}
                {line && <p class="work-card__line">{line}</p>}
                {work.description && <p class="work-card__excerpt"><Lines text={work.description} /></p>}
                <div class="work-card__actions">
                  {page && <a href={page} class="btn">Read</a>}
                  {page && work.link && (
                    <a href={work.link} target="_blank" rel="noopener noreferrer" class="work-card__also">{alsoOn(work.link)}</a>
                  )}
                  {!page && work.link && (
                    <a href={work.link} target="_blank" rel="noopener noreferrer" class="btn">
                      Read it →
                    </a>
                  )}
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .work-card__title a { color: inherit; }
  .work-card__line { margin: 0.25rem 0; font-family: 'DM Mono', monospace; font-size: 0.9rem; }
  .tag--rating { background: var(--color-beige); }
  .work-card__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
  .work-card__also { font-family: 'Nunito', sans-serif; font-weight: 700; color: var(--color-ink); }
  .work-card__cover a { display: block; height: 100%; }

  .writing-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    margin: 0 0 0.25rem;
  }

  .page-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.1rem;
    color: var(--color-dark-purple, #4a4063);
    margin: 0;
  }

  /* ── Empty state ── */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 5rem 1rem;
    border: 3px dashed var(--color-dark-purple, #4a4063);
    text-align: center;
  }

  .empty-state__text {
    font-family: 'Nunito', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-dark-purple, #4a4063);
    margin: 0;
  }

  .empty-state__doodle {
    font-size: 3rem;
  }

  /* ── Works list ── */
  .works-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .work-card {
    display: grid;
    /* minmax(0, …): a card never makes the page scroll sideways (story-reader-pages AC-13). */
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 1.5rem;
    border: 3px solid var(--color-ink, #2b2b2b);
    background: var(--color-beige, #f5f1e8);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .work-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 rgba(0,0,0,0.12);
  }

  .work-card__cover {
    aspect-ratio: 5/7;
    overflow: hidden;
    border-right: 3px solid var(--color-ink, #2b2b2b);
    flex-shrink: 0;
  }

  .work-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .work-card__cover-placeholder {
    width: 100%;
    height: 100%;
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    background: var(--color-green, #a8d5ba);
  }

  .work-card__body {
    padding: 1.25rem 1.25rem 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .work-card__title {
    font-family: 'Nunito', sans-serif;
    font-size: clamp(1.2rem, 3vw, 1.75rem);
    font-weight: 700;
    margin: 0;
  }

  .tag-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: 'Nunito', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border: 2px solid var(--color-ink, #2b2b2b);
  }

  .work-card__excerpt {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    color: var(--color-ink, #2b2b2b);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .work-card__actions {
    margin-top: auto;
  }

  .btn {
    font-family: 'Nunito', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.5rem 1.25rem;
    border: 2px solid var(--color-ink, #2b2b2b);
    background: var(--color-ink, #2b2b2b);
    color: var(--color-beige, #f5f1e8);
    text-decoration: none;
    display: inline-block;
    transition: background 0.15s, color 0.15s, transform 0.15s;
  }

  .btn:hover {
    background: var(--color-dark-purple, #4a4063);
    transform: translate(-1px, -1px);
  }

  @media (max-width: 540px) {
    .work-card {
      grid-template-columns: minmax(0, 1fr);
    }

    .work-card__cover {
      border-right: none;
      border-bottom: 3px solid var(--color-ink, #2b2b2b);
      aspect-ratio: 16/9;
    }

    .work-card__body {
      padding: 1rem;
    }
  }
</style>
