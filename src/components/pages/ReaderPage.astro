    justify-content: center;
    gap: 2px;
    min-height: 56px;
    padding: 0.25rem 0;
  }
  .reader__control-caption {
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 0.8rem;
    line-height: 1.1;
    text-align: center;
