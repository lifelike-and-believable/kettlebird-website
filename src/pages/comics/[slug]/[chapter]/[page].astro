---
// Reader page: one comic page, with Back to series, All pages, the location line, and the
// player-style controls. Designs: docs/design/comic-start-reading.md, docs/design/comic-turn-pages.md,
// docs/design/comic-sheet-and-controls.md (which replaces the Previous page / Next page pair).
// Specs: docs/specs/comic-reader-start-and-turn.md, docs/specs/comic-reader-sheet-and-controls.md.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getComicSeries } from '../../../../lib/comics/source';
import {
  endNote,
  locationLine,
  pageAltText,
  readerPages,
  seriesPath,
  tabTitle,
  type ReaderPage,
} from '../../../../lib/comics/model';
import { allPagesHref, playControls, type ControlKind } from '../../../../lib/comics/navigation';
import { pageAnnouncement, pagePreview, shareTitle } from '../../../../lib/comics/sharing';

export async function getStaticPaths() {
  const series = await getComicSeries();
  return series.flatMap((s) =>
    readerPages(s).map((entry) => ({
      params: { slug: s.slug!, chapter: String(entry.chapter.number), page: String(entry.pageNumber) },
      props: { entry, nextImage: readerPages(s).find((e) => e.path === entry.nextPath)?.page.image },
    })),
  );
}

const { entry, nextImage } = Astro.props as { entry: ReaderPage; nextImage?: ReaderPage['page']['image'] };
const back = seriesPath(entry.series.slug!);
const image = entry.page.image;
const end = entry.isLast ? endNote(entry.series.status) : undefined;
const controls = playControls(entry);
const allPages = allPagesHref(entry);
const preview = { ...pagePreview(entry, Astro.site!.href), type: 'article' };
// Drawn arrowheads: phones draw characters like ⏭ as emoji of their own (design, Layout).
const ICONS: Record<ControlKind, { viewBox: string; d: string }> = {
  first: { viewBox: '0 0 32 24', d: 'M30 4 L18 12 L30 20 Z M16 4 L4 12 L16 20 Z' },
  previous: { viewBox: '0 0 24 24', d: 'M17 4 L5 12 L17 20 Z' },
  next: { viewBox: '0 0 24 24', d: 'M7 4 L19 12 L7 20 Z' },
  newest: { viewBox: '0 0 32 24', d: 'M2 4 L14 12 L2 20 Z M16 4 L28 12 L16 20 Z' },
};
const TURNS: Partial<Record<ControlKind, string>> = { previous: 'previous', next: 'next' };
---

<BaseLayout
  title={tabTitle(entry)}
  description={`${entry.series.title}, a comic by Star Goldberg.`}
  canonical={preview.url}
  preview={preview}
>
  <!-- Don't draw the page until the scroll below has run, so the site header never flashes on a
       turn, even when the page arrives in pieces. Browsers without render-blocking ignore it. -->
  <link slot="head" rel="expect" href="#reader-scrolled" {...{ blocking: 'render' }} />
  <div class="reader">
    <div class="reader__bar">
      <a href={back} class="reader__back">Back to series</a>
      {allPages && (
        <a href={allPages} class="reader__all" aria-label="All pages in this chapter">
          <span class="reader__grid" aria-hidden="true">{Array.from({ length: 9 }, () => <i></i>)}</span>
          All pages
        </a>
      )}
      <h1 class="reader__location">{locationLine(entry)}</h1>
    </div>

    <div class="reader__page" data-reader-page style={`aspect-ratio: ${image.width} / ${image.height}; --page-ratio: ${(image.width / image.height).toFixed(4)};`}>
      <p class="reader__loading">Loading page… If it doesn't appear, try refreshing.</p>
      <img
        src={image.src}
        srcset={image.srcset}
        sizes="(max-width: 700px) 100vw, 900px"
        width={image.width}
        height={image.height}
        alt={pageAltText(entry)}
        decoding="async"
      />
      {entry.previousPath && (
        <a href={entry.previousPath} class="reader__edge reader__edge--prev" aria-hidden="true" tabindex="-1">‹</a>
      )}
      {entry.nextPath && (
        <a href={entry.nextPath} class="reader__edge reader__edge--next" aria-hidden="true" tabindex="-1">›</a>
      )}
    </div>

    {controls.length > 0 && (
      <div class="reader__controls-box">
        <nav class="reader__controls" aria-label="Page navigation">
          {controls.map((c) => {
            const icon = ICONS[c.kind];
            const body = (
              <>
                <svg viewBox={icon.viewBox} width={c.kind === 'first' || c.kind === 'newest' ? 30 : 26} height="24" aria-hidden="true" focusable="false">
                  <path d={icon.d} fill="currentColor" />
                </svg>
                <span class="reader__control-caption">{c.caption}</span>
                <span class="reader__control-tip" aria-hidden="true">{c.name}</span>
              </>
            );
            return c.path ? (
              <a
                href={c.path}
                class={`reader__control reader__control--${c.kind}`}
                aria-label={c.name}
                rel={c.kind === 'previous' ? 'prev' : c.kind === 'next' ? 'next' : undefined}
                data-turn={TURNS[c.kind]}
                data-control={c.kind}
              >{body}</a>
            ) : (
              <a
                role="link"
                aria-disabled="true"
                aria-label={c.name}
                tabindex="-1"
                data-control={c.kind}
                class={`reader__control reader__control--${c.kind} is-off`}
              >{body}</a>
            );
          })}
        </nav>
      </div>
    )}
    {end && (
      <div class="reader__end">
        <p class="reader__end-heading">{end.heading}</p>
        <p>{end.line}</p>
        <a href={back}>Back to series</a>
      </div>
    )}

    <!-- Share this page (design-comic-share-and-announce): needs a script, so it's shown by one. -->
    <div class="reader__share" data-share hidden>
      <button type="button" class="reader__share-button" data-share-button data-url={preview.url} data-title={shareTitle(entry)}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <circle cx="18" cy="5" r="3" fill="currentColor" /><circle cx="6" cy="12" r="3" fill="currentColor" /><circle cx="18" cy="19" r="3" fill="currentColor" />
          <path d="M8.6 10.7 L15.4 6.4 M8.6 13.3 L15.4 17.6" stroke="currentColor" stroke-width="2" />
        </svg>
        <span data-share-label>Share this page</span>
      </button>
      <p class="visually-hidden" role="status" data-share-status></p>
      <p class="reader__copy" data-copy hidden>
        <label for="copy-link">Copy this link:</label>
        <input id="copy-link" type="text" readonly value={preview.url} />
      </p>
    </div>
    <!-- What a screen reader hears when the page opens; filled in by the script below. -->
    <p class="visually-hidden" role="status" data-announce data-text={pageAnnouncement(entry)}></p>
  </div>

  <script is:inline>
    // Open with the reader bar at the top of the window, past the site header, so the whole page
    // shows and the next page appears without scrolling back up (design-comic-turn-pages). Inline,
    // right after the reader, and the page isn't drawn until the marker after it is parsed (the
    // render-blocking link above): otherwise the header can flash on screen at a turn. Skipped if
    // the fan has already scrolled; without a script the page simply starts at the top.
    if (window.scrollY === 0) document.querySelector('.reader')?.scrollIntoView({ block: 'start' });
  </script>
  <span id="reader-scrolled" hidden></span>

  {nextImage && <meta name="kb-next-image" content={nextImage.src} data-srcset={nextImage.srcset ?? ''} />}

  <script>
    import { announcesOnOpen, focusAfterTurn, type NavigationKind, type RememberedTurn } from '../../../../lib/comics/sharing';

    // Arrow keys and swipes follow the same links as Previous page and Next page
    // (design-comic-turn-pages, "How a page turn works"). Reading never needs this script.
    const link = (which: 'previous' | 'next') =>
      document.querySelector<HTMLAnchorElement>(`[data-turn="${which}"]`);
    const zoomed = () => (window.visualViewport?.scale ?? 1) > 1.01;

    document.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey || zoomed()) return;
      const t = e.target as HTMLElement | null;
      if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
      const target = e.key === 'ArrowRight' ? link('next') : e.key === 'ArrowLeft' ? link('previous') : null;
      if (target) {
        e.preventDefault();
        location.assign(target.href); // not a click: arrow keys don't move focus (design-comic-share-and-announce)
      }
    });

    const area = document.querySelector<HTMLElement>('[data-reader-page]');
    let start: { x: number; y: number } | null = null;
    area?.addEventListener('pointerdown', (e) => {
      start = e.pointerType === 'touch' && !zoomed() ? { x: e.clientX, y: e.clientY } : null;
    });
    area?.addEventListener('pointerup', (e) => {
      if (!start || e.pointerType !== 'touch') return;
      const dx = e.clientX - start.x;
      const dy = e.clientY - start.y;
      start = null;
      // A turn needs a clearly horizontal swipe; mostly vertical movement is scrolling.
      if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5 || zoomed()) return;
      const to = dx < 0 ? link('next') : link('previous');
      if (to) location.assign(to.href);
    });

    // After a turn with a control, focus that control on the new page; announce each page as it
    // opens, except on a reload (design-comic-share-and-announce, Accessibility).
    const TURN_KEY = 'kb-turn';
    const navigation = ((performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type ??
      'navigate') as NavigationKind;
    let remembered: RememberedTurn | undefined;
    try {
      remembered = JSON.parse(sessionStorage.getItem(TURN_KEY) ?? 'null') ?? undefined;
      sessionStorage.removeItem(TURN_KEY);
    } catch {
      remembered = undefined;
    }
    let referrerPath: string | undefined;
    try {
      const from = new URL(document.referrer);
      referrerPath = from.origin === location.origin ? from.pathname : undefined;
    } catch {
      referrerPath = undefined;
    }
    const kind = focusAfterTurn(remembered, { navigation, referrerPath, time: Date.now() });
    if (kind) document.querySelector<HTMLElement>(`[data-control="${kind}"]`)?.focus({ preventScroll: true });

    document.querySelectorAll<HTMLAnchorElement>('a[data-control][href]').forEach((control) => {
      control.addEventListener('click', () => {
        const turn: RememberedTurn = { kind: control.dataset.control as RememberedTurn['kind'], from: location.pathname, at: Date.now() };
        try {
          sessionStorage.setItem(TURN_KEY, JSON.stringify(turn));
        } catch {
          // Storage refused: the turn still happens, without keeping focus.
        }
      });
    });

    const announce = document.querySelector<HTMLElement>('[data-announce]');
    if (announce && announcesOnOpen(navigation)) {
      const fill = () => setTimeout(() => { announce.textContent = announce.dataset.text ?? ''; }, 500);
      if (document.readyState === 'complete') fill();
      else window.addEventListener('load', fill, { once: true });
    }

    // Share this page: the share menu on touch screens, otherwise copy; copy by hand if that fails.
    const shareBox = document.querySelector<HTMLElement>('[data-share]');
    const shareButton = document.querySelector<HTMLButtonElement>('[data-share-button]');
    if (shareBox && shareButton) {
      shareBox.hidden = false;
      const label = shareButton.querySelector<HTMLElement>('[data-share-label]')!;
      const status = shareBox.querySelector<HTMLElement>('[data-share-status]')!;
      const copyBox = shareBox.querySelector<HTMLElement>('[data-copy]')!;
      const url = shareButton.dataset.url!;
      let reset: ReturnType<typeof setTimeout> | undefined;
      const copied = () => {
        label.textContent = 'Link copied';
        status.textContent = 'Link copied';
        shareButton.classList.add('is-done');
        clearTimeout(reset);
        reset = setTimeout(() => {
          label.textContent = 'Share this page';
          status.textContent = '';
          shareButton.classList.remove('is-done');
        }, 4000);
      };
      shareButton.addEventListener('click', async () => {
        if (typeof navigator.share === 'function' && matchMedia('(pointer: coarse)').matches) {
          try {
            await navigator.share({ title: shareButton.dataset.title, url });
            return;
          } catch (error) {
            if ((error as DOMException | undefined)?.name === 'AbortError') return;
          }
        }
        try {
          await navigator.clipboard.writeText(url);
          copied();
        } catch {
          copyBox.hidden = false;
          const input = copyBox.querySelector('input')!;
          input.focus();
          input.select();
        }
      });
    }

    // Fetch the next page's image after this one loads, unless the browser asks to save data.
    const next = document.querySelector<HTMLMetaElement>('meta[name="kb-next-image"]');
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    if (next && !saveData) {
      window.addEventListener('load', () => {
        const img = new Image();
        img.sizes = '(max-width: 700px) 100vw, 900px';
        if (next.dataset.srcset) img.srcset = next.dataset.srcset;
        img.src = next.content;
      });
    }
  </script>
</BaseLayout>

<style>
  .reader {
    scroll-margin-top: 0;
    max-width: 960px;
    margin: 0 auto;
    padding: 0.5rem 0.5rem 2rem;
  }
  /* The page around the reader already has side padding; on a narrow phone, don't add more, so the
     controls' captions fit even with enlarged text. */
  @media (max-width: 480px) {
    .reader { padding-inline: 0; }
  }

  .reader__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.5rem 0.25rem;
  }
  .reader__back { font-family: 'Nunito', sans-serif; font-weight: 700; color: var(--color-ink); }
  .reader__all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.3rem 0.6rem;
    border: 2px solid var(--color-ink);
    background: var(--color-beige);
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
  }
  .reader__grid { display: inline-grid; grid-template-columns: repeat(3, 5px); gap: 2px; }
  .reader__grid i { display: block; width: 5px; height: 5px; background: var(--color-ink); }
  /* Phones: Back to series and All pages on the first line, the location line under them. */
  @media (max-width: 699px) {
    .reader__location { flex-basis: 100%; }
  }
  @media (min-width: 700px) {
    .reader__all { order: 3; }
    .reader__location { margin-right: auto; }
  }
  .reader__location {
    margin: 0;
    font-family: 'DM Mono', monospace;
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* The page reserves its space; the loading message sits behind the image until it paints. */
  .reader__page {
    position: relative;
    margin: 0 auto;
    width: 100%;
    /* Fits the window below the reader bar (with All pages) and above the controls, so on a
       360 × 640 phone both are on the first screen. */
    max-height: calc(100vh - 12.5rem);
    max-width: min(100%, calc((100vh - 12.5rem) * var(--page-ratio, 0.6667)));
    background: var(--color-paper-dark);
  }
  .reader__loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    margin: 0;
    text-align: center;
    color: var(--color-ink-light);
  }
  .reader__page img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .reader__edge {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    width: 15%;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: var(--color-ink);
    text-decoration: none;
    opacity: 0;
    transition: opacity var(--transition-fast);
  }
  .reader__edge--prev { left: 0; }
  .reader__edge--next { right: 0; }
  @media (hover: hover) and (min-width: 700px) {
    .reader__edge { display: flex; }
    .reader__edge:hover { opacity: 0.6; background: rgba(245, 241, 232, 0.4); }
  }

  .reader__controls-box {
    container-type: inline-size;
    max-width: 640px;
    margin: 1rem auto 0;
  }
  .reader__controls {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
  }
  /* When the captions don't fit on one row (enlarged text on a narrow phone), two by two:
     Previous and Next on top, First and Newest under them. */
  @container (max-width: 17rem) {
    .reader__controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .reader__control--previous { order: 1; }
    .reader__control--next { order: 2; }
    .reader__control--first { order: 3; }
    .reader__control--newest { order: 4; }
  }
  .reader__control {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 56px;
    padding: 0.25rem 0;
    border: 3px solid var(--color-ink);
    background: var(--color-beige);
    color: var(--color-ink);
    text-decoration: none;
  }
  .reader__control svg { height: 24px; flex: none; }
  .reader__control-caption {
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 0.8rem;
    line-height: 1.1;
    text-align: center;
  }
  /* A control that can't be used keeps its place, dashed and faded. */
  .reader__control.is-off {
    border-style: dashed;
    border-color: rgba(43, 43, 43, 0.4);
    color: rgba(43, 43, 43, 0.45);
  }
  /* The full name, above the control, on hover and keyboard focus. */
  .reader__control-tip {
    display: none;
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    padding: 0.25rem 0.5rem;
    background: var(--color-ink);
    color: var(--color-beige);
    font-family: 'Nunito', sans-serif;
    font-weight: 600;
    font-size: 0.8rem;
    white-space: nowrap;
    pointer-events: none;
  }
  .reader__control--first .reader__control-tip { left: 0; transform: none; }
  .reader__control--newest .reader__control-tip { left: auto; right: 0; transform: none; }
  .reader__control:hover .reader__control-tip,
  .reader__control:focus-visible .reader__control-tip { display: block; }

  .reader__share {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    max-width: 640px;
    margin: 1rem auto 0;
  }
  .reader__share[hidden], .reader__copy[hidden] { display: none; }
  .reader__share-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.4rem 1rem;
    border: 2px solid var(--color-ink);
    background: transparent;
    color: var(--color-ink);
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
  }
  .reader__share-button.is-done { background: var(--color-paper-dark); }
  .reader__copy { width: 100%; margin: 0; font-family: 'Nunito', sans-serif; font-weight: 600; }
  .reader__copy label { display: block; margin-bottom: 0.25rem; }
  .reader__copy input {
    width: 100%;
    min-height: 44px;
    padding: 0.4rem;
    border: 2px solid var(--color-ink);
    background: #fff;
    font-family: 'DM Mono', monospace;
    font-size: 0.85rem;
  }
  .reader__end { max-width: 640px; margin: 0.75rem auto 0; text-align: center; }
  .reader__end p { margin: 0 0 0.25rem; }
  .reader__end-heading { font-family: 'Nunito', sans-serif; font-weight: 700; }

  @media (prefers-reduced-motion: reduce) {
    .reader__edge { transition: none; }
  }
</style>
